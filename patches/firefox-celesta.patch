+    const sky = () => /^(nebula|stars)$/.test(Services.prefs.getStringPref("Celesta.home.background", "nebula"));
+    let Space;
+    const paint = () => {
+      if (inParent) {
+        paintBackground(doc);
+      } else {
+        paintSharedBackground(doc);
+      }
+      canvas.hidden = !inParent || !sky();
+      Space?.setNebula(Services.prefs.getStringPref("Celesta.home.background", "") == "stars" ? 0 : 1);
+      Space?.setStars(Services.prefs.getBoolPref("Celesta.home.stars", true) ? 1 : 0);
+    };
+    paint();
+    const stopBackground = watchBackground(paint);
+    Services.prefs.addObserver("Celesta.home.stars", paint);
+    win.addEventListener("unload", () => {
+      stopBackground();
+      Services.prefs.removeObserver("Celesta.home.stars", paint);
+    }, { once: true });
+    if (!inParent) {
+      return;
+    }
