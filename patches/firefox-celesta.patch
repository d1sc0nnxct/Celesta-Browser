+    "TabHide",
+    "TabPinned",
+    "TabUnpinned",
+    "TabAttrModified",
+    "TabGroupCollapse",
+    "TabGroupExpand",
+    "TabGrouped",
+    "TabUngrouped",
+    "TabGroupCreate",
+    "TabGroupRemoved",
+    "TabGroupUpdate",
+    "TabBrowserDiscarded",
+    "TabBrowserInserted",
