+
+// the same warning at most once per `everyMs`
+function warn(key, line, everyMs = 600000) {
+  const last = warned.get(key);
+  if (!last || Date.now() - last >= everyMs) {
+    warned.set(key, Date.now());
+    log(line, true);
+  }
+}
+
+async function flush() {
+  if (!lines.length || written > MAX_BYTES) {
+    return;
+  }
+  let text = lines.join("\n") + "\n";
+  lines = [];
+  written += text.length;
+  if (written > MAX_BYTES) {
+    text += "! log full (50 MB): nothing more is written until profiling is turned off and on\n";
+  }
+  await IOUtils.writeUTF8(path, text, { mode: "appendOrCreate" }).catch(e => console.error("Celesta profiler:", e));
