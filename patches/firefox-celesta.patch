+  const el = (tag, className, text) => {
+    const node = document.createElementNS(HTML_NS, tag);
+    if (className) {
+      node.className = className;
+    }
+    if (text) {
+      node.textContent = text;
+    }
+    return node;
+  };
+  const icon = (src, fallback) => {
+    if (!src) {
+      return el("span", "tglyph", fallback);
+    }
+    const img = el("img");
+    img.alt = "";
+    img.src = src;
+    img.addEventListener("error", () => img.replaceWith(el("span", "tglyph", fallback)), { once: true });
+    return img;
+  };
+
+  const VERTICAL_PREF = "Celesta.tabs.vertical";
+  const AUTOHIDE_PREF = "Celesta.bars.autohide";
+  const HIDE_DELAY_PREF = "Celesta.bars.hideDelay";
