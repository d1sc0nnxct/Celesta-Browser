+  margin: 0 !important;
+  padding: 0 !important;
+  width: 100vw;
+  max-width: none !important;
+  min-height: 100vh;
+  display: grid !important;
+  place-items: center;
+  background: transparent !important;
+  color: rgba(255, 255, 255, 0.86);
+  font: 14px/1.5 system-ui, sans-serif;
+}
+
+.Celesta-nf {
+  position: fixed;
+  left: 50%;
+  top: 50%;
+  transform: translate(-50%, -50%);
+  box-sizing: border-box;
+  width: min(520px, calc(100vw - 32px));
+  padding: 32px 36px;
+  border: 1px solid var(--Celesta-border, rgba(255, 255, 255, 0.10));
+  border-radius: var(--Celesta-radius, 28px);
+  background: var(--Celesta-glass, rgba(5, 5, 8, 0.72));
+  color: var(--Celesta-text, rgba(255, 255, 255, 0.86));
+  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
+  text-align: center;
+}
+
+.Celesta-nf-orb {
+  width: 64px;
+  height: 64px;
+  margin: 0 auto 18px;
+  border: 1px dashed rgba(170, 176, 255, 0.55);
+  border-radius: 50%;
+  box-shadow: 0 0 30px rgba(139, 147, 255, 0.25);
+}
+
+.Celesta-nf h1 {
+  margin: 0 0 8px;
+  font-size: 24px;
+  font-weight: 600;
+  color: #fff;
+}
+
