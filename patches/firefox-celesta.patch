+      gBrowser.translateTabContextMenu();
+      document.getElementById("tabContextMenu").openPopupAtScreen(e.screenX, e.screenY, true, e);
+    });
+    return button;
+  }
+
+  // a group's own color from the picker in its editor, else its named color
+  const GROUP_COLORS_PREF = "Celesta.tabGroups.colors";
+  const customGroupColors = () => {
+    try {
+      return JSON.parse(Services.prefs.getStringPref(GROUP_COLORS_PREF, "{}"));
+    } catch {
+      return {};
+    }
+  };
+  const groupColor = group => customGroupColors()[group.id] || `var(--tab-group-${group.color}, #8b93ff)`;
+
+  // a color picker under the editor's preset swatches
+  function setUpGroupColorPicker() {
+    const panel = gBrowser.tabGroupMenu?.panel;
+    panel?.addEventListener("popupshowing", e => {
+      const swatches = panel.querySelector(".tab-group-editor-swatches");
+      const group = gBrowser.tabGroupMenu.activeGroup;
+      if (e.target != panel || !swatches || !group) {
+        return;
+      }
+      let picker = panel.querySelector("#Celesta-group-color");
+      if (!picker) {
+        picker = document.createElementNS(HTML_NS, "input");
+        picker.id = "Celesta-group-color";
+        picker.type = "color";
+        picker.title = "Any color";
+        picker.addEventListener("input", () => {
+          const colors = customGroupColors();
+          colors[gBrowser.tabGroupMenu.activeGroup.id] = picker.value;
+          Services.prefs.setStringPref(GROUP_COLORS_PREF, JSON.stringify(colors));
+          queueTabs();
+        });
+        // a preset swatch puts the group back on its named color
+        swatches.addEventListener("change", () => {
+          const colors = customGroupColors();
+          delete colors[gBrowser.tabGroupMenu.activeGroup?.id];
+          Services.prefs.setStringPref(GROUP_COLORS_PREF, JSON.stringify(colors));
+          queueTabs();
+        });
+      }
+      swatches.after(picker);
+      picker.value = customGroupColors()[group.id] || "#8b93ff";
+    });
+  }
+
+  // A tab group is a folder bubble: click folds it, right-click edits it.
+  function groupButton(group) {
+    const button = el("button", "tab group" + (group.collapsed ? " collapsed" : ""));
