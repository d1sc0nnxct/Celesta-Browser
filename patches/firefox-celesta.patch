+/**
+ * The windows, tabs and tab groups open in Chrome (or open when it last
+ * closed), each Chrome window as a new window. Tabs already open here are
+ * left out, so importing twice does not add them twice.
+ *
+ * @param {string} aProfileFolder
+ */
+async function GetSessionResource(aProfileFolder) {
+  let candidates = [PathUtils.join(aProfileFolder, "Current Session")];
+  for (let path of await IOUtils.getChildren(PathUtils.join(aProfileFolder, "Sessions")).catch(() => [])) {
+    if (PathUtils.filename(path).startsWith("Session_")) {
+      candidates.push(path);
+    }
+  }
+  let newest = null;
+  for (let path of candidates) {
+    let info = await IOUtils.stat(path).catch(() => null);
+    if (info && (!newest || info.lastModified > newest.lastModified)) {
+      newest = info;
+    }
+  }
+  if (!newest) {
+    return null;
+  }
+  return {
+    type: MigrationUtils.resourceTypes.SESSION,
+
+    migrate: guarded(async aCallback => {
+      let bytes, windows;
+      try {
+        bytes = await IOUtils.read(newest.path);
+      } catch (ex) {
+        console.error(ex);
+        aCallback(false, { message: CLOSE_BROWSER_MESSAGE });
+        return;
+      }
+      try {
+        windows = parseChromeSession(bytes);
+      } catch (ex) {
+        console.error(ex);
+        aCallback(false, { message: "The windows and tabs could not be read." });
+        return;
+      }
+      let { BrowserWindowTracker } = ChromeUtils.importESModule(
+        "resource:///modules/BrowserWindowTracker.sys.mjs"
+      );
+      let { SessionStore } = ChromeUtils.importESModule(
+        "moz-src:///browser/components/sessionstore/SessionStore.sys.mjs"
+      );
+      let { E10SUtils } = ChromeUtils.importESModule(
+        "resource://gre/modules/E10SUtils.sys.mjs"
+      );
+      // every address a tab here has been at, so a tab that redirected still counts
+      let open = new Set();
+      for (let win of BrowserWindowTracker.orderedWindows) {
+        for (let tab of win.gBrowser.tabs) {
+          open.add(tab.linkedBrowser.currentURI.spec);
+          for (let entry of JSON.parse(SessionStore.getTabState(tab)).entries ?? []) {
+            open.add(entry.url);
+          }
+        }
+      }
+      let plural = (n, word) => `${n} ${word}${n == 1 ? "" : "s"}`;
+      let principal = E10SUtils.serializePrincipal(
+        Services.scriptSecurityManager.createNullPrincipal({})
+      );
+      let tabCount = 0,
+        skipped = 0,
+        windowCount = 0,
+        groupCount = 0;
+      for (let win of windows) {
+        let tabs = [];
+        let selected = 1;
+        for (let tab of win.tabs) {
+          if (!/^(https?|file|ftp):/.test(tab.url)) {
+            continue;
+          }
+          if (open.has(tab.url)) {
+            skipped++;
+            continue;
+          }
+          if (tab == win.tabs[win.selected]) {
+            selected = tabs.length + 1;
+          }
+          tabs.push({
+            entries: [{ url: tab.url, title: tab.title, triggeringPrincipal_base64: principal }],
+            index: 1,
+            pinned: tab.pinned,
+            groupId: tab.group,
+            hidden: false,
+          });
+        }
+        if (!tabs.length) {
+          continue;
+        }
+        let groups = win.groups.filter(g => tabs.some(t => t.groupId == g.id));
+        let target = await BrowserWindowTracker.promiseOpenWindow({ private: false });
+        try {
+          SessionStore.setWindowState(target, { windows: [{ tabs, groups, selected }] }, true);
+        } catch (ex) {
+          console.error(ex);
+          target.close();
+          aCallback(false, { message: "The windows and tabs could not be opened." });
+          return;
+        }
+        tabCount += tabs.length;
+        groupCount += groups.length;
+        windowCount++;
+      }
+      let message = `${plural(tabCount, "tab")} in ${plural(windowCount, "window")}, ${plural(groupCount, "tab group")}`;
+      if (skipped) {
+        message += `; ${skipped} already open here were left out`;
+      }
+      aCallback(true, { message });
+    }),
+  };
+}
