+/**
+ * Reads a Chrome session file (SNSS): the open windows with their tabs and
+ * tab groups.
+ *
+ * @param {Uint8Array} bytes
+ * @returns {{tabs: object[], groups: object[]}[]} windows, tabs in order.
+ */
+export function parseChromeSession(bytes) {
+  let view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  if (bytes.length < 8 || view.getUint32(0) != 0x534e5353 /* "SNSS" */) {
+    throw new Error("Not a Chrome session file");
+  }
+  let tabs = new Map(),
+    windows = new Map(),
+    groups = new Map();
+  let tabOf = id => {
+    if (!tabs.has(id)) {
+      tabs.set(id, { navs: new Map(), selected: -1, index: 0, window: 0 });
+    }
+    return tabs.get(id);
+  };
+  let windowOf = id => {
+    if (!windows.has(id)) {
+      windows.set(id, { type: 0, selected: 0 });
+    }
+    return windows.get(id);
+  };
+  let hex = (start, end) =>
+    Array.from(bytes.subarray(start, end), b => b.toString(16).padStart(2, "0")).join("");
+  // a pickle: uint32 payload size, then 4-byte aligned fields
+  let reader = start => {
+    let at = start + 4;
+    let int = () => {
+      let v = view.getInt32(at, true);
+      at += 4;
+      return v;
+    };
+    let skip = n => (at += (n + 3) & ~3);
+    return {
+      int,
+      skip,
+      string() {
+        let length = int();
+        let s = new TextDecoder().decode(bytes.subarray(at, at + length));
+        skip(length);
+        return s;
+      },
+      string16() {
+        let length = int();
+        let s = String.fromCharCode(
+          ...new Uint16Array(bytes.slice(at, at + length * 2).buffer)
+        );
+        skip(length * 2);
+        return s;
+      },
+    };
+  };
+  let colors = ["gray", "blue", "red", "yellow", "green", "pink", "purple", "cyan", "orange"];
+  let pos = 8;
+  while (pos + 3 <= bytes.length) {
+    let size = view.getUint16(pos, true);
+    let p = pos + 3;
+    pos += 2 + size;
+    if (!size || pos > bytes.length) {
+      break;
+    }
+    let a = () => view.getInt32(p, true),
+      b = () => view.getInt32(p + 4, true);
+    switch (bytes[p - 1]) {
+      case 0: // SetTabWindow: window, tab
+        tabOf(b()).window = a();
+        break;
+      case 2: // SetTabIndexInWindow
+        tabOf(a()).index = b();
+        break;
+      case 6: {
+        // UpdateTabNavigation: tab, index, url, title
+        let r = reader(p);
+        let tab = tabOf(r.int());
+        let index = r.int();
+        tab.navs.set(index, { url: r.string(), title: r.string16() });
+        break;
+      }
+      case 7: // SetSelectedNavigationIndex
+        tabOf(a()).selected = b();
+        break;
+      case 8: // SetSelectedTabInIndex: window, index
+        windowOf(a()).selected = b();
+        break;
+      case 9: // SetWindowType: 0 is a normal window
+        windowOf(a()).type = b();
+        break;
+      case 12: // SetPinnedState
+        tabOf(a()).pinned = !!bytes[p + 4];
+        break;
+      case 16: // TabClosed
+        tabs.delete(a());
+        break;
+      case 17: // WindowClosed
+        windows.set(a(), { closed: true });
+        break;
+      case 25: // SetTabGroup: tab, padding, 16-byte token, has group
+        tabOf(a()).group = bytes[p + 24] ? hex(p + 8, p + 24) : null;
+        break;
+      case 27: {
+        // SetTabGroupMetadata2: token, title, color, collapsed
+        let r = reader(p);
+        let id = hex(p + 4, p + 20);
+        r.skip(16);
+        let name = r.string16();
+        let color = colors[r.int()] ?? "gray";
+        groups.set(id, { id, name, color, collapsed: !!r.int() });
+        break;
+      }
+    }
+  }
+  let result = new Map();
+  for (let tab of tabs.values()) {
+    let win = windowOf(tab.window);
+    if (win.closed || win.type != 0 || !tab.navs.size) {
+      continue;
+    }
+    let nav = tab.navs.get(tab.selected) ?? [...tab.navs.values()].at(-1);
+    if (!result.has(tab.window)) {
+      result.set(tab.window, { tabs: [], groups: [], selected: win.selected });
+    }
+    result.get(tab.window).tabs.push({ ...nav, index: tab.index, pinned: !!tab.pinned, group: tab.group ?? null });
+  }
+  for (let win of result.values()) {
+    win.tabs.sort((x, y) => x.index - y.index);
+    let ids = new Set(win.tabs.map(t => t.group).filter(Boolean));
+    win.groups = [...ids].map(id => groups.get(id) ?? { id, name: "", color: "gray", collapsed: false });
+  }
+  return [...result.values()];
+}
