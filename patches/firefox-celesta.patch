+      return;
+    }
+    for (const type of TAB_EVENTS) {
+      gBrowser.tabContainer.addEventListener(type, queueTabs);
+    }
+    PlacesUtils.observers.addListener(BOOKMARK_EVENTS, queueBookmarks);
+    // the bookmark row scrolls sideways with a plain mouse wheel
+    bookmarksEl.addEventListener("wheel", e => {
+      if (Math.abs(e.deltaX) >= Math.abs(e.deltaY)) {
+        return;
+      }
+      const step = e.deltaMode == WheelEvent.DOM_DELTA_LINE ? 40 : e.deltaMode == WheelEvent.DOM_DELTA_PAGE ? bookmarksEl.clientWidth : 1;
+      bookmarksEl.scrollLeft += e.deltaY * step;
+      e.preventDefault();
+    });
+    // tabs shrink to fit; past that they drop to bare icons
+    tabsEl.addEventListener("transitionend", queueFitTabs);
+    window.addEventListener("resize", queueFitTabs);
+    bookmarksEl.addEventListener("contextmenu", onBookmarkContextMenu);
+    for (const type of ["input", "focus", "blur"]) {
+      gURLBar.inputField.addEventListener(type, queueFitUrlbar);
+    }
+    gBrowser.tabContainer.addEventListener("TabSelect", queueFitUrlbar);
+    gBrowser.addProgressListener({ onLocationChange: queueFitUrlbar });
+    window.addEventListener("resize", queueFitUrlbar);
+    queueFitUrlbar();
+    setUpWarp();
+    window.addEventListener(
+      "unload",
+      () => PlacesUtils.observers.removeListener(BOOKMARK_EVENTS, queueBookmarks),
+      { once: true }
+    );
+    moveSidebarToolsToNavBar();
+    setUpDragging();
+    setUpIcons();
+    document.addEventListener("popupshowing", e => maskIcons(e.target));
+    setUpFolding();
+    setUpNavPill();
+    applyBarPrefs();
+    let resizeFrame = 0;
+    window.addEventListener("resize", () => {
+      if (!resizeFrame && Services.prefs.getIntPref(SCALE_PREF, 100) == 0) {
+        resizeFrame = requestAnimationFrame(() => {
+          resizeFrame = 0;
+          applyBarPrefs();
+        });
+      }
+    });
+    for (const [pref, observer] of [[SCALE_PREF, applyBarPrefs], [FOLD_SPEED_PREF, applyBarPrefs], [NAME_WIDTH_PREF, applyBarPrefs], [ACTIVATION_PREF, applyBarPrefs], [BOOKMARKS_VISIBILITY_PREF, showBookmarks]]) {
+      Services.prefs.addObserver(pref, observer);
+      window.addEventListener("unload", () => Services.prefs.removeObserver(pref, observer), { once: true });
+    }
+    gBrowser.tabContainer.addEventListener("TabSelect", showBookmarks);
+    gBrowser.addProgressListener({ onLocationChange: showBookmarks });
+    watchPrivateTabs(window);
+    setUpGroupColorPicker();
+    setUpStartPageFilter();
+    setUpSharedStart();
+    setUpChromeStore();
+    setUpTabPausing();
+    setUpMediaButton();
+    setUpProfiling();
+    ChromeUtils.importESModule("chrome://celesta/content/celestaDiscord.sys.mjs").watch(window);
+    document.addEventListener("command", onAppMenuCommand);
+    const { applyTheme, watchTheme, skinChromeWindows, shareSnapshot } = ChromeUtils.importESModule("chrome://celesta/content/celestaTheme.sys.mjs");
+    applyTheme(document.documentElement);
+    skinChromeWindows();
+    shareSnapshot();
+    const stopTheme = watchTheme(() => applyTheme(document.documentElement));
+    window.addEventListener("unload", stopTheme, { once: true });
+    const autoHide = setUpAutoHide();
+    const onAutoHidePref = () =>
+      Services.prefs.getBoolPref(AUTOHIDE_PREF, true)
+        ? autoHide.scheduleHide()
+        : autoHide.show();
+    Services.prefs.addObserver(VERTICAL_PREF, applyVertical);
+    Services.prefs.addObserver(AUTOHIDE_PREF, onAutoHidePref);
+    window.addEventListener(
+      "unload",
+      () => {
+        Services.prefs.removeObserver(VERTICAL_PREF, applyVertical);
+        Services.prefs.removeObserver(AUTOHIDE_PREF, onAutoHidePref);
+      },
+      { once: true }
+    );
+    applyVertical();
+    renderTabs();
+    queueBookmarks();
+  });
+}
