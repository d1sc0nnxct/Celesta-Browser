+  // are gone), placed on the nav bar once per profile.
+  const SIDEBAR_TOOL_WIDGETS = ["history-panelmenu", "bookmarks-menu-button", "logins-button"];
+  const SIDEBAR_TOOLS_MIGRATED_PREF = "Celesta.navbar.sidebarToolsMigrated";
+
+  let tabsEl, bookmarksEl, tabsQueued, bookmarksQueued;
+
+  function tabButton(tab) {
+    const button = el("button", "tab" + (tab.selected ? " active" : ""));
+    button.setAttribute("role", "tab");
+    button.setAttribute("aria-selected", tab.selected);
+    button.title = tab.label;
+    const close = el("span", "x", "├ù");
+    close.title = "Close tab";
+    button.append(
+      icon(gBrowser.getIcon(tab), tab.pinned ? "ΓÇó" : "Γùª"),
+      el("span", "tl", tab.label),
+      close
+    );
+    // a tab playing sound, muted or waiting to play shows a button that mutes, unmutes or plays it
+    let sound = null;
+    if (tab.soundPlaying || tab.muted || tab.activeMediaBlocked) {
+      const state = tab.activeMediaBlocked ? "blocked" : tab.muted ? "muted" : "playing";
+      sound = el("span", "snd " + state);
+      sound.setAttribute("role", "button");
+      sound.title = { blocked: "Play tab", muted: "Unmute tab", playing: "Mute tab" }[state];
+      close.before(sound);
+    }
+    button.draggable = true;
+    const identity = tab.userContextId && !isPrivateTab(tab) && ContextualIdentityService.getPublicIdentityFromId(tab.userContextId);
+    if (identity) {
+      button.classList.add("container", "identity-color-" + identity.color);
+      button.title = ContextualIdentityService.getUserContextLabel(tab.userContextId) + ": " + tab.label;
+    }
+    if (tab.hasAttribute("pending")) {
+      button.classList.add("paused");
+      button.title += " (paused to save memory; it reloads when you open it)";
+    }
+    if (isPrivateTab(tab)) {
+      button.classList.add("private");
+      button.classList.toggle("tor", isTorTab(tab));
+      button.title = (isTorTab(tab) ? "Tor: " : "Private: ") + tab.label;
+    }
+    button.addEventListener("click", e => {
+      if (e.target == close) {
+        gBrowser.removeTab(tab);
+      } else if (sound && e.target == sound) {
+        if (tab.activeMediaBlocked) {
+          tab.resumeDelayedMedia();
+        } else {
+          tab.toggleMuteAudio();
+        }
+      } else {
+        gBrowser.selectedTab = tab;
+      }
