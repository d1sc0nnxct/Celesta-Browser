+/* a leak: a value whose low point (the minimum of each minute, so GC's
+   sawtooth does not count) rose nearly every time over its last 10 minutes
+   (10 samples: 50 minutes for the memory report) */
+function watch(key, value, minGrow, ratio, show) {
+  if (Date.now() - started < SETTLE_MS) {
+    return;
+  }
+  let s = series.get(key);
+  if (!s) {
+    s = { floors: [], low: value, at: Date.now() };
+    series.set(key, s);
+  }
+  s.low = Math.min(s.low, value);
+  if (Date.now() - s.at < 55000) {
+    return;
+  }
+  s.floors.push({ v: s.low, at: s.at });
+  s.low = value;
+  s.at = Date.now();
+  if (s.floors.length > 10) {
+    s.floors.shift();
+  }
+  const f = s.floors.map(x => x.v);
+  const ups = f.slice(1).filter((v, i) => v >= f[i]).length;
+  if (f.length == 10 && f[9] - f[0] >= minGrow && f[9] - f[0] >= f[0] * ratio && ups >= 7) {
+    const mins = Math.round((Date.now() - s.floors[0].at) / 60000);
