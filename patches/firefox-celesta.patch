+  const parts = [];
+  for (const p of procs) {
+    total += p.mem;
+    const prev = lastProc?.cpu.get(p.key);
+    const pct = prev == null ? null : Math.round(((p.cpu - prev) / 1e6 / (now - lastProc.t)) * 100);
