+      return;
+    }
+    paint();
+    const center = () => ({ x: win.innerWidth / 2, y: win.innerHeight / 2 });
+    win.setInterval(() => {
+      if (!doc.hidden && !canvas.hidden) {
+        Space.draw(win.performance.now(), center(), 1);
+      }
+    }, 1000 / SKY_FPS);
+    win.addEventListener("resize", () => Space.resize());
+  }
+}
