diff --git a/browser/branding/celesta/pref/firefox-branding.js b/browser/branding/celesta/pref/firefox-branding.js
new file mode 100644
index 0000000000..ce0d371059
--- /dev/null
+++ b/browser/branding/celesta/pref/firefox-branding.js
@@ -0,0 +1,264 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// This file contains branding-specific prefs for Celesta.
+
+// --- Startup page: no welcome / what's-new / firstrun redirects ---
+// (The home page set in the main prefs is the only page shown on startup.)
+pref("startup.homepage_override_url", "");
+pref("startup.homepage_welcome_url", "");
+pref("startup.homepage_welcome_url.additional", "");
+pref("browser.startup.homepage_override.mstone", "ignore");
+pref("browser.aboutwelcome.enabled", false);
+pref("browser.startup.upgradeDialog.enabled", false);
+
+// --- Updates: this is a self-built browser, nothing to update from ---
+pref("app.update.auto", false);
+pref("app.update.enabled", false);
+pref("app.update.url.manual", "");
+pref("app.update.url.details", "");
+pref("app.update.interval", 604800); // weekly, in case anything re-enables checks
+pref("app.update.checkInstallTime.days", 0);
+pref("app.update.badgeWaitTime", 0);
+pref("app.update.promptWaitTime", 604800);
+
+// --- Release / update notes: local build, no remote notes ---
+pref("app.releaseNotesURL", "");
+pref("app.releaseNotesURL.aboutDialog", "");
+pref("app.releaseNotesURL.prompt", "");
+
+// --- No Mozilla accounts / Sync: hides every sign-in, sync and send-tab entry ---
+pref("identity.fxaccounts.enabled", false);
+pref("identity.fxaccounts.toolbar.enabled", false);
+pref("identity.fxaccounts.toolbar.defaultVisible", false);
+
+// --- Start page: Celesta's own page only; the startup cache holds Firefox's ---
+pref("browser.startup.homepage.abouthome_cache.enabled", false);
+
+// --- No AI features: master switch plus each feature it covers ---
+pref("browser.ai.control.default", "blocked");
+pref("browser.ai.control.translations", "blocked");
+pref("browser.ai.control.pdfjsAltText", "blocked");
+pref("browser.ai.control.smartTabGroups", "blocked");
+pref("browser.ai.control.linkPreviewKeyPoints", "blocked");
+pref("browser.ai.control.sidebarChatbot", "blocked");
+pref("browser.ai.control.smartWindow", "blocked");
+pref("browser.ai.control.speechRecognition", "blocked");
+pref("browser.ml.enable", false);
+pref("extensions.ml.enabled", false);
+pref("browser.ml.chat.enabled", false);
+pref("browser.ml.chat.page", false);
+pref("browser.ml.chat.menu", false);
+pref("browser.ml.chat.shortcuts", false);
+pref("browser.ml.chat.sidebar", false);
+pref("browser.ml.linkPreview.enabled", false);
+pref("browser.ml.pageAssist.enabled", false);
+pref("browser.smartwindow.enabled", false);
+pref("browser.tabs.groups.smart.enabled", false);
+pref("browser.tabs.groups.smart.userEnabled", false);
+pref("browser.translations.enable", false);
+pref("pdfjs.enableAltText", false);
+pref("places.semanticHistory.featureGate", false);
+pref("browser.search.visualSearch.featureGate", false);
+pref("browser.preferences.aiControls", false);
+
+// --- No sidebar: old-style sidebar (no launcher strip), never shown ---
+pref("sidebar.revamp", false);
+pref("sidebar.verticalTabs", false);
+pref("sidebar.visibility", "hide-sidebar");
+pref("sidebar.main.tools", "");
+
+// --- Celesta bubble bars (see chrome://celesta/content/chrome.js) ---
+pref("Celesta.tabs.vertical", false);
+pref("Celesta.bars.autohide", true);
+// compact toolbars: the bars float over the page, so every pixel covers it
+pref("browser.uidensity", 1);
+
+// Number of usages of the web console.
+// If this is less than 5, then pasting code into the web console is disabled
+pref("devtools.selfxss.count", 5);
+// native menus take the Celesta style (chrome.css) instead of the mica backdrop
+pref("widget.windows.mica.popups", 0);
+// Celesta start page (Settings > Home); read by the page through CelestaHomeChild
+pref("Celesta.home.stars", true);
+pref("Celesta.home.showUncategorized", true);
+pref("Celesta.home.showLinks", true);
+pref("Celesta.home.logos", "hover");
+// one live start page per window, shown over its tabs on the start page (chrome.js setUpSharedStart)
+pref("Celesta.home.shared", true);
+pref("Celesta.home.warnFlagged", true);
+pref("Celesta.bars.hideDelay", 1000);
+// start page background: nebula, stars, color, media (picture/GIF/video file) or folder (shuffled)
+pref("Celesta.home.background", "nebula");
+pref("Celesta.home.background.color", "#05050a");
+pref("Celesta.home.background.file", "");
+pref("Celesta.home.background.folder", "");
+// no Mozilla product promotions in Settings
+pref("browser.preferences.moreFromMozilla", false);
+// start page updates per second while moving (0 = every display refresh)
+// frames a second the start page redraws at: 120, 60 or 30 (Settings > Home and startup)
+pref("Celesta.home.maxFps", 60);
+// idle throttle: after 10 s without input the start page draws about once a second
+pref("Celesta.home.idleThrottle", true);
+pref("Celesta.home.background.shaderFile", "");
+// Celesta theme (Settings > Appearance; CelestaTheme.sys.mjs)
+pref("Celesta.theme.mode", "dark");
+pref("Celesta.theme.surface", "color");
+pref("Celesta.theme.surfaceColor", "#050508");
+pref("Celesta.theme.surfaceColor2", "#1a1030");
+pref("Celesta.theme.surfaceAngle", 135);
+pref("Celesta.theme.surfaceImage", "");
+pref("Celesta.theme.opacity", 72);
+pref("Celesta.theme.accent", "color");
+pref("Celesta.theme.accentColor", "#8b93ff");
+pref("Celesta.theme.accentColor2", "#ff7ad9");
+pref("Celesta.theme.accentImage", "");
+pref("Celesta.theme.radius", 24);
+pref("Celesta.theme.surfaceShader", "");
+pref("Celesta.theme.text", "color");
+pref("Celesta.theme.textColor", "#ffffff");
+pref("Celesta.theme.textColor2", "#8b93ff");
+pref("Celesta.theme.textImage", "");
+pref("Celesta.theme.font", "");
+pref("Celesta.theme.fontFile", "");
+
+// --- No data collection: telemetry, studies, crash and usage reports ---
