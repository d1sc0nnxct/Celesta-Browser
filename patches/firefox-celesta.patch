+      // client pixels to the bar's own (zoomed) pixels
+      const z = parseFloat(cs.zoom) || 1;
+      const left = Math.min(...kids.map(r => r.left)) - parseFloat(cs.paddingInlineStart) * z;
+      const right = Math.max(...kids.map(r => r.right)) + parseFloat(cs.paddingInlineEnd) * z;
+      bar.style.setProperty("--Celesta-pill-left", (left - box.left) / z + "px");
+      bar.style.setProperty("--Celesta-pill-width", (right - left) / z + "px");
+    };
+    const queue = () => {
+      if (!queued) {
+        queued = true;
+        requestAnimationFrame(fit);
+      }
+    };
+    const sizes = new ResizeObserver(queue);
+    const watch = () => {
+      sizes.disconnect();
+      for (const node of [bar, ...bar.children]) {
+        sizes.observe(node);
+      }
+      queue();
+    };
+    new MutationObserver(watch).observe(bar, { childList: true, subtree: false, attributes: true, attributeFilter: ["hidden", "collapsed"] });
+    watch();
+  }
+
+  delayedStartupPromise.then(() => {
+    tabsEl = document.getElementById("Celesta-tabs");
+    bookmarksEl = document.getElementById("Celesta-bookmarks");
