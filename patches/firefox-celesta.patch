+  --link-color: var(--Celesta-accent) !important;
+  --card-border-radius: var(--Celesta-radius, 24px) !important;
+  --card-box-shadow: 0 8px 26px rgba(0, 0, 0, 0.45) !important;
+  --in-content-page-background: transparent !important;
+  --in-content-box-background: var(--Celesta-glass-solid, rgb(5 5 8 / 0.62)) !important;
+  --color-accent-primary: var(--Celesta-accent, #8b93ff) !important;
+  --color-accent-primary-hover: color-mix(in srgb, var(--Celesta-accent, #8b93ff) 85%, white) !important;
+  --color-accent-primary-active: color-mix(in srgb, var(--Celesta-accent, #8b93ff) 72%, white) !important;
+  --focus-outline-color: var(--Celesta-accent, #8b93ff) !important;
+  --text-color: var(--Celesta-text, rgb(255 255 255 / 0.88)) !important;
+  --text-color-deemphasized: var(--Celesta-text-dim, rgb(255 255 255 / 0.62)) !important;
+  /* Firefox's own corner sizes follow the theme's roundness (24px gives Firefox's 4, 8 and 16px) */
+  --border-radius-small: calc(var(--Celesta-radius, 24px) / 6) !important;
+  --border-radius-medium: calc(var(--Celesta-radius, 24px) / 3) !important;
+  --border-radius-large: calc(var(--Celesta-radius, 24px) * 2 / 3) !important;
+  --box-border-radius: calc(var(--Celesta-radius, 24px) / 3) !important;
+  --button-border-radius: calc(var(--Celesta-radius, 24px) / 3) !important;
+  --icon-color-information: var(--Celesta-accent) !important;
+}
+
+/* cards show the theme's surface (a gradient, image or shader as well as a color) */
+:is(moz-card, .card, .info-box-container) {
+  --card-background-color: transparent !important;
+  background: var(--Celesta-glass, rgb(5 5 8 / 0.62)) !important;
+  border-radius: var(--Celesta-radius, 24px);
+}
+
+:root[Celesta-font] * {
+  font-family: var(--Celesta-font) !important;
+}
+
+:root[Celesta-text-fill] :is(h1, h2, h3, label, .heading-medium, .heading-large) {
+  background: var(--Celesta-text-fill);
+  background-clip: text;
+  color: transparent !important;
+}
+
+body {
+  background: transparent !important;
+}
+
+:root:not([Celesta-light]) {
+  color-scheme: dark !important;
+}
+:root[Celesta-light] {
+  color-scheme: light !important;
+}
+
+#Celesta-bg {
+  position: fixed;
+  inset: 0;
+  z-index: -2;
+  pointer-events: none;
+
+  & > video {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+}
+
+#Celesta-sky {
+  position: fixed;
+  inset: 0;
+  width: 100vw;
+  height: 100vh;
+  z-index: -1;
+  pointer-events: none;
+}
+
+/* light mode keeps the page's background; text that would sit on the sky
+   gets the surface behind it instead */
+:root[Celesta-light] :is(moz-page-nav, #categories, .sticky-container, #sidebar, .main-search) {
+  background: var(--Celesta-glass);
+  border-radius: var(--Celesta-radius, 24px);
+}
+
+/* secondary text (descriptions, button labels) and the secondary accent
+   (selected and hovered items) */
+:root {
+  --text-color-deemphasized: var(--Celesta-text-2, rgb(255 255 255 / 0.62)) !important;
+  --button-text-color: var(--Celesta-text-2) !important;
+  --button-text-color-primary: var(--Celesta-text-2) !important;
+  --button-text-color-primary-hover: var(--Celesta-text-2) !important;
+  --button-background-color-primary-selected: var(--Celesta-accent-2) !important;
+  --color-accent-primary-selected: var(--Celesta-accent-2) !important;
+}
+
+moz-page-nav,
+moz-page-nav-button {
+  --page-nav-button-background-color-selected: color-mix(in srgb, var(--Celesta-accent-2) 30%, transparent) !important;
+  --page-nav-button-text-color-selected: var(--Celesta-text-strong) !important;
+  --page-nav-button-background-color-hover: color-mix(in srgb, var(--Celesta-accent-2) 14%, transparent) !important;
+}
+
+:root[Celesta-text2-fill] :is(.text-deemphasized, .description-deemphasized, .setting-description, .tail-with-learn-more) {
+  background: var(--Celesta-text2-fill);
+  background-clip: text;
+  color: transparent !important;
+}
+
+/* notices inside pages (default browser, warnings) in the theme's surface */
+moz-message-bar {
+  --message-bar-background-color: transparent !important;
+  --message-bar-text-color: var(--Celesta-text) !important;
+  --message-bar-border-color: transparent !important;
+  background: var(--Celesta-glass) !important;
+  border-radius: calc(var(--Celesta-radius, 24px) / 2);
+}
+
+moz-box-item,
+moz-box-button,
+moz-box-link {
+  --box-background-color: transparent !important;
+}
+
+/* a surface inside a surface is a less transparent layer of it, not an outline
+   (set on the elements: their shadow trees set the token again on :host) */
+:root,
+moz-box-group,
+moz-box-item,
+moz-box-link,
+moz-box-button,
+moz-card {
+  --box-border-color: transparent !important;
+  --border-color-card: transparent !important;
+  border-color: transparent !important;
+}
+
+moz-box-group,
+:is(moz-box-item, moz-box-button, moz-box-link):not(moz-box-group > *),
+moz-card moz-card {
+  background: color-mix(in srgb, var(--Celesta-glass-solid, rgb(5 5 8 / 0.84)) 55%, transparent) !important;
+  border-radius: var(--box-border-radius, 8px);
+}
+
+moz-card moz-card {
+  border-radius: calc(var(--Celesta-radius, 24px) * 2 / 3);
+}
+
+/* the middle panel sits in the middle of the window: the Settings sidebar
+   floats beside it instead of pushing it over (when there is room) */
+@media (min-width: 1100px) {
+  #preferences-stack > hbox {
+    position: relative;
+  }
+
+  #preferences-body #categories {
+    position: absolute;
+    inset-block: 0;
+    inset-inline-start: 0;
+    z-index: 3;
+  }
+
+  #preferences-body .main-content {
+    flex: 1;
+  }
+}
+
+/* the middle panel sits in the middle of the page */
+.main-content > .pane-container,
+#main > :is(addon-list, .main-search, global-warnings, discovery-pane, addon-page-header),
+#downloadsListBox {
+  margin-inline: auto !important;
+}
+
+/* no theme section in Add-ons: Celesta themes are made in Settings > Appearance */
+#category-theme {
+  display: none !important;
+}
+
+moz-promo {
+  --promo-background-color: transparent !important;
+  --promo-background-color-vibrant: transparent !important;
+  --promo-border-color: transparent !important;
+  background: var(--Celesta-glass) !important;
+  border-radius: calc(var(--Celesta-radius, 24px) / 2);
+}
