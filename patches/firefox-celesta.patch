+    this._i = i;
+  }
+  get pop() { return this._pop ?? PACK.num(PACK.rows[this._i * 8 + 4]); }
+  set pop(v) { this._pop = v; }
+  get id() { return this._idv ??= PACK.str(PACK.rows[this._i * 8]); }
+  set id(v) { this._idv = v; }
+  get name() { return this._nm ??= PACK.str(PACK.rows[this._i * 8 + 1]); }
+  set name(v) { this._nm = v; }
+  get domain() { return this._dm ??= PACK.str(PACK.rows[this._i * 8 + 2]); }
+  set domain(v) { this._dm = v; }
+  get cat() { return this._ctv ??= PACK.str(PACK.rows[this._i * 8 + 3]); }
+  set cat(v) { this._ctv = v; }
+  get risk() { return this._rk ??= PACK.str(PACK.rows[this._i * 8 + 5]); }
+  set risk(v) { this._rk = v; }
+  get en() { return this._en2 ??= PACK.str(PACK.rows[this._i * 8 + 6]); }
+  set en(v) { this._en2 = v; }
+  get sub() { return this._sb ??= PACK.str(PACK.rows[this._i * 8 + 7]); }
