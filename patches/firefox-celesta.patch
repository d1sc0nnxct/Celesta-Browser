diff --git a/gfx/thebes/DeviceManagerDx.cpp b/gfx/thebes/DeviceManagerDx.cpp
index cbad15cb49..2a8356ef32 100644
--- a/gfx/thebes/DeviceManagerDx.cpp
+++ b/gfx/thebes/DeviceManagerDx.cpp
@@ -1157,6 +1157,39 @@ FeatureStatus DeviceManagerDx::CreateContentDevice() {
   return FeatureStatus::Available;
 }
 
+/* static */
+bool DeviceManagerDx::GpuDecodesAV1() {
+  static Atomic<int> sKnown(-1);
+  if (sKnown >= 0) {
+    return sKnown;
+  }
+  if (!XRE_IsGPUProcess() || !sInstance) {
+    return true;
+  }
+  RefPtr<ID3D11Device> device = sInstance->GetCompositorDevice();
+  if (!device) {
+    device = sInstance->CreateDecoderDevice({});
+  }
+  if (!device) {
+    return true;
+  }
+  RefPtr<ID3D11VideoDevice> videoDevice;
+  BOOL supported = false;
+  static const GUID kAV1Profile0 = {
+      0xb8be4ccb,
+      0xcf53,
+      0x46ba,
+      {0x8d, 0x59, 0xd6, 0xb8, 0xa6, 0xda, 0x5d, 0x2a}};
+  if (SUCCEEDED(device->QueryInterface(
+          static_cast<ID3D11VideoDevice**>(getter_AddRefs(videoDevice))))) {
+    supported = SUCCEEDED(videoDevice->CheckVideoDecoderFormat(
+                    &kAV1Profile0, DXGI_FORMAT_NV12, &supported)) &&
+                supported;
+  }
+  sKnown = supported ? 1 : 0;
+  return supported;
+}
