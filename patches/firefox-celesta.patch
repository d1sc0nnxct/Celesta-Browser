+// Celesta: Windows may keep another app's paused session as its current media
+// session and send it the media keys; while Celesta has media it holds the keys
+// itself as hotkeys of the invisible window.
+static constexpr UINT kMediaHotkeys[] = {VK_MEDIA_PLAY_PAUSE, VK_MEDIA_NEXT_TRACK,
+                                         VK_MEDIA_PREV_TRACK, VK_MEDIA_STOP};
+
+static LRESULT CALLBACK MediaKeysWndProc(HWND aWnd, UINT aMsg, WPARAM aWParam,
+                                         LPARAM aLParam) {
+  if (aMsg == WM_HOTKEY) {
+    auto* provider = reinterpret_cast<WindowsSMTCProvider*>(
+        GetWindowLongPtr(aWnd, GWLP_USERDATA));
+    if (provider) {
+      provider->OnHotkey(HIWORD(aLParam));
+    }
+    return 0;
+  }
+  return DefWindowProc(aWnd, aMsg, aWParam, aLParam);
+}
+
+void WindowsSMTCProvider::OnHotkey(UINT aVirtualKey) {
+  if (!IsOpened()) {
+    return;
+  }
+  switch (aVirtualKey) {
+    case VK_MEDIA_PLAY_PAUSE:
+      OnButtonPressed(GetPlaybackState() ==
+                              mozilla::dom::MediaSessionPlaybackState::Playing
+                          ? mozilla::dom::MediaControlKey::Pause
+                          : mozilla::dom::MediaControlKey::Play);
+      break;
+    case VK_MEDIA_NEXT_TRACK:
+      OnButtonPressed(mozilla::dom::MediaControlKey::Nexttrack);
+      break;
+    case VK_MEDIA_PREV_TRACK:
+      OnButtonPressed(mozilla::dom::MediaControlKey::Previoustrack);
+      break;
+    case VK_MEDIA_STOP:
+      OnButtonPressed(mozilla::dom::MediaControlKey::Stop);
+      break;
+  }
+}
+
+void WindowsSMTCProvider::HoldMediaKeys(bool aHold) {
+  for (UINT i = 0; i < std::size(kMediaHotkeys); i++) {
+    if (aHold) {
+      // fails when another app already holds the key; that app keeps it
+      if (!RegisterHotKey(mWindow, i + 1, MOD_NOREPEAT, kMediaHotkeys[i])) {
+        LOG("Could not hold media key %u. Error Code: %lu", kMediaHotkeys[i],
+            GetLastError());
+      }
+    } else {
+      UnregisterHotKey(mWindow, i + 1);
+    }
+  }
+}
+
