diff --git a/browser/content/celesta/boot.js b/browser/content/celesta/boot.js
new file mode 100644
index 0000000000..45384c433b
--- /dev/null
+++ b/browser/content/celesta/boot.js
@@ -0,0 +1,96 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* The start page's first script. Reading the site list takes over a second,
+   so it first shows the picture of the map the page saved last time (at this
+   window size, from its home view), then loads the page's scripts in order.
+   graph.js fades the picture into the live map once that is ready; until
+   then the page takes no clicks (body.loading). */
+
+"use strict";
+
+(function boot() {
+  globalThis.performance?.mark("celesta-boot-src");   // load-time profiling: first page script
+  const diag = (v) => { try { dispatchEvent(new CustomEvent("Celesta-diag", { detail: String(v) })); } catch (e) {} };
+  diag("boot src");
+  const FIRST = ["shadertoy.js", "space.js", "bubbles.js"];
+  const REST = ["sites.js", "sites-layout.js", "graph.js"];
+  // a tab's stand-in under the window's shared start page stays empty (CelestaHomeChild pageMode)
+  if (document.documentElement.dataset.CelestaMode === "standin") {
+    return;
+  }
+  // added after the first paint: fetched and compiled meanwhile
+  for (const name of [...FIRST, ...REST]) {
+    const link = document.createElement("link");
+    link.rel = "preload";
+    link.as = "script";
+    link.href = "chrome://celesta/content/" + name;
+    document.head.appendChild(link);
+  }
+  document.body.classList.add("loading");
+  let started = false;
+  const start = () => {
+    if (started) {
+      return;
+    }
+    started = true;
+    // after a paint, so the picture is on screen before the long scripts run
+    requestAnimationFrame(() =>
+      setTimeout(() => {
+        const load = (list) => {
+          for (const name of list) {
+            const s = document.createElement("script");
+            s.src = "chrome://celesta/content/" + name;
+            s.async = false;
+            document.body.appendChild(s);
+          }
+        };
+        load(FIRST);
+        /* the merged catalogue (sites.bin, ~102 MB): the page's own fetch of
+           chrome:// content is unreliable in the privileged window, so the
+           CelestaHome actor reads it in the parent and hands the bytes over
+           (boot dispatches "Celesta-dataset"; the actor replies with
+           "Celesta-dataset-ready" after setting CelestaBin, or empty). If the
+           hand-off gives nothing, the page fetches itself; last resort the
+           radar export loads as a script. */
+        const bootDbg = (v) => { diag("dataset " + v); globalThis.performance?.mark("celesta-boot-" + v); };
+        const pageDataset = () => fetch("chrome://celesta/content/sites.bin")
+          .then((r) => (r.ok ? r.arrayBuffer() : Promise.reject(new Error("no binary"))))
+          .then((buf) => { bootDbg("bin ok " + buf.byteLength); globalThis.CelestaBin = buf; })
+          .catch(() => fetch("chrome://celesta/content/sites-prebuilt.json")
+            .then((r) => (r.ok ? r.text() : Promise.reject(new Error("no prebuilt"))))
+            .then((text) => { globalThis.CelestaPrebuilt = JSON.parse(text); })
+            .catch((e2) => { bootDbg("json fail " + (e2 && (e2.message || e2.name))); load(["sites-radar.js", ...REST]); }));
+        const dataset = new Promise((res) => {
+          let settled = false;
+          const give = (v) => { if (!settled) { settled = true; res(v); } };
+          addEventListener("Celesta-dataset-ready", () => { give(globalThis.CelestaBin || null); }, { once: true });
+          bootDbg("dispatch");
+          dispatchEvent(new Event("Celesta-dataset"));
+          // the actor's handler is not always in place at once (it hooks the
+          // window at DOMContentLoaded): ask again; the actor always answers
+          // with "Celesta-dataset-ready", so a settled timeout only cuts off a
+          // truly absent actor and routes the page to its fetch fallbacks
+          setTimeout(() => { if (!settled) dispatchEvent(new Event("Celesta-dataset")); }, 600);
+          setTimeout(() => give(globalThis.CelestaBin || null), 8000);
+        });
+        dataset.then((bin) => {
+          if (bin) { globalThis.performance?.mark("celesta-actor-yes"); bootDbg("actor ok"); load(REST); }
+          else {
+            globalThis.performance?.mark("celesta-actor-no");
+            bootDbg("actor empty");
+            pageDataset().then(() => { if (globalThis.CelestaBin || globalThis.CelestaPrebuilt) load(REST); });
+          }
+        });
+      }, 0)
+    );
+  };
+  setTimeout(start, 120);   // never wait long for the picture
+  // a page restored with its own view (Back) does not open at the home view
+  if (history.state?.CelestaCam) {
+    start();
+    return;
+  }
+  start();
+})();
diff --git a/browser/content/celesta/bubbles.js b/browser/content/celesta/bubbles.js
new file mode 100644
index 0000000000..fa28c0e20d
--- /dev/null
+++ b/browser/content/celesta/bubbles.js
@@ -0,0 +1,667 @@
+/* ============================================================
+   Every site as a GPU circle (outline, faint fill, soft glow): one
+   instanced draw call, redrawn when the camera moves and a few times a
+   second as the galaxy turns (graph.js updateSpin). It draws on the page's
+   own thread, in the same frame as the DOM logos, so the two never drift
+   apart (a worker canvas lands a frame late). The cost of a frame barely
+   depends on how many sites there are or how far the view is zoomed. The
+   page keeps DOM elements only for the bubbles near the pointer.
+   ============================================================ */
+
+"use strict";
+
+const Bubbles = (() => {
+  const VS = `#version 300 es
+in vec2 aCorner;
+in vec4 aSite;        // world x, world y, radius (world px), hue (degrees)
+in float aRisk;       // 1 = flagged site, 2 = uncategorized
+in float aCat;        // motion group (graph.js updateSpin)
+uniform vec2 uRes;    // canvas size, CSS px
+uniform vec4 uSpin[128];  // per motion group: cos, sin of its turn and its shift (graph.js updateSpin)
+vec2 spin(vec2 p, float g) { vec4 t = uSpin[int(g + 0.5)]; return vec2(t.x * p.x - t.y * p.y, t.y * p.x + t.x * p.y) + t.zw; }
+uniform highp sampler2D uOff, uOffPrev;   // per site: how far it is pushed, in its group's frame (graph.js OFF), and before
+uniform float uOffT;                       // 0..1 from the previous push to this one (graph.js offMix)
+vec2 off(float i) { int k = int(i + 0.5); ivec2 c = ivec2(k & 1023, k >> 10); return mix(texelFetch(uOffPrev, c, 0).xy, texelFetch(uOff, c, 0).xy, uOffT); }
+uniform vec2 uPan;
+uniform float uZoom;
+uniform float uHover;   // site index under the pointer, or -1
+uniform float uLocked;  // site index of the lock-on target, or -1
+uniform float uWarp;    // 1 while diving into a site: the rest dims
+out vec2 vP;
+out float vR;
+out vec3 vCol;
+out float vRisk;
+out float vDim;
+out float vHot;
+out float vExt;
+vec3 hsl(float h, float s, float l) {
+  vec3 k = mod(vec3(0.0, 8.0, 4.0) + h / 30.0, 12.0);
+  float a = s * min(l, 1.0 - l);
+  return l - a * clamp(min(k - 3.0, 9.0 - k), -1.0, 1.0);
+}
+void main() {
+  float id = float(gl_InstanceID);
+  vHot = id == uLocked ? 2.0 : id == uHover ? 1.0 : 0.0;   // hovered and locked bubbles grow and glow
+  float r = max(aSite.z * uZoom, 0.7) * (vHot > 1.5 ? 1.35 : vHot > 0.5 ? 1.14 : 1.0);
+  float sr = aSite.z * uZoom;                        // on-screen radius before the minimum clamp
+  // distance LOD: sub-2 px bubbles already take the cheap dot path in the fragment
+  // shader, so their quad only needs to cover the dot, not a glow they never draw
+  float ext = vHot > 0.5 ? r * 3.2 + 3.0 : (sr < 1.5 ? r + 1.4 : r * 1.5 + 3.0);
+  vec2 s = uPan + spin(aSite.xy + off(id), aCat) * uZoom + aCorner * ext;
+  gl_Position = vec4(s.x / uRes.x * 2.0 - 1.0, 1.0 - s.y / uRes.y * 2.0, 0.0, 1.0);
+  vP = aCorner * ext;
+  vExt = ext;
+  vR = r;
+  vDim = aRisk > 5.0 ? 1.0 : (uWarp > 0.5 && vHot < 1.5 ? 0.5 : 0.0);   // flag + 10: left out by a #tag filter
+  float risk = aRisk - vDim * 10.0;
+  vRisk = risk;
+  vCol = risk > 1.5 ? vec3(0.42, 0.45, 0.55) : risk > 0.5 ? vec3(1.0, 0.36, 0.36) : hsl(aSite.w, 0.65, 0.62);
+}`;
+  const FS = `#version 300 es
+precision highp float;   // mediump turns a dived-into bubble's glow into blocks
+in vec2 vP;
+in float vR;
+in vec3 vCol;
+in float vRisk;
+in float vDim;
+in float vHot;
+in float vExt;
+out vec4 o;
+void main() {
+  float d = length(vP);
+  float a;
+  if (vR < 1.5) {
+    a = (1.0 - smoothstep(vR, vR + 1.0, d)) * 0.42;               // too small for an outline: a dot
+  } else {
+    float ring = 1.0 - smoothstep(0.0, 1.0, abs(d - vR));
+    float fill = (1.0 - smoothstep(vR - 1.0, vR, d)) * 0.07;
+    // the glow reaches zero before the quad's edge, or the quad shows as a faint square
+    float glow = d > vR ? exp(-(d - vR) / max(vR * (vHot > 0.5 ? 0.7 : 0.35), 1.5)) * (vHot > 1.5 ? 0.6 : vHot > 0.5 ? 0.42 : 0.16)
+                          * (1.0 - smoothstep(mix(vR, vExt, 0.5), vExt, d)) : 0.0;
+    a = ring * (vHot > 0.5 ? 0.95 : vRisk > 0.5 && vRisk < 1.5 ? 0.65 : 0.4) + fill + glow;
+  }
+  vec3 col = vHot > 1.5 ? mix(vCol, vec3(1.0), 0.5) : vCol;
