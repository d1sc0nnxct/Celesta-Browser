+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// The address bar suggests sites from the start page's database, matched the
+// way the start page's own search matches them (graph.js searchSites).
+// "#tag" words keep only sites in a category ("#news"), with a threat label
+// ("#malware") or with a word in their name or address ("#anime"); the start
+// of one is enough ("#mal"). While a "#tag" is being typed, one row lists
+// every category it can still become, as buttons. Adult sites are left out
+// unless Settings > Search turns them on (Celesta.search.adult).
+
+import { UrlbarProvider } from "moz-src:///browser/components/urlbar/UrlbarUtils.sys.mjs";
+import { XPCOMUtils } from "resource://gre/modules/XPCOMUtils.sys.mjs";
+
+const lazy = XPCOMUtils.declareLazy({
+  UrlbarResult: "chrome://browser/content/urlbar/UrlbarResult.mjs",
+  UrlbarShared: "chrome://browser/content/urlbar/UrlbarShared.mjs",
+});
+
+const MAX_RESULTS = 5;
+const ADULT_PREF = "Celesta.search.adult";
+const adultAllowed = () => Services.prefs.getBoolPref(ADULT_PREF, false);
+
+/* [lowercase "name domain", site] for every site, most popular first */
+let index = null;
+/* every category and subcategory tag ("news", "news/papers"), map order */
+let tagNames = null;
+function siteIndex() {
+  if (!index) {
+    const sandbox = Cu.Sandbox(Services.scriptSecurityManager.getSystemPrincipal(), { wantGlobalProperties: [] });
+    // the compact 3 MB list (top 50k, already merged and de-duplicated), not the
+    // 63 MB export: this runs in the parent process and used to block startup
+    Services.scriptloader.loadSubScript("chrome://celesta/content/sites.js", sandbox);
+    Services.scriptloader.loadSubScript("chrome://celesta/content/urlbar-sites.js", sandbox);
+    const rows = Cu.evalInSandbox("URLBAR_SITES", sandbox);
+    const subs = Cu.evalInSandbox("typeof SITE_SUBCATEGORIES == 'undefined' ? {} : SITE_SUBCATEGORIES", sandbox);
+    tagNames = Cu.evalInSandbox("SITE_CATEGORIES", sandbox)
+      .map(c => c.id)
+      .filter(id => id != "other")
+      .flatMap(id => [id, ...(subs[id] || []).map(([sub]) => id + "/" + sub)]);
+    index = rows.map(r => {
+      const [domain, name, cat, pop, risk, en, sub] = r;
+      const words = " " + (name + " " + (en ? en + " " : "") + domain).toLowerCase().replace(/[./_-]+/g, " ");
+      return [
+        (name + " " + (en ? en + " " : "") + domain).toLowerCase(),
+        {
+          name, domain, pop,
+          cats: sub ? [cat, sub, cat + "/" + sub] : [cat],
+          risk: (risk || "").toLowerCase().split("|").filter(Boolean),
+          words,
+          adult: (cat || "").split("|").includes("adult") || (sub || "").startsWith("adult"),
+        },
+      ];
+    });
+  }
+  return index;
+}
+/* "#tag" words and the rest of the query, lowercased */
+export function parseQuery(text) {
+  const words = text.trim().toLowerCase().split(/\s+/).filter(Boolean);
+  return {
+    tags: words.filter(w => w.length > 1 && w.startsWith("#")).map(w => w.slice(1)),
+    text: words.filter(w => !w.startsWith("#")).join(" "),
+  };
+}
+
+// "#gaming", "#esports" and "#gaming/esports" all find a gaming/esports site;
+// "#anime" also finds a site with a word that starts with it
+export const matchesTags = (site, tags) =>
+  tags.every(t => site.cats.some(c => c.startsWith(t)) || site.risk.some(r => r.startsWith(t)) || site.words.includes(" " + t));
+
+/* the "#tag" being typed at the end of the query (even a bare "#"), or null */
+export function typedTag(searchString) {
+  const m = /(?:^|\s)#(\S*)$/.exec(searchString);
+  return m ? m[1].toLowerCase() : null;
+}
+
+/* the tags a typed "#tag" can become: the categories, and a category's
+   subcategories once it is typed in full */
+export function tagChoices(prefix) {
+  siteIndex();
+  const adult = adultAllowed();
+  return tagNames.filter(
+    t => t.startsWith(prefix) && (!t.includes("/") || prefix.includes("/") || t.startsWith(prefix + "/")) && (adult || !t.startsWith("adult"))
+  );
+}
+
+export function searchSites({ tags, text }, limit) {
+  const out = [];
+  const seen = new Set();
+  const adult = adultAllowed();
+  for (const [key, site] of siteIndex()) {
+    if (key.includes(text) && !seen.has(site.domain) && (adult || !site.adult) && matchesTags(site, tags)) {
+      seen.add(site.domain);
+      out.push(site);
+      if (out.length == limit) {
+        break;
+      }
+    }
+  }
+  return out;
+}
+
+export class CelestaUrlbarProvider extends UrlbarProvider {
+  constructor() {
+    super();
+    // reading the database takes a moment: not on the first keystroke
+    ChromeUtils.idleDispatch(siteIndex);
+  }
+
+  get type() {
+    return lazy.UrlbarShared.PROVIDER_TYPE.PROFILE;
+  }
+
+  async isActive(queryContext) {
+    const query = parseQuery(queryContext.searchString);
+    return !queryContext.searchMode && (query.tags.length > 0 || query.text.length > 1 || typedTag(queryContext.searchString) != null) && !/^[a-z-]+:/.test(query.text);
+  }
+
+  startQuery(queryContext, addCallback) {
+    const prefix = typedTag(queryContext.searchString);
+    const tags = prefix == null ? [] : tagChoices(prefix);
+    if (tags.length) {
+      addCallback(
+        this,
+        new lazy.UrlbarResult({
+          type: lazy.UrlbarShared.RESULT_TYPE.DYNAMIC,
+          source: lazy.UrlbarShared.RESULT_SOURCE.OTHER_LOCAL,
+          suggestedIndex: 1,
+          // the typed text stays in the address bar while the row is selected
+          payload: { dynamicType: "CelestaTags", tags, input: queryContext.searchString },
+        })
+      );
+    }
+    for (const site of searchSites(parseQuery(queryContext.searchString), MAX_RESULTS)) {
+      const url = "https://" + site.domain + "/";
+      addCallback(
+        this,
+        new lazy.UrlbarResult({
+          type: lazy.UrlbarShared.RESULT_TYPE.URL,
+          source: lazy.UrlbarShared.RESULT_SOURCE.OTHER_LOCAL,
+          payload: { title: site.name, url, icon: "page-icon:" + url },
+        })
+      );
+    }
+  }
+
+  getViewTemplate(result) {
+    return {
+      children: [
+        {
+          name: "tags",
+          tag: "span",
+          children: result.payload.tags.map((t, i) => ({
+            name: "tag" + i,
+            tag: "span",
+            classList: ["urlbarView-button"],
+            attributes: { role: "button", "data-command": "tag:" + t },
+          })),
+        },
+      ],
+    };
+  }
+
+  getViewUpdate(result) {
+    const update = {
+      tags: { style: { display: "flex", "flex-wrap": "wrap", gap: "4px", padding: "4px 6px" } },
+    };
+    result.payload.tags.forEach((t, i) => {
+      update["tag" + i] = {
+        textContent: "#" + t,
+        style: { margin: "0", padding: "1px 10px", "line-height": "22px", "border-radius": "12px", "box-shadow": "inset 0 0 0 1px color-mix(in srgb, currentColor 30%, transparent)", cursor: "pointer" },
+      };
+    });
+    return update;
+  }
+
+  /* a picked tag replaces the one being typed and the query runs again */
+  onEngagement(queryContext, controller, details) {
+    const tag = details.selType?.startsWith("tag:") && details.selType.slice(4);
+    if (tag) {
+      controller.input.search(queryContext.searchString.replace(/#\S*$/, "#" + tag + " "));
+    }
+  }
+}
