+:root {
+  color-scheme: dark;
+  background:
+    radial-gradient(1px 1px at 12% 18%, #fff8, transparent),
+    radial-gradient(1px 1px at 72% 12%, #fff6, transparent),
+    radial-gradient(1.5px 1.5px at 38% 74%, #cfd6ff, transparent),
+    radial-gradient(1px 1px at 86% 64%, #fff7, transparent),
+    radial-gradient(1px 1px at 22% 88%, #fff5, transparent),
+    radial-gradient(1.5px 1.5px at 58% 34%, #ffe6c8, transparent),
+    radial-gradient(1px 1px at 92% 92%, #fff5, transparent),
+    radial-gradient(60% 50% at 30% 20%, rgba(120, 60, 160, 0.18), transparent),
+    radial-gradient(50% 40% at 80% 85%, rgba(40, 120, 160, 0.14), transparent),
+    #000;
+}
+
+/* !important: Firefox's error page styles the body too */
