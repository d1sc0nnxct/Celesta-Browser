+/* ============================================================
+   OLED black floating home ΓÇö Obsidian-style star network
+   Palette: true black canvas, glass panels, nebula accent
+   ============================================================ */
+
+:root {
+  --bg: #000000;
+  /* the theme (Settings > Appearance, set by CelestaHomeChild) styles panels and accents */
+  --accent: var(--Celesta-accent, #8b93ff);
+  --text-dim: var(--Celesta-text-dim, rgba(255,255,255,0.62));
+  --text: var(--Celesta-text, rgba(255,255,255,0.92));
+  --text-2: var(--Celesta-text-2, rgba(255,255,255,0.45));
+  --surface: var(--Celesta-glass, rgba(4,4,7,0.92));
+  --surface-inner: color-mix(in srgb, var(--Celesta-glass-solid, rgb(5 5 8 / 0.84)) 55%, transparent);
+  --radius: var(--Celesta-radius, 14px);
+  --glass: var(--Celesta-glass, rgba(255,255,255,0.055));
+  --glass-border: var(--Celesta-border, rgba(255,255,255,0.14));
+}
+
+* { margin: 0; padding: 0; box-sizing: border-box; }
+
+html, body {
+  width: 100%; height: 100%;
+  overflow: hidden;
+  background: var(--bg);
+  font-family: "Segoe UI Variable", "Segoe UI", system-ui, sans-serif;
+  -webkit-font-smoothing: antialiased;
+  user-select: none;
+  cursor: grab;
+}
+body.dragging { cursor: grabbing; }
+/* a tab's stand-in under the window's shared start page (CelestaHomeChild) */
+[data-Celesta-mode="standin"] body > * { display: none; }
+
+/* ---------- WebGL space backdrop: nebulae + galactic band + stars (follows the view) ---------- */
+#space {
+  position: fixed; inset: 0;
+  width: 100vw; height: 100vh;      /* canvas is a replaced element: inset alone
+                                      keeps its intrinsic (backing-store) size */
+  z-index: 0;
+  display: block;
+  pointer-events: none;
+  background: #000 var(--Celesta-snap, none) center / cover;   /* the last sky, until this one draws */
+}
+/* picture, GIF or video background (Settings > Home), in place of the sky */
+#bgmedia {
+  position: fixed; inset: 0;
+  width: 100vw; height: 100vh;
+  z-index: 0;
+  object-fit: cover;
+  pointer-events: none;
+}
+
+/* ---------- scene: pan + zoom transform applied via JS ----------
+   the scene div passes clicks through; only the nodes themselves catch
+   pointers */
+/* every site as a GPU circle (bubbles.js) */
+#bubbles {
+  position: fixed; inset: 0;
+  width: 100vw; height: 100vh;
+  z-index: 1;
+  pointer-events: none;
+}
+#scene {
+  position: absolute; inset: 0;
+  z-index: 1;
+  transform-origin: 0 0;
+  pointer-events: none;
+  will-change: transform;   /* composited zoom: scaling re-uses the layer, no re-raster storm */
+}
+
+/* one box per category, turned with the galaxy (graph.js updateSpin); its
+   bubbles and names turn back by as much, so they stay upright */
+.catbox {
+  position: absolute; left: 0; top: 0;
+  transform-origin: 0 0;
+}
+.catbox > .node, .catbox > .sublabel { rotate: var(--unspin, 0rad); }
+/* subcategory names, faint, over their arms of the map (graph.js buildSubLabels) */
+.sublabel {
+  position: absolute; left: 0; top: 0;
+  width: 0; height: 0;
+  pointer-events: none;
+}
+.sublabel > span {
+  position: absolute; left: 0; top: 0;
+  transform: translate(-50%, -50%);
+  white-space: nowrap;
+  font-weight: 600; letter-spacing: .04em;
+  color: hsl(var(--hue, 230), 60%, 82%);
+  text-shadow: 0 0 .4em #000;
+  opacity: 0;
+  transition: opacity .16s ease;
+}
+.sublabel.on > span { opacity: .34; }
+.sublabel.cat > span { font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
+.sublabel.cat.on > span { opacity: .42; }
+/* a dive zooms names far past their size: they go at once (fading out, a name
+   a hundred times its size had its blurred shadow painted on the CPU) */
+body.warping .sublabel > span { opacity: 0; transition: none; }
+
+body.loading { cursor: progress; }
+
+/* profiling mode: graph.js #perfbox */
+#perfbox {
+  position: fixed; left: 12px; bottom: 12px; z-index: 70;
+  padding: 6px 9px;
+  border-radius: 8px;
+  background: rgb(0 0 0 / .7);
+  color: #9f9;
+  font: 11px/1.45 ui-monospace, monospace;
+  white-space: pre;
+  pointer-events: none;
+}
+
+/* ---------- nodes ---------- */
+.node {
+  position: absolute; left: 0; top: 0;
+  width: 0; height: 0;
+  cursor: pointer;
+  z-index: 2;
+  pointer-events: auto;      /* re-enable hit-testing under the pointer-transparent scene */
+}
+.orb {
+  position: absolute; left: 0; top: 0;
+  transform: translate(-50%, -50%);
+  width: var(--sz, 46px); height: var(--sz, 46px);
+  border-radius: 50%;
+  display: grid; place-items: center;
+  background: transparent;                     /* the ring and glow are drawn by bubbles.js */
+  transition: transform .2s cubic-bezier(.2,.9,.3,1.25), box-shadow .18s ease, border-color .18s ease;
+}
+.orb > * { grid-area: 1 / 1; }   /* monogram and favicon share the same cell */
+.orb img {
+  width: 58%; height: 58%;
+  max-width: 72px; max-height: 72px;
+  border-radius: 5px;
+  object-fit: contain;
+  pointer-events: none;
+}
+.orb .mono {
+  font-size: calc(var(--sz, 46px) * 0.36); font-weight: 600;
+  color: rgba(255,255,255,0.8);
+  text-transform: uppercase;
+}
+/* the site icon (favicon, falling back to the monogram) only appears
+   when the cursor comes near ΓÇö far away the nodes are just stars */
+.orb img, .orb .mono {
+  opacity: 0;
+  transition: opacity .12s ease;
+}
+.node.near .orb img, .node.near .orb .mono,
+.node:hover .orb img, .node:hover .orb .mono,
+.node.locked .orb img, .node.locked .orb .mono { opacity: 1; }
+/* Settings > Home > Site logos: Always */
+.logos-always .orb img, .logos-always .orb .mono { opacity: 1; }
+.node:hover .orb, .node.active .orb {
+  transform: translate(-50%, -50%) scale(1.14);
+}
+
+/* the letter monogram only shows when the icon chain died ΓÇö never behind a logo */
+.orb.has-img .mono { display: none; }
+
+/* ---------- site counter ---------- */
+#sitecount {
+  position: fixed; right: 20px; bottom: 26px;
+  z-index: 5;
+  padding: 7px 14px;
+  border-radius: 999px;
+  background: var(--glass);
+  border: 1px solid var(--glass-border);
+  color: rgba(255,255,255,0.56);
+  font-size: 11.5px; letter-spacing: .04em;
+  font-variant-numeric: tabular-nums;
+  pointer-events: none;
+}
+#sitecount:empty { display: none; }
+
+/* ---------- random site button ---------- */
+#randombtn {
+  position: fixed; left: 20px; bottom: 26px;
+  z-index: 5;
+  display: flex; align-items: center; gap: 8px;
+  padding: 7px 14px;
+  border-radius: 999px;
+  background: var(--glass);
+  border: 1px solid var(--glass-border);
+  color: rgba(255,255,255,0.56);
+  font: inherit; font-size: 11.5px; letter-spacing: .04em;
+  cursor: pointer;
+  transition: color .16s ease, border-color .16s ease;
+}
+#randombtn:hover { color: rgba(255,255,255,0.92); border-color: rgba(255,255,255,0.3); }
+#randombtn:focus-visible { outline: 2px solid rgba(255,255,255,0.6); outline-offset: 2px; }
+body.warping #randombtn { opacity: 0; transition: opacity .16s ease; }
+
+/* ---------- bottom hint chip ---------- */
+#hint {
+  position: fixed; left: 50%; bottom: 26px;
+  transform: translateX(-50%);
+  z-index: 5;
+  display: flex; align-items: center; gap: 8px;
+  padding: 7px 14px;
+  border-radius: 999px;
+  background: var(--glass);
+  border: 1px solid var(--glass-border);
+  color: rgba(255,255,255,0.56);
+  font-size: 11.5px; letter-spacing: .04em;
+  pointer-events: none;
+  animation: hintfade 1s ease 6s forwards;
+}
+@keyframes hintfade { to { opacity: .28; } }
+
+/* ---------- floating bubble chrome: tabs on top, bookmarks below ----------
+   pills share the cluster's dim transparency; text reveals on proximity ---------- */
+#chrome {
+  position: fixed; top: 8px; left: 50%;
+  transform: translateX(-50%);
+  z-index: 20;
+  display: flex; flex-direction: column; align-items: center; gap: 5px;
+  max-width: calc(100vw - 16px);
+}
+.chrome-title { position: absolute; top: -22px; left: 50%; transform: translateX(-50%); font-size: 10px; color: rgba(255,255,255,0.35); letter-spacing: .08em; pointer-events: none; }
+.cluster {
+  display: flex; align-items: center; gap: 4px;
+  padding: 5px 6px;
+  background: rgba(5, 5, 8, 0.72);
+  border: 1px solid rgba(255,255,255,0.10);
+  border-radius: 24px;
+  box-shadow: 0 8px 26px rgba(0,0,0,0.45);
+  transition: box-shadow .25s ease, background .25s ease;
+}
+#chrome:hover .cluster {
+  background: rgba(6, 6, 9, 0.66);
+  box-shadow:
+    0 10px 32px rgba(0,0,0,0.55),
+    0 0 20px rgba(139,147,255,0.10);
+}
+.tab, .bm {
+  display: flex; align-items: center; gap: 4px;
+  border: 1px solid rgba(255,255,255,0.07);
+  border-radius: 999px;
+  background: rgba(5,5,8,0.5);               /* darker pills for contrast against the void */
+  color: var(--text-dim);
+  font-size: 11px; font-family: inherit;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background .16s ease, color .16s ease, border-color .16s ease, transform .16s ease, box-shadow .16s ease;
+}
+.tab { padding: 4px 8px; }
+.tab:hover, .bm:hover {
+  background: rgba(255,255,255,0.07);
+  color: #fff;
+  transform: translateY(-1px);
+}
+.tab.active {
+  background: rgba(139,147,255,0.09);
+  border-color: rgba(139,147,255,0.35);
+  color: #fff;
+  box-shadow: 0 0 10px rgba(139,147,255,0.18);
+}
+.tab img, .bm img {
+  width: 12px; height: 12px;
+  border-radius: 3px;
+  object-fit: contain;
+  flex: none;
+}
+.tab .tglyph {
+  width: 12px; height: 12px;
+  display: grid; place-items: center;
+  color: #aab0ff; font-size: 11px; line-height: 1;
+  text-shadow: 0 0 8px rgba(139,147,255,0.8);
+  flex: none;
+}
+/* bubble text stays hidden until the cursor comes near the cluster */
+.tab .tl, .bm span {
+  max-width: 0;
+  opacity: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  transition: max-width .24s ease, opacity .18s ease;
+}
+#chrome:hover .tab .tl { max-width: 100px; opacity: 1; }
+#chrome:hover .bm span { max-width: 90px;  opacity: 1; }
+.tab .x {
+  width: 13px; height: 13px;
+  display: grid; place-items: center;
+  border-radius: 50%;
+  font-size: 11px; line-height: 1;
+  color: rgba(255,255,255,0.4);
+  opacity: 0;
+  transition: opacity .15s ease, background .15s ease, color .15s ease;
+}
+.tab:hover .x { opacity: 1; }
+.tab .x:hover { background: rgba(255,255,255,0.18); color: #fff; }
+.tab.add {
+  background: rgba(6,6,9,0.38);
+  color: rgba(255,255,255,0.45);
+  font-size: 13px;
+  padding: 2px 8px;
+}
+.bm {
+  padding: 3px 7px;
+  font-size: 10.5px;
+}
+
+/* ---------- warp transition: lock-on target + fade overlay ---------- */
+.node.locked .orb {
+  transform: translate(-50%, -50%) scale(1.35);
+  transition: transform .4s ease;
+}
+body.warping .node:not(.locked) { opacity: 0.22; transition: opacity .5s ease; }
+.node.filtered { opacity: 0.12; pointer-events: none; }   /* left out by a #tag search */
+body.warping #chrome, body.warping #hint { opacity: 0; transition: opacity .16s ease; }
+#warp {
+  position: fixed; inset: 0;
+  z-index: 60;
+  background: #000;
+  opacity: 0;
+  pointer-events: none;
+}
+
+/* ---------- floating omnibox ---------- */
+#omnibox {
+  position: fixed; z-index: 50;
+  min-width: 380px; max-width: 640px;
+  background: var(--surface);          /* the theme's surface (Settings > Appearance) */
+  border-radius: calc(var(--radius) * 2 / 3);
+  box-shadow: 0 14px 40px rgba(0,0,0,0.6);
+  overflow: hidden;
+  transform-origin: top left;
+  opacity: 1;
+  transition: opacity .16s ease;
+}
+#omnibox.hidden {
+  opacity: 0;
+  display: none;
+  pointer-events: none;
+  transition: opacity .13s ease, display 0.02s linear .12s;
+  transition-behavior: allow-discrete;
+}
+
+.omni-row {
+  display: flex; align-items: center; gap: 9px;
+  padding: 11px 13px;
+}
+.omni-glyph { color: var(--Celesta-icon, rgba(255,255,255,0.4)); flex: none; }
+#omni {
+  flex: 1;
+  background: none; border: none; outline: none;
+  color: var(--text);
+  font-size: 14px;
+  font-family: inherit;
+  user-select: text;
+  cursor: text;
+}
+#omni::placeholder { color: var(--text-2); }
+kbd {
+  font-family: inherit; font-size: 9.5px;
+  color: var(--text-2);
+  background: var(--surface-inner);
+  border-radius: 5px;
+  padding: 2px 5px;
+  flex: none;
+}
+
+#suggestions {
+  list-style: none;
+  padding: 5px;
+  max-height: 264px;
+  overflow-y: auto;
+}
+#suggestions.hidden { display: none; }
+#suggestions li {
+  display: flex; align-items: center; gap: 10px;
+  padding: 8px 9px;
+  border-radius: 9px;
+  font-size: 13px;
+  color: var(--text);
+  cursor: pointer;
+}
+#suggestions li .dot {
+  width: 20px; height: 20px; border-radius: 50%;
+  background: var(--surface-inner);
+  display: grid; place-items: center; flex: none;
+  overflow: hidden;
+}
+#suggestions li .dot img { width: 12px; height: 12px; object-fit: contain; }
+#suggestions li .nm { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+#suggestions li .dm { color: var(--text-2); font-size: 11.5px; }
+#suggestions li.sel {
+  background: color-mix(in srgb, var(--Celesta-accent-2, #8b93ff) 22%, transparent);
+  color: var(--Celesta-text-strong, #fff);
+}
+#suggestions li.search .dot::after {
+  content: ""; width: 10px; height: 10px;
+  background:
+    radial-gradient(circle, transparent 42%, rgba(255,255,255,0.7) 43%, rgba(255,255,255,0.7) 58%, transparent 59%),
+    linear-gradient(45deg, transparent 55%, rgba(255,255,255,0.7) 56%, rgba(255,255,255,0.7) 70%, transparent 71%);
+}
+
+/* ---------- right-click dropdown menu for bubbles ---------- */
+#ctxmenu {
+  position: fixed; z-index: 65;
+  min-width: 210px;
+  padding: 5px;
+  background: var(--surface);
+  border-radius: calc(var(--radius) * 2 / 3);
+  box-shadow:
+    0 18px 46px rgba(0,0,0,0.78),
+    0 0 26px hsla(var(--hue, 220), 80%, 60%, 0.12);
+  opacity: 1;
+  transition: opacity .12s ease;
+}
+#ctxmenu.hidden {
+  opacity: 0;
+  display: none;
+  pointer-events: none;
+}
+.ctx-head {
+  display: flex; flex-direction: column; gap: 1px;
+  padding: 7px 10px 6px;
+  margin-bottom: 4px;
+}
+.ctx-head b {
+  font-size: 12px; font-weight: 600; letter-spacing: .01em;
+  color: var(--Celesta-text-strong, #fff);
+}
+.ctx-head span {
+  font-size: 10px;
+  color: var(--text-2);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+  max-width: 210px;
+}
+.ctx-item {
+  display: block; width: 100%;
+  padding: 8px 11px;
+  border: none; border-radius: 8px;
+  background: none;
+  color: var(--text);
+  font: inherit; font-size: 12.5px;
+  text-align: left;
+  cursor: pointer;
+  transition: background .12s ease, color .12s ease;
+}
+.ctx-item:hover { background: color-mix(in srgb, var(--Celesta-accent-2, #8b93ff) 22%, transparent); color: var(--Celesta-text-strong, #fff); }
+.ctx-item.done {
+  color: hsla(var(--hue, 220), 85%, 75%, 0.95);
+  background: hsla(var(--hue, 220), 70%, 60%, 0.08);
+}
+
+/* ---------- flagged sites: warning ring on the bubble, and a dialog
+   before opening one (graph.js guardRisk) ---------- */
+#riskdlg {
+  position: fixed; inset: 0;
+  z-index: 50;
+  display: grid; place-items: center;
+  background: rgba(0, 0, 0, 0.55);
+}
+#riskdlg .risk-box {
+  max-width: 440px;
+  padding: 20px 22px;
+  border-radius: calc(var(--radius) * 2 / 3);
+  background: var(--surface);
+  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7), inset 0 0 0 1px hsla(0, 80%, 60%, 0.35);
+  color: var(--text);
+  font-size: 13px; line-height: 1.5;
+}
+#riskdlg h2 { margin: 0 0 8px; font-size: 16px; color: hsl(0, 85%, 70%); }
+#riskdlg a { color: #aab0ff; }
+#riskdlg ul { margin: 6px 0 14px; padding-inline-start: 18px; }
+#riskdlg li { margin-bottom: 4px; }
+#riskdlg .risk-actions { display: flex; justify-content: flex-end; gap: 8px; }
+#riskdlg button {
+  padding: 6px 14px;
+  border: 1px solid rgba(255, 255, 255, 0.18);
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.06);
+  color: #fff;
+  font: inherit;
+  cursor: pointer;
+}
+#riskdlg button.go { border-color: hsla(0, 80%, 60%, 0.6); color: hsl(0, 90%, 78%); }
+#riskdlg button:focus-visible { outline: 2px solid #aab0ff; outline-offset: 2px; }
+
+/* light mode (Settings > Appearance): the start page's panels take the theme's
+   text color; the map keeps its own background */
+:root[Celesta-light] :is(#hint, #sitecount, #randombtn, #omnibox, #omni, #ctxmenu, #riskdlg .risk-box) {
+  color: var(--Celesta-text);
+}
+
+/* celesta hover volume: a quiet control next to "Random site" */
+#soundbtn {
+  position: fixed; left: 158px; bottom: 26px; z-index: 5;
+  display: flex; align-items: center; justify-content: center;
+  width: 30px; height: 30px; border-radius: 999px;
+  background: var(--glass); border: 1px solid var(--glass-border);
+  color: rgba(255,255,255,0.56); cursor: pointer;
+  transition: color .16s ease, border-color .16s ease;
+}
+#soundbtn:hover { color: #fff; border-color: rgba(255,255,255,0.28); }
+#volume {
+  position: fixed; left: 198px; bottom: 26px; z-index: 6;
+  height: 30px; box-sizing: border-box; display: flex; align-items: center;
+  padding: 0 10px; border-radius: 999px;
+  background: var(--glass); border: 1px solid var(--glass-border);
+}
+#volume.hidden { display: none; }
+#volumeSlider {
+  width: 110px; height: 14px; vertical-align: middle;
+  accent-color: rgba(255,255,255,0.7);
+  background: transparent;
+}
+
+/* bubbles fade in and out instead of popping with their DOM nodes */
+.node { transition: opacity .12s ease; }
+.node.leaving { opacity: 0; }
