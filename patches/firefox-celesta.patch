+    if (p.mem > 1536 * MB) {
+      warn("ram " + p.key, `HIGH RAM ${p.key} uses ${mb(p.mem)}`);
+    }
+    if (pct > 90) {
+      warn("cpu " + p.key, `HIGH CPU ${p.key} used ${pct}% of a core for ${SAMPLE_MS / 1000} s`, 120000);
+    }
