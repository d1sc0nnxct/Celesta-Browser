+  /* the name's rect in the atlas [x, y, w, h], drawn if new; null when the atlas is full */
+  function slot(text, en) {
+    const key = text + "\n" + (en || "");
+    if (slots.has(key)) return slots.get(key);
+    const ctx = atlasCtx, pad = Math.ceil(2 * raster);
+    const big = `500 ${FONT_PX * raster}px ${family}`, small = `500 ${FONT_PX * 0.82 * raster}px ${family}`;
+    ctx.letterSpacing = (0.02 * FONT_PX * raster).toFixed(2) + "px";
+    ctx.font = big;
+    let w = ctx.measureText(text).width;
+    if (en) { ctx.font = small; w = Math.max(w, ctx.measureText(en).width); }
+    w = Math.ceil(w) + 2 * pad;
+    const h = Math.ceil(LINE_PX * raster * (en ? 1.85 : 1)) + 2 * pad;
+    if (shelfX + w > ATLAS) { shelfX = 0; shelfY += shelfH; shelfH = 0; }
+    if (shelfY + h > ATLAS || w > ATLAS) return null;
+    const x = shelfX, y = shelfY;
+    shelfX += w + 1; shelfH = Math.max(shelfH, h + 1);
+    ctx.clearRect(x, y, w, h);
+    ctx.textAlign = "center"; ctx.textBaseline = "top";
+    const cx = x + w / 2;
+    const line = (str, font, ty, alpha) => {
+      ctx.font = font;
+      // a sharp shadow keeps names readable over bright bubbles and nebulae
+      ctx.fillStyle = `rgba(0,0,0,${0.95 * alpha})`;
+      ctx.fillText(str, cx, ty + raster);
+      ctx.fillStyle = `rgba(255,255,255,${alpha})`;
+      ctx.fillText(str, cx, ty);
+    };
+    line(text, big, y + pad, 1);
+    if (en) line(en, small, y + pad + LINE_PX * raster, 0.62);
+    const rect = [x, y, w, h];
+    slots.set(key, rect);
+    if (ok) send({ glyphs: { x, y, image: ctx.getImageData(x, y, w, h) } });
+    return rect;
+  }
+
+  /* Names coming on screen are drawn into the atlas a few per frame, and each
+     fades in after a short random delay, so a pan over many new names never
+     stalls a frame. born: site index -> when its name starts fading in */
+  const RASTER_PER_FRAME = 12, FADE_MS = 220;
+  const born = new Map();
+  let rasterPending = false;
+
+  /* list: { i: site index, x, y: its bubble's centre (world), cat: category index,
+     dy: world px from there down to the name's top centre, text, en, dim } */
+  function setLabels(list, retried = false) {
+    labels = list;
+    if (!ok) return;
+    if (!atlasCtx) resetAtlas();
+    const data = new Float32Array(list.length * LABEL_STRIDE);
+    const now = performance.now(), keep = new Set();
+    let n = 0, budget = RASTER_PER_FRAME;
+    rasterPending = false;
+    for (const l of list) {
+      let r = slots.get(l.text + "\n" + (l.en || ""));
+      if (!r) {
+        if (budget-- <= 0) { rasterPending = true; continue; }
+        r = slot(l.text, l.en);
+        if (!r && !retried) { resetAtlas(); return setLabels(list, true); }   // full: start over with what is shown now
+        if (!r) continue;
+      }
+      keep.add(l.i);
+      if (!born.has(l.i)) born.set(l.i, now + Math.random() * 150);
+      data.set([l.x, l.y, l.i, l.dim ? 1 : 0, ...r, born.get(l.i), l.cat, l.dy], n++ * LABEL_STRIDE);
+    }
+    for (const i of born.keys()) if (!keep.has(i)) born.delete(i);
+    send({ labels: data.subarray(0, n * LABEL_STRIDE) });
+    if (last) draw(last.pan, last.zoom);
+  }
+
+  /* true while names are still being drawn or fading in: the page keeps drawing frames */
+  function animating(now) {
+    if (rasterPending) setLabels(labels);
+    if (rasterPending) return true;
+    for (const t of born.values()) if (now < t + FADE_MS) return true;
+    return false;
+  }
+
+  /* hover, locked: site index or -1; warp: names dim except the locked one */
+  function setLabelState(hover, locked, warp) {
+    labelState = [hover, locked, warp ? 1 : 0];
+    if (!ok) return;
+    send({ labelState });
+    if (last) draw(last.pan, last.zoom);
+  }
+
+  function init() {
+    const canvas = document.getElementById("bubbles");
+    if (!canvas) return false;
+    send = rendererMain((data) => {
+      if (!data.ok) { if (data.log) console.error("bubbles shader:", data.log); return; }
+      ok = true;
+    });
+    send({ canvas });
+    if (!ok) return false;
+    resize();
+    if (sites) send({ sites });
+    if (offsets) send({ off: offsets, prev: prevOffsets, row0: 0, row1: 0 });
+    if (edges) send({ edges });
+    send({ labelState });
+    if (labels.length) setLabels(labels);
+    if (last) draw(last.pan, last.zoom);
+    return true;
+  }
+
+  function resize() {
+    if (!ok) return;
+    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
+    if (atlasCtx && Math.min(window.devicePixelRatio || 1, 1.5) !== raster) { resetAtlas(); setLabels(labels); }
+    send({ size: [Math.round(innerWidth * dpr), Math.round(innerHeight * dpr)], css: [innerWidth, innerHeight], raster: Math.min(window.devicePixelRatio || 1, 1.5) });
+    if (last) draw(last.pan, last.zoom);
+  }
+
+  /* data: Float32Array of STRIDE floats per site */
+  /* each site's push (graph.js OFF) and the one before it (prev); rows
+     row0..row1 (1024 sites each) changed. mix: how far the drawing is from
+     prev to off (0..1), and snap: nothing moves (names on the pixel grid) */
+  let offsets = null, prevOffsets = null, offT = 1, snap = true;
+  function setOffsets(off, row0, row1, prev = off) {
+    offsets = off; prevOffsets = prev;
+    if (ok) send({ off, prev, row0, row1 });
+  }
+  function setMotion(mix, still) { offT = mix; snap = still; }
+  function setSites(data) {
+    sites = data;
+    if (ok) send({ sites });
+  }
+
+  /* dim[i] true greys site i out (a #tag filter); null shows every site */
+  function setDim(dim) {
+    if (!sites) return;
+    for (let i = 0; i * STRIDE < sites.length; i++) {
+      const flag = sites[i * STRIDE + 4] % 10;
+      sites[i * STRIDE + 4] = dim?.[i] ? flag + 10 : flag;
+    }
+    if (ok) send({ sites });
+    if (last) draw(last.pan, last.zoom);
+  }
+
+  function setHue(i, hue) {
+    if (sites) sites[i * STRIDE + 3] = hue;
+    if (ok) send({ hue: [i, hue] });
+  }
+
+  /* spin: Float32Array of cos, sin, shift x, shift y per motion group (graph.js updateSpin) */
+  let spin = null;
+  function draw(pan, zoom, turn = spin) {
+    spin = turn;
+    last = { pan: { x: pan.x, y: pan.y }, zoom };
+    if (ok) send({ pan: [pan.x, pan.y], zoom, t: performance.now(), spin, offT, snap });
+  }
+
+  /* draws like draw(), then resolves with that frame's { w, h, pixels }:
+     RGBA rows bottom first, premultiplied (null if it failed) */
+  function shot(pan, zoom, turn = spin) {
+    return new Promise((resolve) => {
+      if (!ok) { resolve(null); return; }
+      spin = turn;
+      last = { pan: { x: pan.x, y: pan.y }, zoom };
+      send({ pan: [pan.x, pan.y], zoom, t: performance.now(), spin, offT, snap, shot: resolve });
+    });
+  }
+
+  /* profiling mode: { shaders: build ms per program, gpu: ms per timed frame since the last call } */
+  function perf() {
+    const out = { shaders: perfData.shaders, gpu: perfData.gpu };
+    perfData.gpu = [];
+    return out;
+  }
+
+  return { init, resize, setSites, setOffsets, setMotion, setHue, setDim, setLabels, setLabelState, setEdges, animating, draw, shot, perf, STRIDE, EDGE_STRIDE };
+})();
diff --git a/browser/content/celesta/celestaBarsChild.sys.mjs b/browser/content/celesta/celestaBarsChild.sys.mjs
new file mode 100644
index 0000000000..fc3a04e59f
--- /dev/null
+++ b/browser/content/celesta/celestaBarsChild.sys.mjs
@@ -0,0 +1,83 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { clearTimeout, setTimeout } from "resource://gre/modules/Timer.sys.mjs";
+
+// Tells the browser window when the pointer rests at the top edge of the page
+// (or the left edge in vertical tab mode) and when it moves away again, so the
+// hidden bars come back and stay up while the pointer rests there. The page
+// sees the real pointer even where the OS keeps the window's own top pixels
+// for resizing, which a hot zone in the chrome cannot. The pointer must stay
+// near the edge for DWELL_MS, so passing through it does not reveal the bars.
+const NEAR_PREF = "Celesta.bars.activation";
+const AWAY_PX = 80;
+const DWELL_MS = 150;
+
+export class CelestaBarsChild extends JSWindowActorChild {
+  handleEvent(event) {
+    const side = Services.prefs.getBoolPref("Celesta.tabs.vertical", false);
+    const { clientX: x, clientY: y } = event;
+    // Settings > Home > Floating bars: how close to the edge the pointer must come
+    const NEAR_PX = Services.prefs.getIntPref(NEAR_PREF, 3);
+    let near;
+    if (event.type == "mouseout") {
+      if (event.relatedTarget) {
+        return;
+      }
+      // Left the page. Through the top edge (or the side one) means the
+      // pointer was thrown at the bars: show them now, without the dwell,
+      // since the page sees no more events there. Anywhere else, the bars'
+      // own hover takes over.
+      clearTimeout(this.dwell);
+      this.dwell = null;
+      // the last move before leaving can be a few pixels short of the edge
+      this.send(y < NEAR_PX * 3 || (side && x < NEAR_PX * 3));
+      return;
+    } else if (y < NEAR_PX || (side && x < NEAR_PX)) {
+      near = true;
+    } else if (y > AWAY_PX && (!side || x > AWAY_PX)) {
+      near = false;
+    } else {
+      // between the zones: a pending reveal is cancelled, a shown one stays
+      if (!this.near) {
+        clearTimeout(this.dwell);
+        this.dwell = null;
+      }
+      return;
+    }
+    if (near && !this.near) {
+      this.dwell ??= setTimeout(() => {
+        this.dwell = null;
+        this.send(true);
+      }, DWELL_MS);
+      return;
+    }
+    clearTimeout(this.dwell);
+    this.dwell = null;
+    this.send(near);
+  }
+
+  send(near) {
+    if (near !== this.near) {
+      this.near = near;
+      this.sendAsyncMessage("CelestaBars:Near", near);
+    }
+  }
+
+  didDestroy() {
+    clearTimeout(this.dwell);
+  }
+}
+
+// Settings > Home > Memory asks each frame of a tab before pausing it: one
+// playing a video or audio, muted or not, is not paused (see chrome.js
+// setUpTabPausing)
+export class CelestaMediaChild extends JSWindowActorChild {
+  receiveMessage(message) {
+    if (message.name == "CelestaMedia:Playing") {
+      return [...this.document.querySelectorAll("video, audio")].some(m => !m.paused && !m.ended);
+    }
+    return null;
+  }
+}
