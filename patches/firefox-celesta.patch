diff --git a/browser/content/celesta/space.js b/browser/content/celesta/space.js
new file mode 100644
index 0000000000..a97fbd9ccd
--- /dev/null
+++ b/browser/content/celesta/space.js
@@ -0,0 +1,502 @@
+/* ============================================================
+   space.js ΓÇö WebGL fullscreen background for the home page
+   Realistic procedural sky: domain-warped fbm nebulae with dark
+   dust lanes, a tilted galactic band (haze + dense star field),
+   three colored star layers (temperature, twinkle, diffraction
+   spikes on the brightest), and dithering to keep OLED blacks
+   free of banding. Earlier version adapted from Rye Terrell's
+   "Procedural 2D Space Scenes in WebGL" (wwwtyro.net, 2016) ΓÇö
+   completely free license (attribution appreciated, not
+   required). Pan parallax keeps the sky locked to the view; the sky
+   never rescales on zoom (infinite distance), and a final contrast
+   pass deepens the void without touching true black.
+   ============================================================ */
+
+"use strict";
+
+const Space = (() => {
+  const VS = `#version 300 es
+in vec2 aPos;
+void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
+`;
+
+
+  /* The loop counts are uniforms (uCells 1, uOctaves 4, uLayers 3), not constants:
+     constant loops are unrolled and inlined by the Windows shader compiler
+     behind WebGL, which made this shader take ~4.7 s to build instead of
+     ~1.3 s, blocking the GPU process's WebGL thread meanwhile. */
+  const FS = `#version 300 es
+precision highp float;
+out vec4 fragColor;
+
+uniform vec2  uRes;     // canvas size, device px
+uniform float uTime;    // seconds
+uniform vec2  uPan;     // view pan in device px (DOM orientation, y down)
+uniform float uZoom;    // the sky's zoom: the page's, damped (Space.draw)
+uniform vec2  uF0, uF1, uF2, uF3, uF4, uF5;   // each layer's focus, device px (Space.draw)
+uniform float uStarZ;   // star cell scale: follows the page zoom 1:1
+uniform float uStarK;   // star size: page zoom / home zoom
+uniform float uNebula;  // 1 = nebulae and galactic band, 0 = stars only
+uniform float uStars;   // 1 = background stars, 0 = none
+uniform int uCells;     // 1: each star cell looks at its 3x3 neighbours
+uniform int uOctaves;   // 4
+uniform int uLayers;    // 3 star layers
+
+/* ---- hash / noise (trig-free Hoskins style) ---- */
+float hash1(vec2 p) {
+  p = fract(p * vec2(123.34, 456.21));
+  p += dot(p, p + 45.32);
+  return fract(p.x * p.y);
+}
+vec2 hash2(vec2 p) {
+  float n = hash1(p);
+  return vec2(n, hash1(p + n + 7.77));
+}
+/* gradient noise, roughly (-1, 1) */
+float gnoise(vec2 p) {
+  vec2 i = floor(p), f = fract(p);
+  vec2 u = f * f * (3.0 - 2.0 * f);
+  float a = dot(hash2(i) * 2.0 - 1.0, f);
+  float b = dot(hash2(i + vec2(1.0, 0.0)) * 2.0 - 1.0, f - vec2(1.0, 0.0));
+  float c = dot(hash2(i + vec2(0.0, 1.0)) * 2.0 - 1.0, f - vec2(0.0, 1.0));
+  float d = dot(hash2(i + vec2(1.0, 1.0)) * 2.0 - 1.0, f - vec2(1.0, 1.0));
+  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 1.4;
+}
+/* 4-octave fbm, rotated per octave (4th is sub-pixel at half-res render,
+   so the saved fill rate costs nothing visible) */
+float fbm(vec2 p) {
+  float s = 0.0, a = 0.5;
+  mat2 m = mat2(1.62, 1.18, -1.18, 1.62);
+  for (int i = 0; i < uOctaves; i++) {
+    s += a * gnoise(p);
+    p = m * p;
+    a *= 0.52;
+  }
+  return s;
+}
+/* 3-octave fbm for large soft fields (void coverage, hue drift) */
+float fbm3(vec2 p) {
+  float s = 0.0, a = 0.5;
+  mat2 m = mat2(1.62, 1.18, -1.18, 1.62);
+  for (int i = 0; i < uOctaves - 1; i++) {
+    s += a * gnoise(p);
+    p = m * p;
+    a *= 0.52;
+  }
+  return s;
+}
+
+/* Each layer is a camera of its own: Space.draw moves its focus with the
+   page's pan (less for deeper layers: parallax) and zooms it about the same
+   point the page zooms about, so the sky zooms in where the mouse is. The
+   sky zooms less than the page (uZoom), since the page spans thousands of
+   screens. */
+vec2 layerUV(vec2 px, vec2 focus) {
+  return (px - focus) / (uRes.y * uZoom);
+}
+float starZoom() { return uStarZ; }
+vec2 starUV(vec2 px, vec2 focus) {
+  return (px - focus) / (uRes.y * starZoom());
+}
+
+/* grid point stars: color temperature, twinkle, optional diffraction spikes.
+   They are part of the page: size and spacing scale with the page zoom like
+   the bubbles do, so the home view's sky is magnified; a layer whose cells
+   are a few pixels at the home zoom stays faint, and all fade when the stars
+   shrink below a pixel. */
+vec3 starLayer(vec2 uv, float grid, float density, float gain, float twinkle, float spikes) {
+  float cellPx = uRes.y * starZoom() / grid;
+  float vis = smoothstep(3.0, 10.0, cellPx / uStarK) * smoothstep(0.15, 0.5, uStarK);
+  if (vis <= 0.0) return vec3(0.0);
+  vec2 g = uv * grid;
+  vec2 id = floor(g), f = fract(g);
+  vec3 acc = vec3(0.0);
+  for (int y = -uCells; y <= uCells; y++) {
+    for (int x = -uCells; x <= uCells; x++) {
+      vec2 cid = id + vec2(float(x), float(y));
+      vec2 r = hash2(cid);
+      if (r.x > density) continue;
+      vec2 sp = hash2(cid + 13.1);
+      vec2 off = (vec2(float(x), float(y)) + sp - f) * cellPx;   /* screen px */
+      float k = uStarK, d = length(off), dh = d / k;                 /* dh: px at the home zoom */
+      float b = pow(hash1(cid + 41.7), 5.0);   /* few bright, many dim */
+      float tw = 1.0 - twinkle * 0.25;
+      /* realistic spectral colors: mostly cool red/orange dwarfs, rarer
+         yellow to blue-white, very rare hot blue; luminous stars run hot */
+      float h1 = hash1(cid + 77.7);
+      vec3 tint;
+      if      (h1 < 0.34) tint = vec3(1.00, 0.56, 0.40);   /* M red dwarf */
+      else if (h1 < 0.58) tint = vec3(1.00, 0.74, 0.55);   /* K orange */
+      else if (h1 < 0.78) tint = vec3(1.00, 0.90, 0.74);   /* G yellow */
+      else if (h1 < 0.90) tint = vec3(1.00, 0.97, 0.89);   /* F yellow-white */
+      else if (h1 < 0.97) tint = vec3(0.85, 0.91, 1.00);   /* A/B blue-white */
+      else                tint = vec3(0.64, 0.77, 1.00);   /* O blue */
+      if (b > 0.40) tint = mix(tint, vec3(0.82, 0.89, 1.00), 0.60);
+      float s = gain * b * tw;
+      /* a crisp disc as big on the page as the star (never under 0.7 px on
+         screen: a smaller one is dimmed by its area instead, so it does not
+         shimmer as it crosses pixels), a 1 px soft edge, and a glow that scales
+         with the page */
+      float rs = (0.55 + 1.1 * b) * k, rr = max(rs, 0.7);
+      float u = min(1.0, d / rr);
+      float core = clamp(rr + 0.5 - d, 0.0, 1.0) * min(1.0, rs * rs / 0.49) * (1.0 - 0.6 * u * u);   /* brighter middle */
+      float g = d / (2.6 * rr);
+      vec3 c = tint * s * (1.4 * core + 0.30 * exp(-g * g) + 0.08 * exp(-dh * dh * 0.014));
+      if (spikes > 0.0 && b > 0.45) {
+        /* thin anti-aliased rays along the axes, fading with page distance */
+        vec2 ao = abs(off), aoh = ao / k;
+        float wx = max(0.5, 0.45 * k * exp(-aoh.x * 0.18)), wy = max(0.5, 0.45 * k * exp(-aoh.y * 0.18));   /* needles: thinner further out */
+        float sp1 = clamp(wx + 0.5 - ao.y, 0.0, 1.0) * exp(-aoh.x * 0.16)
+                  + clamp(wy + 0.5 - ao.x, 0.0, 1.0) * exp(-aoh.y * 0.16);
+        c += tint * s * sp1 * min(1.0, 0.4 * k / 0.5) * 0.45 * spikes;
+      }
+      /* the glow and spikes end inside the cells looked at, so no cell edge cuts them */
+      vec2 oc = abs(vec2(float(x), float(y)) + sp - f);
+      acc += c * (1.0 - smoothstep(0.5, 1.0, length(oc)));
+    }
+  }
+  return acc * vis;
+}
+
+void main() {
+  vec2 px = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y);   /* DOM orientation, y down */
+  float t = uTime;
+
+  vec3 col = vec3(0.0);                                      /* true black base */
+
+  /* galactic band: tilted soft haze with a brighter core */
+  vec2 buv = layerUV(px, uF0);
+  buv = mat2(0.90, 0.44, -0.44, 0.90) * buv;
+  float band = exp(-buv.y * buv.y * 26.0);
+  col += vec3(0.55, 0.60, 0.85) * band * 0.050 * uNebula;
+  float bulge = exp(-buv.x * buv.x * 1.4) * exp(-buv.y * buv.y * 70.0);
+  col += vec3(1.00, 0.78, 0.55) * bulge * 0.040 * uNebula;
+
+  /* primary stardust: domain-warped fbm with dark lanes, large empty
+     voids from a low-frequency coverage field, and region-varying
+     realistic color ΓÇö H-alpha crimson/magenta, O-III teal, reflection
+     blue (amber comes from the secondary layer) */
+  vec2 uv1 = layerUV(px, uF1) * 4.6;
+  vec2 q1 = vec2(fbm(uv1 + vec2(0.0, 3.1) + t * 0.010),
+                 fbm(uv1 + vec2(4.7, 1.2) - t * 0.008));
+  vec2 r1 = vec2(fbm(uv1 + 2.6 * q1 + vec2(1.7, 9.2) + t * 0.012),
+                 fbm(uv1 + 2.6 * q1 + vec2(8.3, 2.8) - t * 0.010));
+  float n1 = fbm(uv1 + 3.2 * r1);
+  float d1 = clamp(n1 * 0.5 + 0.5, 0.0, 1.0);
+  float lanes = smoothstep(-0.55, 0.45, r1.y);
+  float cov1 = smoothstep(0.40, 0.68, fbm3(uv1 * 0.30 + 3.7) * 0.5 + 0.5);   /* voids */
+  float dens1 = pow(d1, 4.4) * mix(0.22, 1.0, lanes) * cov1;
+  float hue1 = fbm3(uv1 * 0.40 + 9.1) * 0.5 + 0.5;
+  vec3 tint1 = mix(vec3(0.88, 0.20, 0.26), vec3(0.92, 0.30, 0.60), smoothstep(0.20, 0.46, hue1));
+  tint1 = mix(tint1, vec3(0.16, 0.70, 0.63), smoothstep(0.46, 0.70, hue1));
+  tint1 = mix(tint1, vec3(0.28, 0.44, 0.98), smoothstep(0.70, 0.92, hue1));
+  col += tint1 * dens1 * 0.55 * uNebula;
+
+  /* secondary stardust: reflection-blue with amber dust patches, also voided */
+  vec2 uv2 = layerUV(px, uF2) * 3.1 + 7.7;
+  vec2 q2 = vec2(fbm3(uv2 + t * 0.008), fbm3(uv2 + vec2(6.1, 2.4) - t * 0.006));
+  float n2 = fbm(uv2 + 2.4 * q2);
+  float cov2 = smoothstep(0.44, 0.70, fbm3(uv2 * 0.34 + 12.3) * 0.5 + 0.5);
+  float dens2 = pow(clamp(n2 * 0.5 + 0.5, 0.0, 1.0), 4.6) * cov2;
+  float hue2 = fbm3(uv2 * 0.50 + 21.0) * 0.5 + 0.5;
+  vec3 tint2 = mix(vec3(0.26, 0.42, 0.96), vec3(0.55, 0.62, 1.00), hue2);
+  tint2 = mix(tint2, vec3(0.88, 0.56, 0.28), smoothstep(0.62, 0.85, hue2) * 0.7);
+  col += tint2 * dens2 * 0.44 * uNebula;
+
+  /* star layers, far -> near (band field shares the band transform so
+     stars crowd along the galactic band; per-star color inside) */
+  float dust = 1.0 - 0.60 * (1.0 - lanes) * (0.35 + 0.65 * band) * cov1;
+  vec2 sbuv = mat2(0.90, 0.44, -0.44, 0.90) * starUV(px, uF3);
+  /* one loop, so the layer is compiled once: uv, (grid, density, gain, twinkle), spikes, weight */
+  vec2 suv[3] = vec2[3](sbuv, starUV(px, uF4), starUV(px, uF5));
+  vec4 sp[3] = vec4[3](vec4(46.0, 0.50, 0.60, 0.35), vec4(28.0, 0.35, 0.75, 0.55), vec4(13.0, 0.22, 0.95, 0.85));
+  float sk[3] = float[3](0.0, 0.0, 1.0);
+  float sw[3] = float[3]((0.35 + 1.30 * band) * dust, mix(1.0, dust, 0.6), 1.0);
+  for (int i = 0; i < (uStars > 0.0 ? uLayers : 0); i++) col += uStars * starLayer(suv[i], sp[i].x, sp[i].y, sp[i].z, sp[i].w, sk[i]) * sw[i];
+
+  /* contrast pass: deepen the void, punch the dust and stars ΓÇö pure
+     black stays pure black, mid tones separate from the background */
+  col = max((col - 0.014) * 1.26, 0.0);
+  col = 1.0 - exp(-col * 1.12);
+  vec2 sc = (px - uRes * 0.5) / uRes.y;
+  col *= 1.0 - 0.30 * smoothstep(0.45, 1.05, length(sc));
+
+  /* dither to prevent banding on OLED; keep untouched pixels pure black */
+  float lum = dot(col, vec3(0.30, 0.60, 0.10));
+  col += (hash1(px + fract(t) * 7.0) - 0.5) * 0.012 * smoothstep(0.0, 0.02, lum);
+
+  fragColor = vec4(col, 1.0);
+}
+`;
+
+  /* The renderer lives in a worker on an OffscreenCanvas: Gecko has no
+     KHR_parallel_shader_compile, so linking this shader blocks its thread for
+     seconds ΓÇö on the page that would freeze every Start page sharing the
+     privileged-about process. */
+  function rendererMain() {
+    let gl = null, U = {}, custom = null;
+    // profiling mode: build time, and per frame the GPU's time (a fence) and the worker's
+    let perf = null, fence = null, fenceAt = 0;
+    const timeGpu = () => {
+      if (!perf || fence) return;
+      fence = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);
+      fenceAt = performance.now();
+      gl.flush();
+      const poll = () => {
+        const state = gl.clientWaitSync(fence, 0, 0);
+        if (state === gl.TIMEOUT_EXPIRED) { setTimeout(poll, 2); return; }
+        gl.deleteSync(fence);
+        fence = null;
+        if (state !== gl.WAIT_FAILED) perf.gpu.push(performance.now() - fenceAt);
+      };
+      setTimeout(poll, 2);
+    };
+    onmessage = ({ data: m }) => {
+      if (m.canvas && m.profile) {
+        perf = { build: 0, gpu: [], work: [] };
