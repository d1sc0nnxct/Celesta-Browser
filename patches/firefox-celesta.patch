diff --git a/browser/content/celesta/celestaChromeExtensions.sys.mjs b/browser/content/celesta/celestaChromeExtensions.sys.mjs
new file mode 100644
index 0000000000..b0ca7b4e25
--- /dev/null
+++ b/browser/content/celesta/celestaChromeExtensions.sys.mjs
@@ -0,0 +1,299 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Extensions from the Chrome Web Store. Chrome packages them as .crx (a zip
+// behind a signature header) that Firefox cannot install, and they are not
+// signed for Firefox. Celesta downloads the package, unpacks it into the
+// profile's Celesta-extensions folder, adapts the manifest (a Gecko id; a
+// background service worker becomes a background script) and installs the
+// folder as an unpacked extension, again at every start, so add-on signing
+// stays required for everything else. Many Chrome extensions work this way;
+// some use Chrome-only APIs and do not.
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  AddonManager: "resource://gre/modules/AddonManager.sys.mjs",
+  FileUtils: "resource://gre/modules/FileUtils.sys.mjs",
+});
+
+const ID_SUFFIX = "@chromewebstore.Celesta";
+const CHROME_VERSION = "141.0.0.0";
+const MAX_BYTES = 200 * 1024 * 1024;
+
+/* the Web Store id in a store page's address, or null */
+export function storeId(url) {
+  const m = /^https:\/\/(?:chromewebstore\.google\.com\/detail\/(?:[^/?#]+\/)?|chrome\.google\.com\/webstore\/detail\/(?:[^/?#]+\/)?)([a-p]{32})(?:[/?#]|$)/.exec(url || "");
+  return m ? m[1] : null;
+}
+
+const folder = () => PathUtils.join(PathUtils.profileDir, "Celesta-extensions");
+
+/* the zip inside a .crx (versions 2 and 3) */
+function zipOf(bytes) {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  if (bytes.length < 16 || view.getUint32(0) != 0x43723234 /* "Cr24" */) {
+    // some downloads are a plain zip already
+    if (view.getUint32(0, true) == 0x04034b50) {
+      return bytes;
+    }
+    throw new Error("The download is not a Chrome extension package.");
+  }
+  const version = view.getUint32(4, true);
+  const start = version == 3 ? 12 + view.getUint32(8, true) : 16 + view.getUint32(8, true) + view.getUint32(12, true);
+  return bytes.subarray(start);
+}
+
+/* unpacks the zip file into dir (a path), leaving out Chrome's own signature data */
+function unzip(zipPath, dir) {
+  const reader = Cc["@mozilla.org/libjar/zip-reader;1"].createInstance(Ci.nsIZipReader);
+  reader.open(new lazy.FileUtils.File(zipPath));
+  try {
+    for (const entry of reader.findEntries(null)) {
+      if (entry.startsWith("_metadata/") || entry.includes("..") || entry.endsWith("/")) {
+        continue;
+      }
+      const target = new lazy.FileUtils.File(PathUtils.join(dir, ...entry.split("/")));
+      if (!target.parent.exists()) {
+        target.parent.create(Ci.nsIFile.DIRECTORY_TYPE, 0o755);
+      }
+      reader.extract(entry, target);
+    }
+  } finally {
+    reader.close();
+  }
+}
+
+/* Chrome's manifest, changed so Firefox loads it */
+function adapt(manifest, id) {
+  manifest.browser_specific_settings = { gecko: { id: id + ID_SUFFIX } };
+  if (manifest.background?.service_worker) {
+    const { service_worker, type } = manifest.background;
+    manifest.background = { scripts: [service_worker], ...(type ? { type } : {}) };
+  }
+  delete manifest.update_url;
+  delete manifest.key;
+  return manifest;
+}
+
+/* Downloads and unpacks a store extension. Returns { dir, name, permissions }
+   for the caller to show before install(dir). */
+export async function prepare(id) {
+  const url =
+    `https://clients2.google.com/service/update2/crx?response=redirect&prodversion=${CHROME_VERSION}` +
+    `&acceptformat=crx2,crx3&x=${encodeURIComponent(`id=${id}&installsource=ondemand&uc`)}`;
+  const response = await fetch(url);
+  if (!response.ok) {
+    throw new Error(`The Chrome Web Store did not send the extension (${response.status}).`);
+  }
+  const bytes = new Uint8Array(await response.arrayBuffer());
+  if (bytes.length > MAX_BYTES) {
+    throw new Error("The extension is too large.");
+  }
+  const zipPath = PathUtils.join(PathUtils.tempDir, `Celesta-${id}.zip`);
+  await IOUtils.write(zipPath, zipOf(bytes));
+  const dir = PathUtils.join(folder(), id);
+  await IOUtils.remove(dir, { recursive: true, ignoreAbsent: true });
+  await IOUtils.makeDirectory(dir);
+  try {
+    unzip(zipPath, dir);
+  } finally {
+    await IOUtils.remove(zipPath, { ignoreAbsent: true });
+  }
+  const manifestPath = PathUtils.join(dir, "manifest.json");
+  const manifest = adapt(await IOUtils.readJSON(manifestPath), id);
+  await IOUtils.writeJSON(manifestPath, manifest);
+  let name = manifest.name || id;
+  // a localized name: __MSG_appName__ from _locales
+  const msg = /^__MSG_(\w+)__$/.exec(name);
+  if (msg) {
+    const locale = manifest.default_locale || "en";
+    const messages = await IOUtils.readJSON(PathUtils.join(dir, "_locales", locale, "messages.json")).catch(() => ({}));
+    const key = Object.keys(messages).find(k => k.toLowerCase() == msg[1].toLowerCase());
+    name = messages[key]?.message || id;
+  }
+  const permissions = [...(manifest.permissions || []), ...(manifest.host_permissions || [])].filter(p => typeof p == "string");
+  return { dir, name, permissions };
+}
+
+export async function install(dir) {
+  return lazy.AddonManager.installTemporaryAddon(new lazy.FileUtils.File(dir));
+}
+
+const STORE_HOST = "chromewebstore.google.com";
+const CHROME_UA = `Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${CHROME_VERSION} Safari/537.36`;
+const CHROME_MAJOR = CHROME_VERSION.split(".")[0];
+const CHROME_BRANDS = [
+  { brand: "Google Chrome", version: CHROME_MAJOR },
+  { brand: "Chromium", version: CHROME_MAJOR },
+  { brand: "Not_A Brand", version: "24" },
+];
+
+let actingAsChrome = false;
+/* The store tells other browsers to switch to Chrome and turns off its Add to
+   Chrome button: requests to it get Chrome's user agent, and its pages
+   Chrome's navigator (CelestaChromeStoreChild). Nothing else does. */
+export function actAsChrome() {
+  if (actingAsChrome) {
+    return;
+  }
+  actingAsChrome = true;
+  Services.obs.addObserver(subject => {
+    const channel = subject.QueryInterface(Ci.nsIHttpChannel);
+    if (channel.URI.host == STORE_HOST) {
+      // a signed-in store follows the Google account's language, not the
+      // browser's; a page without its own hl= gets Celesta's language
+      const url = URL.parse(channel.URI.spec);
+      if (channel.loadInfo.externalContentPolicyType == Ci.nsIContentPolicy.TYPE_DOCUMENT && url && !url.searchParams.has("hl")) {
+        url.searchParams.set("hl", Services.locale.appLocaleAsBCP47);
+        channel.redirectTo(Services.io.newURI(url.href));
+        return;
+      }
+      channel.setRequestHeader("User-Agent", CHROME_UA, false);
+      channel.setRequestHeader("Sec-CH-UA", CHROME_BRANDS.map(b => `"${b.brand}";v="${b.version}"`).join(", "), false);
+      channel.setRequestHeader("Sec-CH-UA-Mobile", "?0", false);
+      channel.setRequestHeader("Sec-CH-UA-Platform", '"Windows"', false);
+    }
+  }, "http-on-modify-request");
+}
+
+const STORE_ANSWERS = {
+  isInIncognitoMode: false,
+  getBrowserLogin: { login: "" },
+  getStoreLogin: "",
+  getWebGLStatus: "webgl_allowed",
+  getReferrerChain: "",
+  getMV2DeprecationStatus: "inactive",
+  getFullChromeVersion: { version_number: CHROME_VERSION },
+  getIsLauncherEnabled: false,
+  isPendingCustodianApproval: false,
+  completeInstall: undefined,
+  shouldShowEnterprisePromotionBanner: false,
+  logEnterprisePromoShown: undefined,
+  onEnterprisePromoClick: undefined,
+};
+
+/* Store pages get the parts of Chrome's chrome.webstorePrivate and
+   chrome.management they use; Add to Chrome asks the parent, which runs Celesta's
+   own add flow. */
+export class CelestaChromeStoreChild extends JSWindowActorChild {
+  handleEvent() {
+    const win = this.contentWindow;
+    const reply = (answer, args) => {
+      const callback = [...args].findLast(a => typeof a == "function");
+      const out = Promise.resolve(answer).then(value => Cu.cloneInto(value, win));
+      if (callback) {
+        out.then(value => callback(value));
+        return undefined;
+      }
+      return new win.Promise(resolve => out.then(resolve));
+    };
+    const api = Cu.createObjectIn(win);
+    for (const [name, answer] of Object.entries(STORE_ANSWERS)) {
+      Cu.exportFunction((...args) => reply(answer, args), api, { defineAs: name });
+    }
+    const ask = (message, data) => this.sendQuery(message, data).catch(() => "unknown_error");
+    Cu.exportFunction((id, ...args) => reply(ask("CelestaChromeStore:Status", { id: String(id) }), args), api, { defineAs: "getExtensionStatus" });
+    Cu.exportFunction((details, ...args) => reply(ask("CelestaChromeStore:Add", { id: String(details?.id) }), args), api, {
+      defineAs: "beginInstallWithManifest3",
+    });
+    const management = Cu.createObjectIn(win);
+    Cu.exportFunction((...args) => reply(this.sendQuery("CelestaChromeStore:List").catch(() => []), args), management, { defineAs: "getAll" });
+    Cu.exportFunction((id, ...args) => reply(ask("CelestaChromeStore:Uninstall", { id: String(id) }), args), management, { defineAs: "uninstall" });
+    Cu.exportFunction((id, enabled, ...args) => reply(ask("CelestaChromeStore:SetEnabled", { id: String(id), enabled: !!enabled }), args), management, {
+      defineAs: "setEnabled",
+    });
+    for (const event of ["onInstalled", "onUninstalled"]) {
+      const listeners = Cu.createObjectIn(management, { defineAs: event });
+      for (const name of ["addListener", "removeListener"]) {
+        Cu.exportFunction(() => {}, listeners, { defineAs: name });
+      }
+    }
+    const chrome = Cu.waiveXrays(win).chrome ?? Cu.createObjectIn(win, { defineAs: "chrome" });
+    Cu.waiveXrays(chrome).webstorePrivate = api;
+    Cu.waiveXrays(chrome).management = management;
+    const brands = { brands: CHROME_BRANDS, mobile: false, platform: "Windows" };
+    const high = {
+      ...brands,
+      architecture: "x86",
+      bitness: "64",
+      platformVersion: "15.0.0",
+      uaFullVersion: CHROME_VERSION,
+      fullVersionList: CHROME_BRANDS.map(b => ({ ...b, version: b.brand == "Not_A Brand" ? "24.0.0.0" : CHROME_VERSION })),
+    };
+    const uaData = Cu.cloneInto(
+      { ...brands, getHighEntropyValues: () => new win.Promise(resolve => resolve(Cu.cloneInto(high, win))), toJSON: () => Cu.cloneInto(brands, win) },
+      win,
+      { cloneFunctions: true }
+    );
+    Object.defineProperty(Cu.waiveXrays(win.navigator), "userAgentData", { value: uaData, configurable: true });
+    const navigator = Cu.waiveXrays(win.navigator);
+    Object.defineProperty(navigator, "vendor", { value: "Google Inc.", configurable: true });
+    Object.defineProperty(navigator, "userAgent", { value: CHROME_UA, configurable: true });
+    Object.defineProperty(navigator, "appVersion", { value: CHROME_UA.slice("Mozilla/".length), configurable: true });
+  }
+}
+
+export class CelestaChromeStoreParent extends JSWindowActorParent {
+  async receiveMessage({ name, data }) {
+    if (name == "CelestaChromeStore:List") {
+      const addons = await lazy.AddonManager.getAddonsByTypes(["extension"]);
+      return addons
+        .filter(a => a.id.endsWith(ID_SUFFIX))
+        .map(a => ({
+          id: a.id.slice(0, -ID_SUFFIX.length),
+          name: a.name,
+          version: a.version,
+          enabled: a.isActive,
+          type: "extension",
+          installType: "normal",
+          mayDisable: true,
+          isApp: false,
+        }));
+    }
+    const id = /^[a-p]{32}$/.test(data?.id) ? data.id : null;
+    if (!id) {
+      return "invalid_id";
+    }
+    const addon = await lazy.AddonManager.getAddonByID(id + ID_SUFFIX);
+    const browser = this.browsingContext.top.embedderElement;
+    const win = this.browsingContext.topChromeWindow;
+    switch (name) {
+      case "CelestaChromeStore:Status":
+        return addon ? (addon.isActive ? "enabled" : "disabled") : "installable";
+      case "CelestaChromeStore:Add":
+        return (await win?.CelestaChromeStoreAdd?.(browser, id)) ? "" : "user_cancelled";
+      case "CelestaChromeStore:Uninstall":
+        if (addon && Services.prompt.confirm(win, "Celesta", `Remove ΓÇ£${addon.name}ΓÇ¥?`)) {
+          await addon.uninstall();
+        }
+        return undefined;
+      case "CelestaChromeStore:SetEnabled":
+        await (data.enabled ? addon?.enable() : addon?.disable());
+        return undefined;
+    }
+    return undefined;
+  }
+}
+
+let started = false;
+/* At startup: puts back every store extension still in the folder, and
+   deletes the folder of one the user removes in Add-ons. */
+export async function restoreAll() {
+  if (started) {
+    return;
+  }
+  started = true;
+  lazy.AddonManager.addAddonListener({
+    onUninstalled(addon) {
+      if (addon.id.endsWith(ID_SUFFIX) && !Services.startup.shuttingDown) {
+        IOUtils.remove(PathUtils.join(folder(), addon.id.slice(0, -ID_SUFFIX.length)), { recursive: true, ignoreAbsent: true });
+      }
+    },
+  });
+  for (const dir of await IOUtils.getChildren(folder()).catch(() => [])) {
+    if ((await IOUtils.stat(dir)).type == "directory") {
+      await install(dir).catch(e => console.error("Celesta: Chrome extension in " + dir, e));
+    }
+  }
+}
diff --git a/browser/content/celesta/celestaDiscord.sys.mjs b/browser/content/celesta/celestaDiscord.sys.mjs
new file mode 100644
index 0000000000..117381b29a
--- /dev/null
+++ b/browser/content/celesta/celestaDiscord.sys.mjs
@@ -0,0 +1,114 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Discord Rich Presence (Settings > Home > Discord): the site in the selected
+// tab of the last focused window shows as your Discord status, through the
+// Discord app's local pipe (discord-worker.js). Off by default. Private
+// windows, private and Tor tabs, and Tor windows never show; a page that is
+// not a website shows as "Browsing". Discord names the status after the
+// Discord application whose ID is set.
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  PrivateBrowsingUtils: "resource://gre/modules/PrivateBrowsingUtils.sys.mjs",
+  setTimeout: "resource://gre/modules/Timer.sys.mjs",
+});
+ChromeUtils.defineLazyGetter(lazy, "Private", () => ChromeUtils.importESModule("chrome://celesta/content/celestaPrivate.sys.mjs"));
+
+const BRANCH = "Celesta.discord.";
+const RETRY_MS = 30000;
+
+let worker = null;
+let busy = false;
+let queued = false;
+let sent = "";
+let site = "";
+let since = 0;
+let retry = 0;
+let error = "";
+
+const clientId = () => {
+  const id = Services.prefs.getStringPref(BRANCH + "clientId", "").trim();
+  return Services.prefs.getBoolPref(BRANCH + "enabled", false) && /^\d{15,22}$/.test(id) ? id : "";
+};
+
+function activity() {
+  const win = Services.wm.getMostRecentBrowserWindow();
+  const tab = win?.gBrowser?.selectedTab;
+  if (!tab || lazy.PrivateBrowsingUtils.isWindowPrivate(win) || lazy.Private.isTorWindow(win) || lazy.Private.isPrivateTab(tab)) {
+    return null;
+  }
+  const uri = tab.linkedBrowser.currentURI;
+  let host = "";
+  try {
+    host = /^https?$/.test(uri.scheme) ? uri.host.replace(/^www\./, "") : "";
+  } catch {}
+  if (host != site) {
+    site = host;
+    since = Date.now();
+  }
+  const showSite = Services.prefs.getBoolPref(BRANCH + "showSite", true);
+  return {
+    details: host && showSite ? `On ${host}` : "Browsing",
+    timestamps: { start: since },
+    ...(host && showSite ? { assets: { large_image: `https://www.google.com/s2/favicons?domain=${host}&sz=128`, large_text: host } } : {}),
+  };
+}
+
+function send() {
+  if (busy) {
+    queued = true;
+    return;
+  }
+  const id = clientId();
+  const next = id ? activity() : null;
+  const key = id + JSON.stringify(next);
+  if (key == sent || (!id && !worker)) {
+    return;
+  }
+  worker ??= new ChromeWorker("chrome://celesta/content/discord-worker.js");
+  worker.onmessage = ({ data }) => {
+    busy = false;
+    if (data.error && data.error != error) {
+      console.warn("Celesta Discord status:", data.error);
+    }
+    error = data.error || "";
+    sent = data.error ? "" : key;
+    if (data.error && clientId()) {
+      // Discord was closed, or not started yet: try again later
+      retry ||= lazy.setTimeout(() => {
+        retry = 0;
+        send();
+      }, RETRY_MS);
+    }
+    if (queued) {
+      queued = false;
+      send();
+    }
+  };
+  busy = true;
+  worker.postMessage({ clientId: id, activity: next });
+}
+
+const update = () => lazy.setTimeout(send, 0);
+let started = false;
+/* each browser window calls this; the status follows tab switches, page
+   loads and window focus */
+export function watch(win) {
+  win.gBrowser.tabContainer.addEventListener("TabSelect", update);
+  win.addEventListener("activate", update);
+  win.gBrowser.addTabsProgressListener({
+    onLocationChange(browser, webProgress) {
+      if (webProgress.isTopLevel && browser == win.gBrowser.selectedBrowser) {
+        update();
+      }
+    },
+  });
+  win.addEventListener("unload", update, { once: true });
+  if (!started) {
+    started = true;
+    Services.prefs.addObserver(BRANCH, update);
+  }
+  update();
+}
diff --git a/browser/content/celesta/celestaHomeChild.sys.mjs b/browser/content/celesta/celestaHomeChild.sys.mjs
new file mode 100644
index 0000000000..9420513191
--- /dev/null
+++ b/browser/content/celesta/celestaHomeChild.sys.mjs
@@ -0,0 +1,387 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Hands the start page its settings (Settings > Home) as data-Celesta-*
+// attributes on its root element, before the page's own scripts run: the
+// privileged start page cannot read prefs itself.
+const PREFS = {
+  CelestaSkyStars: ["Celesta.home.stars", true],
+  CelestaUncategorized: ["Celesta.home.showUncategorized", true],
+  CelestaLinks: ["Celesta.home.showLinks", true],
+  CelestaLogos: ["Celesta.home.logos", "hover"],
+  CelestaWarn: ["Celesta.home.warnFlagged", true],
+  CelestaBg: ["Celesta.home.background", "nebula"],
+  CelestaMaxFps: ["Celesta.home.maxFps", 60],
+  CelestaIdleThrottle: ["Celesta.home.idleThrottle", true],
+  CelestaShaderFps: ["Celesta.theme.shaderFps", 30],
+  CelestaProfiling: ["Celesta.profiling", false],
+  CelestaBgColor: ["Celesta.home.background.color", "#05050a"],
+};
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  applyTheme: "chrome://celesta/content/celestaTheme.sys.mjs",
+  snapshotFresh: "chrome://celesta/content/celestaTheme.sys.mjs",
+});
+
+// longest dive (graph.js stepWarp); the page reports the end with "Celesta-warped"
+const WARP_MAX_MS = 1800;
+
+// the start pages in this process: one that moves tells the others ("Celesta-busy")
+const pages = new Set();
+
+// the packed site catalogue, read once per process and unpacked once per
+// process here (sharedPack), so every start page in this process views the
+// same ~107 MB rows/text instead of each cloning it. A promise resolving
+// to the bytes, or to null when the read failed and only the parent
+// hand-back is left.
+let datasetBin = null;
+// the shipped layout's xy/links bytes (sites-layout.bin), same per-process cache
+let layoutBin = null;
+// unpacked, shared across tabs in this process: PACK-like views over the
+// single fetch (system realm, so each tab's code only reads them through
+// the waived-X-ray global instead of creating new views over a foreign
+// ArrayBuffer, which content code rejects)
+let sharedPack = null;
+let sharedLayout = null;
+
+// sites.bin and sites-layout.bin are read-only after unpack. Unpacking
+// once in this (system) realm gives every tab the same views with no copy.
+function unpackDataset(bytes) {
+  const buf = bytes.buffer;
+  const dv = new DataView(buf);
+  const n = dv.getUint32(4, true), ns = dv.getUint32(8, true), blen = dv.getUint32(12, true);
+  const offs = new Uint32Array(buf, 16, ns + 1);
+  const textOff = 16 + (ns + 1) * 4;
+  const rowsOff = (textOff + blen + 3) & ~3;
+  const text = new Uint8Array(buf, textOff, blen);
+  const rows = new Uint32Array(buf, rowsOff, n * 8);
+  const dec = new TextDecoder();
+  const CACHE_MAX = 50000;
+  const cache = new Map();
+  const num = (v) => (v === 0xffffffff ? 0 : v);
+  return {
+    rows,
+    num,
+    cache,
+    n,
+    str(i) {
+      if (i === 0xffffffff) {
+        return undefined;
+      }
+      let v = cache.get(i);
+      if (v === undefined) {
+        v = dec.decode(text.subarray(offs[i], offs[i + 1]));
+        if (cache.size >= CACHE_MAX) cache.clear();
+        cache.set(i, v);
+      }
+      return v;
+    },
+  };
+}
+function unpackLayout(bytes) {
+  const buf = bytes.buffer;
+  const head = new DataView(buf);
+  const n = head.getUint32(8, true), linkN = head.getUint32(16, true);
+  return {
+    magic: head.getUint32(0, false),
+    keyHash: head.getInt32(4, true),
+    n,
+    linkN,
+    xy: new Int32Array(buf, 20, 2 * n),
+    links: new Int32Array(buf, 20 + 8 * n, 2 * linkN),
+  };
+}
+
+/* A window shows one live start page over its tabs (chrome.js
+   setUpSharedStart, loaded as about:home#Celesta-live); a tab on the start page
+   holds only a stand-in: an empty page whose history entry keeps that tab's
+   view of the map. Private windows (Tor windows too), private and Tor tabs
+   (containers) and other containers keep a whole start page of their own. */
+function pageMode(actor) {
+  const win = actor.contentWindow;
+  if (win.location.hash == "#Celesta-live") {
+    return "live";
+  }
+  const { userContextId, privateBrowsingId } = actor.browsingContext.originAttributes;
+  const shared =
+    Services.prefs.getBoolPref("Celesta.home.shared", true) &&
+    !userContextId &&
+    !privateBrowsingId &&
+    /^about:(home|newtab)\b/.test(win.location.href);
+  return shared ? "standin" : "full";
+}
+const stateOf = win => Cu.waiveXrays(win.history).state ?? null;
+
+export class CelestaHomeChild extends JSWindowActorChild {
+  // the address bar asks the page for its dive before loading a site in this
+  // tab; resolves once the page has gone black
+  async receiveMessage(msg) {
+    if (msg.name == "CelestaHome:SetState") {
+      this.contentWindow.history.replaceState(Cu.cloneInto(msg.data.state, this.contentWindow), "");
+      return true;
+    }
+    if (msg.name == "CelestaHome:GetState") {
+      const win = this.contentWindow;
+      win.dispatchEvent(new win.Event("Celesta-save"));
+      return { mode: this.mode, state: stateOf(win) };
+    }
+    if (msg.name == "CelestaHome:Show") {
+      const win = this.contentWindow;
+      win.history.replaceState(Cu.cloneInto(msg.data.state, win), "");
+      win.dispatchEvent(new win.Event("Celesta-show"));
+      return true;
+    }
+    if (msg.name == "CelestaHome:Filter") {
+      const win = this.contentWindow;
+      win?.dispatchEvent(new win.CustomEvent("Celesta-filter", { detail: Cu.cloneInto({ tags: msg.data.tags }, win) }));
+      return true;
+    }
+    if (msg.name != "CelestaHome:Warp") {
+      return false;
+    }
+    const win = this.contentWindow;
+    const done = new Promise(resolve => {
+      win.addEventListener("Celesta-warped", resolve, { once: true });
+      win.setTimeout(resolve, WARP_MAX_MS);
+    });
+    win.dispatchEvent(new win.CustomEvent("Celesta-warp", { detail: Cu.cloneInto({ url: msg.data.url }, win) }));
+    await done;
+    // the live page's view after the dive, for the tab it dived from
+    return this.mode == "live" ? stateOf(win) : true;
+  }
+
+  didDestroy() {
+    this.stopWatching?.();
+    pages.delete(this.page);
+  }
+
+  readPrefs(root) {
+    for (const [key, [pref, fallback]] of Object.entries(PREFS)) {
+      const value =
+        typeof fallback == "boolean"
+          ? Services.prefs.getBoolPref(pref, fallback)
+          : typeof fallback == "number"
+            ? Services.prefs.getIntPref(pref, fallback)
+            : Services.prefs.getStringPref(pref, fallback);
+      root.dataset[key] = String(value);
+    }
+  }
+
+  handleEvent(e) {
+    // boot.js asks for the merged site catalogue; the parent reads it (chrome
+    // content cannot fetch chrome:// bytes reliably) and boot waits for the reply
+    if (e?.type == "Celesta-dataset") {
+      return this.datasetRequest();
+    }
+    const root = this.document.documentElement;
+    if (!root) {
+      return;
+    }
+    const win = this.contentWindow;
+    this.mode = root.dataset.CelestaMode = pageMode(this);
+    if (this.mode == "standin") {
+      // shown (and on Back) with the view it keeps; bfcache restores fire pageshow too
+      win.addEventListener("pageshow", () => this.sendAsyncMessage("CelestaHome:StandIn", { state: stateOf(win) }));
+      return;
+    }
+    // the start page asks whether any tab is playing sound (hover cues mute)
+    win.addEventListener("Celesta-media-poll", () => {
+      this.sendQuery("CelestaHome:MediaPlaying").then(
+        playing => { try { Services.prefs.setBoolPref("celesta.debug.media", !!playing); } catch {} if (!win.closed) win.dispatchEvent(new win.CustomEvent("Celesta-media", { detail: Cu.cloneInto({ playing: !!playing }, win) })); },
+        () => {}
+      );
+    });
+    if (this.mode == "live") {
+      win.addEventListener("Celesta-open", e => this.sendAsyncMessage("CelestaHome:Open", { url: String(e.detail?.url || ""), state: stateOf(win) }));
+      win.addEventListener("Celesta-state", () => this.sendAsyncMessage("CelestaHome:State", { state: stateOf(win) }));
+      // a message sent while the document element is inserted does not arrive
+      win.addEventListener("DOMContentLoaded", () => this.sendAsyncMessage("CelestaHome:Live"), { once: true });
+    }
+    this.readPrefs(root);
+    // the merged catalogue for boot.js: the page dispatches "Celesta-dataset"
+    // (its own fetch of chrome:// bytes is unreliable); like the media poll,
+    // the actor listens for the event directly on the window
+    win.addEventListener("Celesta-dataset", () => this.datasetRequest());
+    // boot.js/actors report their dataset stages into the profiler's log
+    win.addEventListener("Celesta-diag", e => this.sendAsyncMessage("CelestaHome:Diag", String(e.detail ?? "")));
+    // a background chosen in Settings reaches an open start page at once
+    const onChange = (subject, topic, pref) => {
+      // the sky snapshot pref changes when this page saves one
+      if (pref != "Celesta.home.background.snapshot" && !win.closed && win.document.documentElement == root) {
+        this.readPrefs(root);
+        this.loadBackground();
+      }
+    };
+    const onFps = () => !win.closed && win.document.documentElement == root && this.readPrefs(root);
+    const onProfiling = () => {
+      if (!win.closed && win.document.documentElement == root) {
+        this.readPrefs(root);
+        win.dispatchEvent(new win.Event("Celesta-profiling"));
+      }
+    };
+    Services.prefs.addObserver("Celesta.home.background", onChange);
+    Services.prefs.addObserver("Celesta.home.stars", onChange);
+    Services.prefs.addObserver("Celesta.theme.shaderFps", onFps);
+    Services.prefs.addObserver("Celesta.home.maxFps", onFps);
+    Services.prefs.addObserver("Celesta.home.idleThrottle", onFps);
+    Services.prefs.addObserver("Celesta.profiling", onProfiling);
+    // removed in didDestroy, not on unload: an unload listener keeps the page out of the back/forward cache
+    this.stopWatching = () => {
+      Services.prefs.removeObserver("Celesta.home.background", onChange);
+      Services.prefs.removeObserver("Celesta.home.stars", onChange);
+      Services.prefs.removeObserver("Celesta.theme.shaderFps", onFps);
+      Services.prefs.removeObserver("Celesta.home.maxFps", onFps);
+      Services.prefs.removeObserver("Celesta.home.idleThrottle", onFps);
+      Services.prefs.removeObserver("Celesta.profiling", onProfiling);
+    };
+    // the start page cannot load local images: image themes fall back to color
+    lazy.applyTheme(root, { images: false });
+    if (["media", "folder", "shader"].includes(root.dataset.CelestaBg)) {
+      this.loadBackground();
+    }
+    root.dataset.CelestaSnapFresh = String(lazy.snapshotFresh());
+    if (lazy.snapshotFresh()) {
+      this.showSnapshot();
+    }
+    this.contentWindow.addEventListener("Celesta-snapshot", e => this.saveSnapshot(e.detail));
+    this.page = win;
+    pages.add(win);
+    win.addEventListener("Celesta-busy", () => {
+      for (const other of pages) {
+        if (other != win && !other.closed) {
+          other.dispatchEvent(new other.Event("Celesta-others-busy"));
+        }
+      }
+    });
+    this.contentWindow.addEventListener("Celesta-connect", e => this.sendAsyncMessage("CelestaHome:Connect", { url: String(e.detail?.url || "") }));
+    this.contentWindow.addEventListener("Celesta-perf", e => this.sendAsyncMessage("CelestaHome:Perf", Cu.cloneInto(e.detail, {})));
+  }
+
+  // the merged catalogue for boot.js (globalThis.CelestaBin): read it here
+  // in the same process as the page. The page's own fetch() of chrome://
+  // bytes is blocked, but this module is chrome-privileged, so it may fetch:
+  // handing the bytes back from the parent instead would clone ~100 MB over
+  // IPC, seconds late at startup. Once per process, shared by every start page.
+  async datasetRequest() {
+    const win = this.contentWindow;
+    const mark = (v) => { try { win.performance.mark("celesta-child-" + v); } catch {} };
+    const say = (v) => { try { win.dispatchEvent(new win.CustomEvent("Celesta-diag", { detail: "child " + String(v).slice(0, 160) })); } catch {} };
+    mark("ask");
+    try {
+      datasetBin ??= (async () => {
+        try {
+          const r = await fetch("chrome://celesta/content/sites.bin");
+          if (!r.ok) {
+            throw new Error("status " + r.status);
+          }
+          const b = await r.arrayBuffer();
+          say("ok " + b.byteLength);
+          return new Uint8Array(b);
+        } catch (e1) {
+          say("read fail " + (e1 && (e1.message || e1.name)));
+          return null;   // fall back to the parent hand-back below
+        }
+      })();
+      layoutBin ??= (async () => {
+        try {
+          const r = await fetch("chrome://celesta/content/sites-layout.bin");
+          if (!r.ok) {
+            throw new Error("status " + r.status);
+          }
+          const b = await r.arrayBuffer();
+          return new Uint8Array(b);
+        } catch (e1) {
+          // only the cached or recomputed layout is left; say so, quietly
+          say("layout fail " + (e1 && (e1.message || e1.name)));
+          return null;
+        }
+      })();
+      const [bytes, lay] = await Promise.all([
+        datasetBin.then((b) => b || this.sendQuery("CelestaHome:Dataset").catch(() => null)),
+        layoutBin,
+      ]);
+      mark(bytes?.length ? "got" : "no");
+      if (bytes?.length && win && !win.closed) {
+        const copy = Cu.cloneInto(bytes, win);
+        // through X-ray the property lands on the wrapper's view, not the
+        // page's own globals: waive it or boot.js cannot see CelestaBin
+        Cu.waiveXrays(win).CelestaBin = copy.buffer;
+        mark("set");
+        say("bin " + bytes.length);
+      }
+      if (lay?.length && win && !win.closed) {
+        const copy = Cu.cloneInto(lay, win);
+        Cu.waiveXrays(win).CelestaLayoutBin = copy.buffer;
+        say("layout " + lay.length);
+      }
+      // One window copy is now the owner: drop the child-process copies so
+      // a second window/tab re-fetches instead of holding a duplicate
+      // ~118 MB for the process lifetime.
+      if (bytes?.length) {
+        datasetBin = null;
+        layoutBin = null;
+        sharedPack = null;
+        sharedLayout = null;
+      }
+    } catch (e) {
+      say("fail " + (e && (e.message || e.name)));
+    }
+    if (win && !win.closed) {
+      mark("ready");
+      win.dispatchEvent(new win.Event("Celesta-dataset-ready"));
+      // a load storm of this size leaves plenty of garbage behind; collect it
+      // once the page has settled (a precise GC pauses in small slices)
+      setTimeout(() => {
+        if (win.closed || datasetBin == null) return;
+        try {
+          Cu.schedulePreciseGC(() => say("gc settled"));
+        } catch (e2) {
+          say("gc fail " + (e2 && (e2.message || e2.name)));
+        }
+      }, 90000);
+    }
+  }
+
+  // the sky's last picture shows at once; the live sky draws over it once it starts
+  async showSnapshot() {
+    const bytes = await this.sendQuery("CelestaHome:GetSnapshot").catch(() => null);
+    const win = this.contentWindow;
+    if (bytes && win) {
+      const url = win.URL.createObjectURL(new win.Blob([Cu.cloneInto(bytes, win)], { type: "image/jpeg" }));
+      win.document.documentElement.style.setProperty("--Celesta-snap", `url("${url}")`);
+    }
+  }
+
+  async saveSnapshot(blob) {
+    if (blob?.size && blob.size < 8 * 1024 * 1024) {
+      this.sendAsyncMessage("CelestaHome:Snapshot", new Uint8Array(await blob.arrayBuffer()));
+    }
+  }
+
+  // the parent reads the picture or video; the page gets it as a blob: URL
+  // (data-Celesta-bg-url) and an "Celesta-background" event
+  async loadBackground() {
+    const media = ["media", "folder", "shader"].includes(this.document?.documentElement.dataset.CelestaBg)
+      ? await this.sendQuery("CelestaHome:Background").catch(() => null)
+      : null;
+    const win = this.contentWindow;
+    if (!win) {
+      return;
+    }
+    if (!media) {
+      win.dispatchEvent(new win.Event("Celesta-background"));
+      return;
+    }
+    const root = win.document.documentElement;
+    if (media.shader) {
+      root.dataset.CelestaShader = media.shader;
+    } else {
+      const blob = new win.Blob([Cu.cloneInto(media.bytes, win)], { type: media.type });
+      root.dataset.CelestaBgUrl = win.URL.createObjectURL(blob);
+      root.dataset.CelestaBgType = media.type;
+    }
+    win.dispatchEvent(new win.Event("Celesta-background"));
+  }
+}
diff --git a/browser/content/celesta/celestaHomeParent.sys.mjs b/browser/content/celesta/celestaHomeParent.sys.mjs
new file mode 100644
index 0000000000..26de9746d2
--- /dev/null
+++ b/browser/content/celesta/celestaHomeParent.sys.mjs
@@ -0,0 +1,170 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// chrome.js sends CelestaHome:Warp through this; see CelestaHomeChild. It also
+// reads the start page's background picture or video (Settings > Home): the
+// start page itself cannot read local files.
+const MEDIA_TYPES = {
+  jpg: "image/jpeg",
+  jpeg: "image/jpeg",
+  png: "image/png",
+  gif: "image/gif",
+  webp: "image/webp",
+  avif: "image/avif",
+  mp4: "video/mp4",
+  m4v: "video/mp4",
+  webm: "video/webm",
+  ogv: "video/ogg",
+};
+const MAX_BYTES = 300 * 1024 * 1024;
+const MAX_SHADER_BYTES = 256 * 1024;
+const mediaType = path => MEDIA_TYPES[path.split(".").pop()?.toLowerCase()];
+const MAX_SNAPSHOT_BYTES = 8 * 1024 * 1024;
+
+const lazy = {};
+ChromeUtils.defineLazyGetter(lazy, "CelestaTheme", () => ChromeUtils.importESModule("chrome://celesta/content/celestaTheme.sys.mjs"));
+ChromeUtils.defineLazyGetter(lazy, "Profiler", () => ChromeUtils.importESModule("chrome://celesta/content/celestaProfiler.sys.mjs"));
+ChromeUtils.defineLazyGetter(lazy, "Private",() => ChromeUtils.importESModule("chrome://celesta/content/celestaPrivate.sys.mjs"));
+
+// the sky snapshot's bytes, kept so new start pages do not read the disk
+let snapshot = null;
+
+export class CelestaHomeParent extends JSWindowActorParent {
+  /* the merged site catalogue for the start page (boot.js): read the packaged
+     bytes here in the parent, whose fetch of chrome:// content is reliable */
+  async dataset() {
+    const dbg = (v) => { try { Services.prefs.setStringPref("celesta.debug.dataset", v); } catch {} };
+    try {
+      const r = await fetch("chrome://celesta/content/sites.bin", { credentials: "omit" });
+      if (!r.ok) {
+        dbg("status " + r.status);
+        return null;
+      }
+      const buf = await r.arrayBuffer();
+      dbg("ok " + buf.byteLength);
+      return new Uint8Array(buf);
+    } catch (e) {
+      console.error("Celesta dataset:", e);
+      dbg("fail " + (e && (e.message || e.name)));
+      return null;
+    }
+  }
+
+  /* opens a connection to the site the page is about to open, as that site
+     (its own partition, this tab's container). Never for a Tor tab or a Tor
+     window: the connection would not go through Tor. */
+  connect(url) {
+    try {
+      const uri = Services.io.newURI(url);
+      const bc = this.browsingContext;
+      const win = bc.topChromeWindow;
+      const tab = win?.gBrowser?.getTabForBrowser(bc.top.embedderElement);
+      if (!/^https?$/.test(uri.scheme) || lazy.Private.isTorWindow(win) || (tab && lazy.Private.isTorTab(tab))) {
+        return;
+      }
+      const principal = Services.scriptSecurityManager.createContentPrincipal(uri, { userContextId: bc.originAttributes.userContextId, privateBrowsingId: bc.originAttributes.privateBrowsingId });
+      // with a proxy filter registered (Tor) Gecko refuses a connect without the tab's callbacks
+      const loadContext = bc.top.embedderElement?.loadContext;
+      if (!loadContext) {
+        return;
+      }
+      const callbacks = {
+        QueryInterface: ChromeUtils.generateQI(["nsIInterfaceRequestor"]),
+        getInterface(iid) {
+          if (iid.equals(Ci.nsILoadContext)) {
+            return loadContext;
+          }
+          throw Components.Exception("", Cr.NS_ERROR_NO_INTERFACE);
+        },
+      };
+      Services.io.QueryInterface(Ci.nsISpeculativeConnect).speculativeConnect(uri, principal, callbacks, false);
+    } catch (e) {
+      console.error("Celesta: connecting ahead failed", e);
+    }
+  }
+
+  /* any tab in any browser window currently playing sound (media, a call,
+     a video); the start page mutes its hover cues while this is true */
+  anyAudioPlaying() {
+    try {
+      for (const win of Services.wm.getEnumerator("navigator:browser")) {
+        const tabs = win.gBrowser?.tabs;
+        if (!tabs) continue;
+        for (const tab of tabs) {
+          if (tab.hasAttribute("soundplaying")) return true;
+        }
+      }
+    } catch {}
+    return false;
+  }
+  async receiveMessage(msg) {
+    // the window's shared start page and its tabs' stand-ins (chrome.js setUpSharedStart)
+    if (["CelestaHome:StandIn", "CelestaHome:Live", "CelestaHome:Open", "CelestaHome:State"].includes(msg.name)) {
+      this.browsingContext.topChromeWindow?.CelestaStart?.receive(msg.name, this.browsingContext.top.embedderElement, msg.data);
+      return null;
+    }
+    if (msg.name == "CelestaHome:Diag") {
+      lazy.Profiler.CelestaProfiler.diag(`start page bc${this.browsingContext?.id ?? "?"}: ${String(msg.data).slice(0, 200)}`);
+      return null;
+    }
+    if (msg.name == "CelestaHome:MediaPlaying") {
+      return this.anyAudioPlaying();
+    }
+    if (msg.name == "CelestaHome:Dataset") {
+      return this.dataset();
+    }
+    if (msg.name == "CelestaHome:Connect") {
+      this.connect(msg.data?.url);
+      return null;
+    }
+    if (msg.name == "CelestaHome:Perf") {
+      lazy.Profiler.CelestaProfiler.page(msg.data, this.browsingContext.id);
+      return null;
+    }
+    if (msg.name == "CelestaHome:Snapshot") {
+      const bytes = msg.data;
+      // a JPEG from the start page's own sky
+      if (bytes instanceof Uint8Array && bytes.length < MAX_SNAPSHOT_BYTES && bytes[0] == 0xff && bytes[1] == 0xd8) {
+        snapshot = bytes;
+        await IOUtils.write(lazy.CelestaTheme.snapshotPath(), bytes);
+        lazy.CelestaTheme.snapshotTaken();
+        lazy.CelestaTheme.shareSnapshot(bytes);
+      }
+      return null;
+    }
+    if (msg.name == "CelestaHome:GetSnapshot") {
+      snapshot ??= await IOUtils.read(lazy.CelestaTheme.snapshotPath()).catch(() => null);
+      return snapshot;
+    }
+    if (msg.name != "CelestaHome:Background") {
+      return null;
+    }
+    try {
+      let path = "";
+      const kind = Services.prefs.getStringPref("Celesta.home.background", "nebula");
+      if (kind == "shader") {
+        const file = Services.prefs.getStringPref("Celesta.home.background.shaderFile", "");
+        if (!file || (await IOUtils.stat(file)).size > MAX_SHADER_BYTES) {
+          return null;
+        }
+        return { shader: await IOUtils.readUTF8(file) };
+      }
+      if (kind == "media") {
+        path = Services.prefs.getStringPref("Celesta.home.background.file", "");
+      } else if (kind == "folder") {
+        // a different file from the folder for each start page
+        const dir = Services.prefs.getStringPref("Celesta.home.background.folder", "");
+        const files = dir ? (await IOUtils.getChildren(dir)).filter(mediaType) : [];
+        path = files[Math.floor(Math.random() * files.length)] || "";
+      }
+      if (!path || !mediaType(path) || (await IOUtils.stat(path)).size > MAX_BYTES) {
+        return null;
+      }
+      return { bytes: await IOUtils.read(path), type: mediaType(path) };
+    } catch (e) {
+      console.error("Celesta background:", e);
+      return null;
+    }
+  }
+}
diff --git a/browser/content/celesta/celestaNotFoundChild.sys.mjs b/browser/content/celesta/celestaNotFoundChild.sys.mjs
new file mode 100644
index 0000000000..8157a93c5d
--- /dev/null
+++ b/browser/content/celesta/celestaNotFoundChild.sys.mjs
@@ -0,0 +1,131 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Celesta's "site not found" screen: replaces Firefox's error page for errors
+// that mean the site could not be reached. Certificate, safe-browsing and
+// other errors keep Firefox's page, whose controls matter for security.
+const HTML_NS = "http://www.w3.org/1999/xhtml";
+const REASONS = {
+  dnsNotFound: "There is no site at this address, or your connection is down.",
+  connectionFailure: "The site refused to connect.",
+  netTimeout: "The site took too long to answer.",
+  netReset: "The connection was interrupted.",
+  netOffline: "You are offline.",
+  netInterrupt: "The connection was interrupted.",
+};
+
+// Celesta's site database, loaded once per process, for "did you mean"
+let knownDomains = null;
+function domains() {
+  if (!knownDomains) {
+    const sandbox = Cu.Sandbox(Services.scriptSecurityManager.getSystemPrincipal(), { wantGlobalProperties: [] });
+    Services.scriptloader.loadSubScript("chrome://celesta/content/sites-radar.js", sandbox);
+    Services.scriptloader.loadSubScript("chrome://celesta/content/sites.js", sandbox);
+    const sites = Cu.evalInSandbox("SITES.map((s) => s.domain)", sandbox);
+    knownDomains = [...new Set(sites)];
+  }
+  return knownDomains;
+}
+
+function editDistance(a, b, max) {
+  if (Math.abs(a.length - b.length) > max) {
+    return max + 1;
+  }
+  let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 1; i <= a.length; i++) {
+    const cur = [i];
+    let best = i;
+    for (let j = 1; j <= b.length; j++) {
+      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] == b[j - 1] ? 0 : 1));
+      best = Math.min(best, cur[j]);
+    }
+    if (best > max) {
+      return max + 1;
+    }
+    prev = cur;
+  }
+  return prev[b.length];
+}
+
+// "en.wikipedja.invalid" -> "wikipedja": typos are in the name, not the ending
+const nameOf = host => host.replace(/^www\./, "").split(".").slice(-2, -1)[0] || host;
+
+function didYouMean(host) {
+  const target = nameOf(host);
+  return domains()
+    .map(d => [d, editDistance(target, nameOf(d), 2)])
+    .filter(([d, dist]) => dist <= 2 && d != host && target.length >= 4)
+    .sort((a, b) => a[1] - b[1])
+    .slice(0, 3)
+    .map(([d]) => d);
+}
+
+export class CelestaNotFoundChild extends JSWindowActorChild {
+  handleEvent() {
+    const doc = this.document, win = this.contentWindow;
+    const params = new URLSearchParams(doc.documentURI.split("?")[1] || "");
+    const reason = REASONS[params.get("e")];
+    if (!reason || !doc.body) {
+      return;
+    }
+    let url, host;
+    try {
+      url = new URL(params.get("u"));
+      host = url.hostname;
+    } catch {
+      return;
+    }
+    const make = (tag, className, text) => {
+      const node = doc.createElementNS(HTML_NS, tag);
+      if (className) {
+        node.className = className;
+      }
+      if (text) {
+        node.textContent = text;
+      }
+      return node;
+    };
+    const { applyTheme } = ChromeUtils.importESModule("chrome://celesta/content/celestaTheme.sys.mjs");
+    applyTheme(doc.documentElement, { images: false });
+    const link = make("link");
+    link.rel = "stylesheet";
+    link.href = "chrome://celesta/content/notfound.css";
+    (doc.head ?? doc.documentElement).append(link);
+
+    const card = make("main", "Celesta-nf");
+    card.append(make("div", "Celesta-nf-orb"), make("h1", "", "Lost in space"));
+    const lead = make("p", "Celesta-nf-lead");
+    lead.append("Celesta couldn't reach ", make("b", "", host), ".");
+    card.append(lead, make("p", "Celesta-nf-reason", reason));
+
+    const actions = make("div", "Celesta-nf-actions");
+    const button = (label, primary, action) => {
+      const b = make("button", primary ? "primary" : "", label);
+      b.addEventListener("click", action);
+      actions.append(b);
+    };
+    button("Try again", true, () => win.location.reload());
+    button("Search the web for it", false, () => {
+      win.location.href = "https://duckduckgo.com/?q=" + encodeURIComponent(host);
+    });
+    button("Go to start page", false, () => {
+      win.location.href = "about:home";
+    });
+    card.append(actions);
+
+    const guesses = didYouMean(host);
+    if (guesses.length) {
+      const list = make("div", "Celesta-nf-guesses");
+      list.append(make("span", "", "Did you mean"));
+      for (const guess of guesses) {
+        const a = make("a", "", guess);
+        a.href = url.protocol + "//" + guess + url.pathname + url.search;
+        list.append(a);
+      }
+      card.append(list);
+    }
+    doc.body.replaceChildren(card);
+    doc.title = "Site not found";
+  }
+}
diff --git a/browser/content/celesta/celestaPrivate.sys.mjs b/browser/content/celesta/celestaPrivate.sys.mjs
new file mode 100644
index 0000000000..acb2b9d540
--- /dev/null
+++ b/browser/content/celesta/celestaPrivate.sys.mjs
@@ -0,0 +1,171 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Private tabs inside a normal window, and tabs that browse through Tor.
+//
+// Firefox only knows private *windows*, so a private tab is a tab in a hidden
+// container of its own: its cookies and site data are kept apart from every
+// other tab and deleted when the last private tab closes, and the pages it
+// opened are removed from history unless they had been visited before.
+//
+// A Tor tab is a private tab in a container of its own whose every request
+// goes through the Tor SOCKS proxy on this computer (Celesta.tor.port: 9150 for
+// Tor Browser, 9050 for the tor service), with host names resolved by Tor.
+// Tor must be running.
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  ContextualIdentityService: "moz-src:///toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs",
+  PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
+});
+
+const CONTAINER_PREF = "Celesta.private.userContextId";
+const TOR_CONTAINER_PREF = "Celesta.tor.userContextId";
+const TOR_PORT_PREF = "Celesta.tor.port";
+
+function containerId(pref, name, color) {
+  const id = Services.prefs.getIntPref(pref, 0);
+  if (id && lazy.ContextualIdentityService.getPublicIdentityFromId(id)) {
+    return id;
+  }
+  const identity = lazy.ContextualIdentityService.create(name, "fingerprint", color);
+  Services.prefs.setIntPref(pref, identity.userContextId);
+  return identity.userContextId;
+}
+
+const isIn = (pref, userContextId) => {
+  const id = Services.prefs.getIntPref(pref, 0);
+  return !!id && userContextId == id;
+};
+
+export const isTorTab = tab => isIn(TOR_CONTAINER_PREF, tab.userContextId);
+
+export function isPrivateTab(tab) {
+  return isIn(CONTAINER_PREF, tab.userContextId) || isTorTab(tab);
+}
+
+/* urls a private tab visited, with when the tab first saw each */
+const visited = new WeakMap();
+
+export function openPrivateTab(win, userContextId = containerId(CONTAINER_PREF, "Private tab", "purple")) {
+  const gBrowser = win.gBrowser;
+  const tab = gBrowser.addTab("about:privatebrowsing", {
+    userContextId,
+    triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal(),
+  });
+  visited.set(tab, new Map());
+  gBrowser.selectedTab = tab;
+  return tab;
+}
+
+/* call once per browser window: tracks private tabs and cleans up after them */
+export function watchPrivateTabs(win) {
+  const gBrowser = win.gBrowser;
+  gBrowser.addTabsProgressListener({
+    onLocationChange(browser, webProgress, request, location) {
+      const tab = gBrowser.getTabForBrowser(browser);
+      if (!webProgress.isTopLevel || !tab || !isPrivateTab(tab) || !/^https?:/.test(location.spec)) {
+        return;
+      }
+      if (!visited.has(tab)) {
+        visited.set(tab, new Map());
+      }
+      const urls = visited.get(tab);
+      if (!urls.has(location.spec)) {
+        urls.set(location.spec, new Date());
+      }
+    },
+  });
+  gBrowser.tabContainer.addEventListener("TabClose", e => {
+    const tab = e.target;
+    if (!isPrivateTab(tab)) {
+      return;
+    }
+    forgetVisits(visited.get(tab));
+    win.setTimeout(clearIfLastPrivateTab, 0);
+  });
+}
+
+async function forgetVisits(urls) {
+  for (const [url, since] of urls || []) {
+    const info = await lazy.PlacesUtils.history.fetch(url, { includeVisits: true }).catch(() => null);
+    const earlier = info?.visits.some(v => v.date < since);
+    if (earlier) {
+      // known before: only the private tab's visits go
+      await lazy.PlacesUtils.history.removeVisitsByFilter({ url, beginDate: since }).catch(() => {});
+    } else if (info) {
+      await lazy.PlacesUtils.history.remove(url).catch(() => {});
+    }
+  }
+}
+
+function clearIfLastPrivateTab() {
+  for (const pref of [CONTAINER_PREF, TOR_CONTAINER_PREF]) {
+    const userContextId = Services.prefs.getIntPref(pref, 0);
+    const open = [...Services.wm.getEnumerator("navigator:browser")].some(win =>
+      win.gBrowser?.tabs.some(tab => tab.userContextId == userContextId)
+    );
+    if (userContextId && !open) {
+      Services.clearData.deleteDataFromOriginAttributesPattern({ userContextId });
+    }
+  }
+}
+
+/* ---------------- Tor tabs ---------------- */
+
+let torFilter = null;
+
+const torWindows = new WeakSet();
+export const isTorWindow = win => torWindows.has(win);
+
+// everything the Tor container loads (pages, frames, workers, favicons), and
+// everything loaded in a Tor window
+function isTorRequest(channel) {
+  if (isIn(TOR_CONTAINER_PREF, channel.loadInfo?.originAttributes?.userContextId)) {
+    return true;
+  }
+  const top = channel.loadInfo?.browsingContext?.top;
+  const win = top?.embedderElement?.ownerGlobal ?? top?.topChromeWindow;
+  return !!win && torWindows.has(win);
+}
+
+function registerTorFilter() {
+  if (torFilter) {
+    return;
+  }
+  const pps = Cc["@mozilla.org/network/protocol-proxy-service;1"].getService(Ci.nsIProtocolProxyService);
+  torFilter = {
+    QueryInterface: ChromeUtils.generateQI(["nsIProtocolProxyChannelFilter"]),
+    applyFilter(channel, proxy, callback) {
+      if (!isTorRequest(channel)) {
+        callback.onProxyFilterResult(proxy);
+        return;
+      }
+      const port = Services.prefs.getIntPref(TOR_PORT_PREF, 9150);
+      callback.onProxyFilterResult(
+        pps.newProxyInfo("socks", "127.0.0.1", port, "", "", Ci.nsIProxyInfo.TRANSPARENT_PROXY_RESOLVES_HOST, 0xffffffff, null)
+      );
+    },
+  };
+  pps.registerChannelFilter(torFilter, 0);
+}
+
+/* a private window whose every tab browses through Tor */
+export function openTorWindow(opener) {
+  registerTorFilter();
+  const win = opener.OpenBrowserWindow({ private: true });
+  torWindows.add(win);
+  win.addEventListener("load", () => win.document.documentElement.setAttribute("Celesta-tor", ""), { once: true });
+  return win;
+}
+
+export function openTorTab(win) {
+  registerTorFilter();
+  return openPrivateTab(win, containerId(TOR_CONTAINER_PREF, "Tor tab", "purple"));
+}
+
+// a Tor tab restored from the last session must not load before the filter is up
+if (Services.prefs.getIntPref(TOR_CONTAINER_PREF, 0)) {
+  registerTorFilter();
+}
diff --git a/browser/content/celesta/celestaProfiler.sys.mjs b/browser/content/celesta/celestaProfiler.sys.mjs
new file mode 100644
index 0000000000..f6b185630d
--- /dev/null
+++ b/browser/content/celesta/celestaProfiler.sys.mjs
@@ -0,0 +1,448 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Profiling mode (pref Celesta.profiling) also keeps a log for reading later:
+// <profile>/Celesta-profile.log (the previous one becomes Celesta-profile.prev.log).
+// One line per sample or event; lines starting with "!" are the ones worth a
+// look. It records no addresses, titles or other page content.
+
+import { clearInterval, setInterval } from "resource://gre/modules/Timer.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  AsyncShutdown: "resource://gre/modules/AsyncShutdown.sys.mjs",
+});
+
+const PREF = "Celesta.profiling";
+// Gecko writes one summary line per GC and CC to the console while this is on
+const GC_LOG_PREF = "javascript.options.mem.log";
+const SAMPLE_MS = 10000;
+// a memory report walks every process and stalls each for up to half a second
+const REPORT_MS = 300000;
+// what grows while the browser starts (start pages, caches) is not a leak
+const SETTLE_MS = 600000;
+const MAX_BYTES = 50 * 1024 * 1024;
+const MB = 1048576;
+const REPORT_KEYS = [
+  "ghost-windows",
+  "gpu-committed",
+  "gpu-dedicated",
+  "gpu-shared",
+  "webgl-context-count",
+  "webgl-texture-count",
+  "webgl-texture-memory",
+  "webgl-buffer-count",
+  "webgl-buffer-memory",
+  "webgl-renderbuffer-count",
+  "webgl-renderbuffer-memory",
+  "webgl-shader-count",
+];
+
+const mb = bytes => Math.round(bytes / MB) + "MB";
+const ms = n => Number(n).toFixed(1) + "ms";
+
+let on = false;
+let started = 0;
+let path = "";
+let lines = [];
+let written = 0;
+let timers = [];
+let lastProc = null;
+let gc = { GC: [], CC: [] };
+const series = new Map();
+// shaders: each one's build time once, and its frame times between samples
+const shadersBuilt = new Set();
+const shaderFrames = new Map();
+const warned = new Map();
+
+function log(line, notable = false) {
+  const t = ((Date.now() - started) / 1000).toFixed(1);
+  lines.push(`${notable ? "!" : " "} T+${t} ${new Date().toTimeString().slice(0, 8)} ${line}`);
