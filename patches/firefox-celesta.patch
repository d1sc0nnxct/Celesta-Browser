+
+  /* the sky's layers (uF0..uF5): how much each moves with a pan */
+  const PARALLAX = [1, 1, 1, 1, 1, 1];
+  const SKY_ZOOM = 0.5;   // sky zoom = page zoom ^ SKY_ZOOM
+  let focus = null, cam = null;
