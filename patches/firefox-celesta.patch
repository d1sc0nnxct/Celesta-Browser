+async function sample() {
+  const info = await ChromeUtils.requestProcInfo();
+  const now = Date.now();
+  const procs = [
+    { key: "main:" + info.pid, mem: info.memory, cpu: info.cpuTime },
+    ...info.children.map(c => ({ key: c.type + ":" + c.pid, mem: c.memory, cpu: c.cpuTime })),
+  ];
