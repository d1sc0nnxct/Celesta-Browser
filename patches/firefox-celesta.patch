+      const pillWidth = parseFloat(el.style.getPropertyValue("--Celesta-pill-width"));
+      if (pillWidth) {
+        const z = parseFloat(win.getComputedStyle(el).zoom) || 1;
+        r = new win.DOMRect(r.left + parseFloat(el.style.getPropertyValue("--Celesta-pill-left")) * z, r.top, pillWidth * z, r.height);
+      }
+      if (r.width && r.height) {
+        const cs = win.getComputedStyle(el);
+        const radii = ["borderTopLeftRadius", "borderTopRightRadius", "borderBottomRightRadius", "borderBottomLeftRadius"].map(k =>
+          Math.min((parseFloat(cs[k]) || 0) * (parseFloat(cs.zoom) || 1), r.width / 2, r.height / 2)
+        );
+        bars.push([r, radii]);
+      }
+    }
+    if (!bars.length) {
+      box = null;
+      canvas.style.clipPath = "inset(50%)";
+      return;
+    }
+    const left = Math.floor(Math.min(...bars.map(([r]) => r.left))), top = Math.floor(Math.min(...bars.map(([r]) => r.top)));
+    const right = Math.ceil(Math.max(...bars.map(([r]) => r.right))), bottom = Math.ceil(Math.max(...bars.map(([r]) => r.bottom)));
+    box = { left, top, width: right - left, height: bottom - top };
+    const at = r => ({ left: r.left - left, top: r.top - top, right: r.right - left, bottom: r.bottom - top });
+    rects = bars.map(([r]) => [r.left - left, r.top - top, r.width, r.height].map(v => v * LAYER_SCALE));
+    Object.assign(canvas.style, { left: left + "px", top: top + "px", width: box.width + "px", height: box.height + "px" });
+    canvas.style.clipPath = `path("${bars.map(([r, radii]) => shape(at(r), radii)).join("")}")`;
+  };
+  // a rounded rect as path data, each corner its own radius
+  const shape = (r, [tl, tr, br, bl]) =>
+    `M${r.left + tl} ${r.top}H${r.right - tr}A${tr} ${tr} 0 0 1 ${r.right} ${r.top + tr}V${r.bottom - br}` +
+    `A${br} ${br} 0 0 1 ${r.right - br} ${r.bottom}H${r.left + bl}A${bl} ${bl} 0 0 1 ${r.left} ${r.bottom - bl}` +
+    `V${r.top + tl}A${tl} ${tl} 0 0 1 ${r.left + tl} ${r.top}Z`;
+  const shown = () => barsShown(doc);
+  // whether there is something to draw: the clip follows the bars, which change size
+  // with their tabs and buttons; once a second anyway, for a bar that appears without
+  // resizing the others
+  const ready = () => {
+    if (!shown()) {
+      return false;
+    }
+    const now = win.performance.now();
+    if (now - measured > 1000) {
+      measured = now;
+      measure();
+    }
+    return !!box;
+  };
+  // the canvas's size, and the shader as one layer over the window at zoom% of its
+  // size, centred and repeated: tile [x, y, w, h] in canvas pixels; fitted, one tile per bar
+  const place = () => {
+    const W = win.innerWidth * LAYER_SCALE, H = win.innerHeight * LAYER_SCALE;
+    const tw = W * z, th = H * z;
+    const wrap = (v, size) => ((v % size) + size) % size - size;
+    return {
+      w: Math.ceil(box.width * LAYER_SCALE),
+      h: Math.ceil(box.height * LAYER_SCALE),
+      tile: [wrap((W - tw) / 2 - box.left * LAYER_SCALE, tw), wrap((H - th) / 2 - box.top * LAYER_SCALE, th), tw, th],
+      tiles: fit ? rects : null,
+    };
+  };
+
+  // A worker of this window draws the shader straight into the canvas, only the part
+  // the bars show. Copying the shared renderer's frames out of the GPU (ImageBitmaps)
+  // cost the GPU process ~18% of a core and the main thread ~6% at 30 fps.
+  const name = "theme " + PathUtils.filename(path);
+  let worker = new win.Worker("chrome://celesta/content/shader-worker.js");
+  let copy = null, busy = 0;
+  const sent = [];
+  const timer = Cc["@mozilla.org/timer;1"].createInstance(Ci.nsITimer);
+  const tick = () => {
+    timer.initWithCallback(tick, shaderInterval("surfaceFps"), Ci.nsITimer.TYPE_ONE_SHOT);
+    // at most two frames in flight; none while another app is in front
+    if (busy < 2 && Services.focus.activeWindow && !doc.hidden && ready()) {
+      busy++;
+      sent.push(ChromeUtils.now());
+      const { w, h, tile, tiles } = place();
+      worker.postMessage({ t: win.performance.now() / 1000, size: [w, h], tile, tiles, res: SHADER_SIZE });
+    }
+  };
+  worker.onmessage = ({ data }) => {
+    if (data.ready) {
+      lazy.CelestaProfiler.shaderBuilt(name, data.buildMs);
+      tick();
+    } else if (data.error) {
+      worker.terminate();
+      worker = null;
+      if (data.untiled) {
+        viaCopies();
+      } else {
+        console.error("Celesta shader " + path + ":\n" + data.error);
+      }
+    } else {
+      busy--;
+      const at = sent.shift();
+      lazy.CelestaProfiler.shaderFrame(name, { roundTrip: at == null ? null : ChromeUtils.now() - at, work: data.workMs });
+    }
+  };
+  worker.onerror = e => console.error("Celesta shader " + path + ": " + e.message);
+  canvas.style.opacity = alpha;
+  const off = canvas.transferControlToOffscreen();
+  IOUtils.readUTF8(path, { maxBytes: 1024 * 1024 })
+    .then(source => worker?.postMessage({ source, canvas: off }, [off]))
+    .catch(console.error);
+
+  // other shaders (several passes, or their own main()) are copied from the shared renderer
+  function viaCopies() {
+    const fresh = canvas.cloneNode(false);
+    canvas.replaceWith(fresh);
+    canvas = fresh;
+    canvas.style.opacity = "";
+    const ctx = canvas.getContext("2d");
+    copy = {
+      doc,
+      alpha,
+      wanted: shown,
+      draw(frame) {
+        if (!ready()) {
+          return;
+        }
+        const { w, h, tile: [x0, y0, tw, th], tiles } = place();
+        if (canvas.width != w || canvas.height != h) {
+          canvas.width = w;
+          canvas.height = h;
+        }
+        ctx.clearRect(0, 0, w, h);
+        ctx.globalAlpha = alpha;
+        if (tiles) {
+          for (const [x, y, tileW, tileH] of tiles) {
+            ctx.drawImage(frame, x, y, tileW, tileH);
+          }
+          return;
+        }
+        for (let x = x0; x < w; x += tw) {
+          for (let y = y0; y < h; y += th) {
+            ctx.drawImage(frame, x, y, tw, th);
+          }
+        }
+      },
+    };
+    copy.hub = sharedShader(path, SHADER_SIZE, "surfaceFps", win);
+    copy.hub.copies.add(copy);
+  }
+
+  const stop = () => {
+    timer.cancel();
+    worker?.terminate();
+    const hub = copy?.hub;
+    if (hub) {
+      hub.copies.delete(copy);
+      if (!hub.copies.size && shaders.get(hub.key) == hub) {
+        endShader(hub);
+      }
+    }
+    resized.disconnect();
+    canvas.remove();
+    doc.documentElement.style.removeProperty("--Celesta-bar-glass");
+  };
+  win.addEventListener("unload", stop, { once: true });
+  return stop;
+}
+
+/* keeps the document's canvas `id` drawing what `key` names (nothing for
+   ""); draw() starts it and returns how to stop it */
+function setDrawn(doc, id, key, draw) {
+  let drawn = surfaces.get(doc);
+  if (!drawn) {
+    surfaces.set(doc, (drawn = new Map()));
+  }
+  const current = drawn.get(id);
+  if (current?.key != key) {
+    current?.stop();
+    doc.mozSetImageElement?.(id, null);
+    drawn.delete(id);
+    if (key) {
+      drawn.set(id, { key, stop: draw() });
+    }
+  }
+  return !!key;
+}
+
+function setSurface(doc, t, images) {
+  const path = t.surface == "image" ? t.surfaceImage : t.surface == "shader" ? t.surfaceShader : "";
+  const alpha = Math.min(100, Math.max(0, t.opacity)) / 100;
+  const key = images && path && doc.mozSetImageElement ? `${t.surface}|${path}|${alpha}` : "";
+  const barLayer =
+    key && t.surface == "shader" && doc.getElementById("navigator-toolbox") ? `${key}|${t.surfaceZoom}|${t.surfaceFit}` : "";
+  setDrawn(doc, "Celesta-surface-layer", barLayer, () => drawSurfaceLayer(doc, path, alpha, t.surfaceZoom, t.surfaceFit));
+  return setDrawn(doc, SURFACE_ID, key, () =>
+    t.surface == "image"
+      ? drawImage(doc, path, alpha, SURFACE_ID)
+      : drawShader(doc, path, alpha, SURFACE_ID, SHADER_SIZE, "menuFps")
+  );
+}
+
+/* the fills drawn by a shader in this document */
+function setFillShaders(doc, t, images) {
+  const drawn = new Set();
+  for (const key of FILLS) {
+    const path = images && t[key] == "shader" && doc.mozSetImageElement ? t[key + "Shader"] : "";
+    const id = "Celesta-fill-" + key;
+    if (setDrawn(doc, id, path, () => drawShader(doc, path, 1, id, FILL_SHADER_SIZE, key + "Fps", true))) {
+      drawn.add(key);
+    }
+  }
+  return drawn;
+}
+
+/* per document: the custom font file it has loaded */
+const fonts = new WeakMap();
+
+function setFont(doc, path) {
+  const current = fonts.get(doc);
+  if (current?.path == path) {
+    return;
+  }
+  if (current?.face) {
+    doc.fonts.delete(current.face);
+  }
+  fonts.set(doc, { path });
+  if (!path) {
+    return;
+  }
+  IOUtils.read(path, { maxBytes: MAX_FILE_BYTES })
+    .then(bytes => {
+      if (fonts.get(doc)?.path != path) {
+        return;
+      }
+      const face = new doc.defaultView.FontFace(CUSTOM_FONT, bytes.buffer);
+      fonts.get(doc).face = face;
+      doc.fonts.add(face);
+      return face.load();
+    })
+    .catch(console.error);
+}
+
+export function applyTheme(root, { images = true } = {}) {
+  const t = readTheme();
+  const doc = root.ownerDocument;
+  const drawn = setSurface(doc, t, images);
+  const fills = setFillShaders(doc, t, images);
+  if (images) {
+    setFont(doc, t.fontFile);
+  }
+  for (const [name, value] of Object.entries(themeVars(t, { images, drawn, fills }))) {
+    if (value) {
+      root.style.setProperty(name, value);
+    } else {
+      root.style.removeProperty(name);
+    }
+  }
+  root.toggleAttribute("Celesta-light", t.mode == "light");
+  const filled = key => t[key] == "gradient" || (t[key] == "image" && images && !!t[key + "Image"]) || fills.has(key);
+  root.toggleAttribute("Celesta-text-fill", filled("text"));
+  root.toggleAttribute("Celesta-text2-fill", filled("text2"));
+  root.toggleAttribute("Celesta-icon-fill", filled("icon"));
+  root.toggleAttribute("Celesta-font", !!(t.font || (images && t.fontFile)));
+}
+
+/* ---------------- the start page's background everywhere ---------------- */
+
+const BACKGROUND_BRANCH = "Celesta.home.background";
+const SNAPSHOT_PREF = "Celesta.home.background.snapshot";
+const SKY_KINDS = ["nebula", "stars", "shader"];
+const MEDIA_FILE = /\.(jpe?g|png|gif|webp|avif|mp4|m4v|webm|ogv)$/i;
+const VIDEO_FILE = /\.(mp4|m4v|webm|ogv)$/i;
+
+export const snapshotPath = () => PathUtils.join(PathUtils.profileDir, "Celesta-background.jpg");
+
+/* what the sky looks like: a snapshot taken under another key is stale */
+export function backgroundKey() {
+  const kind = Services.prefs.getStringPref(BACKGROUND_BRANCH, "nebula");
+  return kind == "shader" ? "shader:" + Services.prefs.getStringPref(BACKGROUND_BRANCH + ".shaderFile", "") : kind;
+}
+
+export const snapshotFresh = () => Services.prefs.getStringPref(SNAPSHOT_PREF, "").startsWith(backgroundKey() + "|");
+
+export function snapshotTaken() {
+  Services.prefs.setStringPref(SNAPSHOT_PREF, backgroundKey() + "|" + Date.now());
+}
+
+/* Hands the sky snapshot to content processes, whose pages (Passwords,
+   Protections) cannot read it from the profile. In the parent process only. */
+export async function shareSnapshot(bytes = null) {
+  bytes ??= snapshotFresh() ? await IOUtils.read(snapshotPath()).catch(() => null) : null;
+  if (bytes) {
+    Services.ppmm.sharedData.set("Celesta-snapshot", bytes);
+    Services.ppmm.sharedData.flush();
+  }
+}
+
+async function backgroundMedia(kind) {
+  if (kind == "media") {
+    return Services.prefs.getStringPref(BACKGROUND_BRANCH + ".file", "");
+  }
+  const dir = Services.prefs.getStringPref(BACKGROUND_BRANCH + ".folder", "");
+  const files = dir ? (await IOUtils.getChildren(dir).catch(() => [])).filter(f => MEDIA_FILE.test(f)) : [];
+  return files[Math.floor(Math.random() * files.length)] || "";
+}
+
+/* Paints the start page's background (Settings > Appearance > Background)
+   behind a privileged document: its color, picture or video, or for the sky
+   the start page's last snapshot of it. Returns true for a sky background. */
+export function paintBackground(doc) {
+  const kind = Services.prefs.getStringPref(BACKGROUND_BRANCH, "nebula");
+  let layer = doc.getElementById("Celesta-bg");
+  if (!layer) {
+    layer = doc.createElementNS(HTML_NS, "div");
+    layer.id = "Celesta-bg";
+    (doc.body ?? doc.documentElement).prepend(layer);
+  }
+  layer.replaceChildren();
+  layer.style.background = "#000";
+  if (kind == "color") {
+    layer.style.background = Services.prefs.getStringPref(BACKGROUND_BRANCH + ".color", "#05050a").replace(/[;{}]/g, "");
+  } else if (SKY_KINDS.includes(kind)) {
+    const stamp = Services.prefs.getStringPref(SNAPSHOT_PREF, "").split("|").pop();
+    if (snapshotFresh()) {
+      layer.style.background = `#000 url("${fileURI(snapshotPath())}?${stamp}") center / cover`;
+    }
+  } else {
+    backgroundMedia(kind).then(path => {
+      const url = MEDIA_FILE.test(path) && fileURI(path);
+      if (!url) {
+        return;
+      }
+      if (VIDEO_FILE.test(path)) {
+        const video = doc.createElementNS(HTML_NS, "video");
+        Object.assign(video, { muted: true, loop: true, autoplay: true, src: url });
+        layer.append(video);
+      } else {
+        layer.style.background = `#000 url("${url}") center / cover`;
+      }
+    });
+  }
+  return SKY_KINDS.includes(kind);
+}
+
+/* calls callback when the background or its snapshot changes; returns a function that stops it */
+export function watchBackground(callback) {
+  const observer = () => callback();
+  Services.prefs.addObserver(BACKGROUND_BRANCH, observer);
+  return () => Services.prefs.removeObserver(BACKGROUND_BRANCH, observer);
+}
+
+// chrome windows and dialogs that keep Firefox's own look
+const UNSKINNED = /^chrome:\/\/(browser\/content\/browser\.xhtml|devtools\/|global\/content\/hiddenWindow|browser\/content\/hiddenWindowMac|Celesta\/)/;
+let skinning = false;
+
+/* Gives every chrome window and dialog (Library, Page Info, prompts, the
+   dialogs inside Settings) the theme: window.css and the theme's variables.
+   The browser window has its own chrome.css; DevTools keep their look. */
+export function skinChromeWindows() {
+  if (skinning) {
+    return;
+  }
+  skinning = true;
+  const skin = win => {
+    const doc = win.document;
+    const root = doc?.documentElement;
+    if (!root?.style || !doc.documentURI.startsWith("chrome:") || UNSKINNED.test(doc.documentURI) || root.hasAttribute("Celesta-skinned")) {
+      return;
+    }
+    root.setAttribute("Celesta-skinned", "");
+    win.windowUtils.loadSheetUsingURIString("chrome://celesta/content/window.css", win.windowUtils.AUTHOR_SHEET);
+    applyTheme(root);
+    const stop = watchTheme(() => applyTheme(root));
+    // windows (Library, Page Info) get the background; dialogs inside a page keep their surface
+    if (win.top == win) {
+      paintBackground(doc);
+      const stopBackground = watchBackground(() => paintBackground(doc));
+      win.addEventListener("unload", stopBackground, { once: true });
+    }
+    win.addEventListener("unload", stop, { once: true });
+  };
+  Services.obs.addObserver(win => {
+    win.addEventListener("DOMContentLoaded", () => skin(win), { once: true });
+  }, "chrome-document-global-created");
+  for (const win of Services.wm.getEnumerator(null)) {
+    if (win.document.readyState != "loading") {
+      skin(win);
+    }
+  }
+}
+
+/* calls callback whenever a theme pref changes; returns a function that stops it */
+export function watchTheme(callback) {
+  const observer = () => callback();
+  Services.prefs.addObserver(BRANCH, observer);
+  return () => Services.prefs.removeObserver(BRANCH, observer);
+}
+
+/* one JSON file; images, fonts and shaders are embedded as data: URLs so the
+   file is complete */
+export async function exportTheme(path) {
+  const theme = { CelestaTheme: 1, ...readTheme() };
+  for (const key of FILE_PREFS) {
+    const file = theme[key];
+    const type = FILE_TYPES[file?.split(".").pop()?.toLowerCase()];
+    if (!file || !type || !(await IOUtils.exists(file))) {
+      theme[key] = "";
+      continue;
+    }
+    const bytes = await IOUtils.read(file, { maxBytes: MAX_FILE_BYTES });
+    let binary = "";
+    for (let i = 0; i < bytes.length; i += 0x8000) {
+      binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+    }
+    theme[key] = `data:${type};base64,${btoa(binary)}`;
+  }
+  await IOUtils.writeJSON(path, theme);
+}
+
+/* reads a theme file, keeps only known settings of the right type, and saves
+   embedded files into the profile's Celesta-themes folder */
+export async function importTheme(path) {
+  const theme = await IOUtils.readJSON(path);
+  if (!theme || theme.CelestaTheme != 1) {
+    throw new Error("Not an Celesta theme file");
+  }
+  const dir = PathUtils.join(PathUtils.profileDir, "Celesta-themes");
+  await IOUtils.makeDirectory(dir, { ignoreExisting: true });
+  for (const [key, fallback] of Object.entries(THEME_PREFS)) {
+    let value = theme[key];
+    if (typeof value != typeof fallback) {
+      continue;
+    }
+    if (FILE_PREFS.includes(key) && value) {
+      const match = /^data:([a-z]+\/[a-z0-9+.-]+);base64,([A-Za-z0-9+/=]+)$/.exec(value);
+      const ext = match && Object.keys(FILE_TYPES).find(e => FILE_TYPES[e] == match[1]);
+      if (!ext) {
+        continue;
+      }
+      const file = PathUtils.join(dir, `${key}-${Date.now()}.${ext}`);
+      await IOUtils.write(file, Uint8Array.from(atob(match[2]), c => c.charCodeAt(0)));
+      value = file;
+    }
+    if (typeof fallback == "number") {
+      Services.prefs.setIntPref(BRANCH + key, Math.round(value));
+    } else if (typeof fallback == "boolean") {
+      Services.prefs.setBoolPref(BRANCH + key, value);
+    } else {
+      Services.prefs.setStringPref(BRANCH + key, String(value));
+    }
+  }
+}
