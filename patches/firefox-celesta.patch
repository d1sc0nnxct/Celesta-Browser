+
+function shaderBuilt(name, buildMs) {
+  if (on && buildMs != null && !shadersBuilt.has(name)) {
+    shadersBuilt.add(name);
+    log(`SHADER ${name} built (compile and link) in ${ms(buildMs)}`, buildMs >= 100);
+  }
+}
+
+// times: { gpu, work, roundTrip, main }, each a number or an array of them
+function shaderFrame(name, times) {
+  if (!on) {
+    return;
+  }
+  let s = shaderFrames.get(name);
+  if (!s) {
+    s = { gpu: [], work: [], roundTrip: [], main: [] };
+    shaderFrames.set(name, s);
+  }
+  for (const [k, v] of Object.entries(times)) {
+    if (v != null && s[k]) {
+      s[k].push(...[].concat(v));
+    }
+  }
+}
+
+function logShaders() {
+  const labels = { gpu: "GPU", work: "render thread", roundTrip: "request to frame", main: "drawn on main thread" };
+  for (const [name, s] of shaderFrames) {
+    const parts = [];
+    for (const [k, label] of Object.entries(labels)) {
+      const p = percentiles(s[k]);
+      if (p) {
+        parts.push(`${label} p50 ${ms(p.p50)} p95 ${ms(p.p95)} max ${ms(p.max)}`);
+      }
+    }
+    if (!parts.length) {
+      continue;
+    }
+    const frames = Math.max(...Object.values(s).map(a => a.length));
+    const gpu = percentiles(s.gpu.length ? s.gpu : s.roundTrip), main = percentiles(s.main);
+    log(`SHADER ${name} ${frames} frames: ${parts.join(", ")}`, gpu?.p95 > 20 || main?.p95 > 4);
