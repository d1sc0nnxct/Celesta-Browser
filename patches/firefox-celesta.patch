--- a/browser/base/content/browser-init.js
+++ b/browser/base/content/browser-init.js
@@ -2,6 +2,19 @@
  * License, v. 2.0. If a copy of the MPL was not distributed with this
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
+// Celesta's start page actor: registered here, at window startup, so it is in
+// place before the first start page loads (the redirector module loads too late).
+try {
+  ChromeUtils.registerWindowActor("CelestaHome", {
+    parent: { esModuleURI: "chrome://celesta/content/CelestaHomeParent.sys.mjs" },
+    child: {
+      esModuleURI: "chrome://celesta/content/CelestaHomeChild.sys.mjs",
+      events: { DOMContentLoaded: {}, pageshow: {}, unload: {}, "Celesta-dataset": {} },
+    },
+    matches: ["chrome://celesta/content/*", "about:home", "about:newtab"],
+    allFrames: false,
+  });
+} catch (e) {}
 let _resolveDelayedStartup;
 var delayedStartupPromise = new Promise(resolve => {
   _resolveDelayedStartup = resolve;
