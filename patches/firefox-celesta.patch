+    const pauses = gc[kind];
+    if (pauses.length) {
+      log(`${kind} ${pauses.length} runs, longest pause ${ms(Math.max(...pauses))}, all pauses ${ms(pauses.reduce((a, b) => a + b, 0))}`);
+    }
+  }
