+    const proc = text.match(/\[([^\]]+)\]/)?.[1] || "?";
+    const full = text.match(/Non-Incremental: ([\d.]+)ms \(([^)]*)\)/);
+    const pause = Number(full?.[1] ?? text.match(/[Mm]ax [Pp]ause: ([\d.]+)ms/)?.[1] ?? 0);
+    const total = Number(full?.[1] ?? text.match(/(?:Total|total time): ([\d.]+)ms/)?.[1] ?? 0);
