+        `${kind} ${proc} pause ${ms(pause)}, total ${ms(total)}${full ? ", not incremental: " + full[2] : ""}${heap ? ", heap " + heap.toFixed(0) + "MB" : ""}${reason ? ", reason " + reason : ""}`,
