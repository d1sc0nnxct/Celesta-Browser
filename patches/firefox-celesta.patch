+
+  // Settings > Home > Memory: a background tab not used for a while is paused
+  // (unloaded; it reloads where it was when opened). Tabs that are pinned,
+  // playing sound or media (muted too), in picture-in-picture or sharing the camera, microphone or
+  // screen are left alone, and so is a page that asks before it closes.
+  const PAUSE_PREF = "Celesta.tabs.pauseAfter";
+  function setUpTabPausing() {
+    const { webrtcUI } = ChromeUtils.importESModule("resource:///modules/webrtcUI.sys.mjs");
+    // muted or silent media is not "sound playing": each frame is asked (CelestaMediaChild)
+    const playingMedia = async browser => {
+      const frames = browser.browsingContext?.getAllBrowsingContextsInSubtree() ?? [];
+      const answers = await Promise.all(
+        frames.map(bc => {
+          try {
+            return bc.currentWindowGlobal?.getActor("CelestaMedia").sendQuery("CelestaMedia:Playing").catch(() => false);
+          } catch {
+            return false;
+          }
+        })
+      );
+      return answers.some(Boolean);
+    };
+    const check = async () => {
+      const minutes = Services.prefs.getIntPref(PAUSE_PREF, 30);
+      if (minutes <= 0) {
+        return;
+      }
+      const before = Date.now() - minutes * 60000;
+      for (const tab of gBrowser.tabs) {
+        const browser = tab.linkedBrowser;
+        if (
+          tab.selected ||
+          tab.pinned ||
+          tab.hasAttribute("pending") ||
+          tab.lastAccessed > before ||
+          tab.soundPlaying ||
+          tab.pictureinpicture ||
+          webrtcUI.browserHasStreams(browser) ||
+          browser.browsingContext?.currentWindowGlobal?.hasActivePeerConnections() ||
+          (await playingMedia(browser))
+        ) {
+          continue;
+        }
+        // the tab may have been chosen or closed while its frames answered
+        if (!tab.selected && tab.isConnected) {
+          gBrowser.discardBrowser(tab, { renderDiscarded: true });
+        }
+      }
+    };
+    const timer = setInterval(check, 60000);
+    window.addEventListener("unload", () => clearInterval(timer), { once: true });
+  }
+
+  // Profiling mode (pref Celesta.profiling): a corner box with each kind of
+  // process's CPU use and the browser's memory, every 2 seconds; CelestaProfiler
+  // also writes a log file
+  function setUpProfiling() {
+    ChromeUtils.importESModule("chrome://celesta/content/celestaProfiler.sys.mjs").CelestaProfiler.init();
+    let box = null, timer = 0, last = null;
+    const update = async () => {
+      const info = await ChromeUtils.requestProcInfo();
+      const now = { t: Date.now(), cpu: new Map([["main", info.cpuTime], ...info.children.map(c => [c.type + ":" + c.pid, c.cpuTime])]) };
+      let mem = info.memory;
+      const byType = new Map();
+      for (const c of info.children) {
+        mem += c.memory;
+        const prev = last?.cpu.get(c.type + ":" + c.pid);
+        if (prev != null) {
+          byType.set(c.type, (byType.get(c.type) || 0) + (c.cpuTime - prev));
+        }
+      }
+      if (last) {
+        const ms = now.t - last.t;
+        const pct = ns => ((ns / 1e6 / ms) * 100).toFixed(0) + "%";
+        const parts = [`main ${pct(info.cpuTime - last.cpu.get("main"))}`, ...[...byType].sort((a, b) => b[1] - a[1]).map(([type, ns]) => `${type} ${pct(ns)}`)];
+        box.textContent = `CPU (of one core): ${parts.join(" ┬╖ ")}\nMemory: ${(mem / 1048576).toFixed(0)} MB in ${info.children.length + 1} processes`;
+      }
+      last = now;
+    };
+    const apply = () => {
+      const on = Services.prefs.getBoolPref("Celesta.profiling", false);
+      if (on && !box) {
+        box = document.createElementNS("http://www.w3.org/1999/xhtml", "div");
+        box.id = "Celesta-perf";
+        document.documentElement.append(box);
+        update();
+        timer = setInterval(update, 2000);
+      } else if (!on && box) {
+        clearInterval(timer);
+        box.remove();
+        box = last = null;
+      }
+    };
+    Services.prefs.addObserver("Celesta.profiling", apply);
+    window.addEventListener("unload", () => Services.prefs.removeObserver("Celesta.profiling", apply), { once: true });
+    apply();
+  }
+
+  function applyVertical() {
+    document.documentElement.toggleAttribute(
+      "Celesta-vertical",
+      Services.prefs.getBoolPref(VERTICAL_PREF, false)
+    );
+    queueTabs();
+  }
+
+  // Settings > Home > Floating bars: the bars' size, and how long the tab and
+  // bookmark names wait before folding and how fast they unfold and fold
+  const SCALE_PREF = "Celesta.bars.scale";
+  const FOLD_DELAY_PREF = "Celesta.bars.foldDelay";
+  const FOLD_SPEED_PREF = "Celesta.bars.foldSpeed";
+  const NAME_WIDTH_PREF = "Celesta.bars.nameWidth";
+  const ACTIVATION_PREF = "Celesta.bars.activation";
+  function applyBarPrefs() {
+    const root = document.documentElement;
+    const scale = Services.prefs.getIntPref(SCALE_PREF, 100);
+    // 0: the bars follow the window's width (100% at 1600 px)
+    root.style.setProperty(
+      "--Celesta-bars-scale",
+      scale == 0 ? Math.min(1.5, Math.max(0.8, window.innerWidth / 1600)) : Math.min(200, Math.max(50, scale)) / 100
+    );
+    root.style.setProperty("--Celesta-fold-ms", Services.prefs.getIntPref(FOLD_SPEED_PREF, 240) + "ms");
+    root.style.setProperty("--Celesta-name-max", Math.min(300, Math.max(40, Services.prefs.getIntPref(NAME_WIDTH_PREF, 110))) + "px");
+    root.style.setProperty("--Celesta-hotzone", Math.min(40, Math.max(1, Services.prefs.getIntPref(ACTIVATION_PREF, 3))) + "px");
+  }
+
+  // A bar's names unfold while the pointer is on it. Once started, the unfold
+  // plays to the end even if the pointer has already left; then the names wait
+  // Celesta.bars.foldDelay ms before folding, so a brief slip off the bar keeps them.
+  // A menu or panel opened from the bar (a tab's or bookmark's context menu, a
+  // bookmark folder) keeps its names unfolded until it closes.
+  function setUpFolding() {
+    const popups = new Set();
+    const rows = [];
+    for (const row of [tabsEl, bookmarksEl]) {
+      let timer = 0, openedAt = 0;
+      const fold = () => {
+        clearTimeout(timer);
+        const unfolding = Math.max(0, Services.prefs.getIntPref(FOLD_SPEED_PREF, 240) - (performance.now() - openedAt));
+        timer = setTimeout(() => {
+          if (!popups.size && !row.matches(":hover")) {
+            row.classList.remove("unfolded");
+          }
+        }, unfolding + Services.prefs.getIntPref(FOLD_DELAY_PREF, 700));
+      };
+      row.addEventListener("mouseenter", () => {
+        clearTimeout(timer);
+        if (!row.classList.contains("unfolded")) {
+          row.classList.add("unfolded");
+          openedAt = performance.now();
+        }
+      });
+      row.addEventListener("mouseleave", fold);
+      rows.push({ row, fold });
+    }
+    // popups opened while a bar is unfolded belong to it
+    document.addEventListener("popupshown", e => {
+      if (e.target.localName != "tooltip" && rows.some(({ row }) => row.classList.contains("unfolded"))) {
+        popups.add(e.target);
+      }
+    });
+    document.addEventListener("popuphidden", e => {
+      if (popups.delete(e.target) && !popups.size) {
+        rows.forEach(({ fold }) => fold());
+      }
+    });
+  }
+
+  // The address bar's glass covers its buttons only (chrome.css #nav-bar::before):
+  // the toolbar spans the window so Firefox's overflow check sees the real room.
+  function setUpNavPill() {
+    const bar = document.getElementById("nav-bar");
+    // its buttons stay together in the middle (xul.css [flex="1"] cannot be overridden)
+    document.getElementById("nav-bar-customization-target").removeAttribute("flex");
+    let queued = false;
+    const fit = () => {
+      queued = false;
+      const box = bar.getBoundingClientRect();
