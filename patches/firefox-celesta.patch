+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>Start</title>
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<link rel="stylesheet" href="chrome://celesta/content/style.css">
+</head>
+<body>
+
+  <!-- WebGL space background (nebulae + galactic band + stars; moves with the view) -->
+  <canvas id="space" aria-hidden="true"></canvas>
+
+  <!-- Every site as a GPU circle (bubbles.js); bubbles big enough on screen also get a DOM element -->
+  <canvas id="bubbles" aria-hidden="true"></canvas>
+
+  <!-- Pannable/zoomable graph scene: world origin = viewport center -->
+  <div id="scene">
+    <div id="nodes"></div>
+  </div>
+
+  <!-- Persistent but dim discoverability hint (there is no search bar) -->
+  <div id="sitecount" role="status"></div>
+  <button id="randombtn" type="button" title="Open a random site">
+    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
+      <rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1" fill="currentColor"/><circle cx="12" cy="12" r="1" fill="currentColor"/>
+    </svg>
+    Random site
+  </button>
+  <button id="soundbtn" type="button" title="Celesta volume" aria-label="Celesta volume">
+    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
+      <path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7"/>
+    </svg>
+  </button>
+  <div id="volume" class="hidden">
+    <input id="volumeSlider" type="range" min="0" max="100" step="1" value="24" aria-label="Celesta volume">
+  </div>  <div id="hint" aria-hidden="true">
+    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+      <rect x="6" y="2" width="12" height="20" rx="6"/><path d="M12 6v4"/>
+    </svg>
+    right-click anywhere to search
+  </div>
+  <!-- Floating omnibox: appears where you right-click, clamped inside window -->
+  <div id="omnibox" class="hidden">
+    <div class="omni-row">
+      <svg class="omni-glyph" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+        <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
+      </svg>
+      <input id="omni" type="text" placeholder="Search or enter address" autocomplete="off" spellcheck="false">
+      <kbd>esc</kbd>
+    </div>
+    <ul id="suggestions" class="hidden"></ul>
