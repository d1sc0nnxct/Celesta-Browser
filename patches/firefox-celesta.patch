+    return ext;
+  }
+  let prefVal = Services.prefs.getStringPref("browser.startup.homepage", "");
+  try {
+    let uri = Services.io.newURI(prefVal);
+    return WebExtensionPolicy.getByURI(uri);
+  } catch {
+    return null;
+  }
