diff --git a/browser/content/celesta/window.css b/browser/content/celesta/window.css
new file mode 100644
index 0000000000..cb37496658
--- /dev/null
+++ b/browser/content/celesta/window.css
@@ -0,0 +1,123 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Celesta theme for chrome windows and dialogs (Library, Page Info, prompts,
+   Settings dialogs). Loaded by CelestaTheme.sys.mjs skinChromeWindows(), which
+   also sets the --Celesta-* variables. */
+:root {
+  --Celesta-window-base: #05050a;
+  background: var(--Celesta-glass-layer, rgb(5 5 8 / 0.72)), var(--Celesta-window-base) !important;
+  color: var(--Celesta-text, rgb(255 255 255 / 0.88)) !important;
+  color-scheme: dark !important;
+  --background-color-canvas: transparent !important;
+  --background-color-box: color-mix(in srgb, var(--Celesta-glass-solid) 60%, transparent) !important;
+  --in-content-page-background: transparent !important;
+  --in-content-box-background: color-mix(in srgb, var(--Celesta-glass-solid) 60%, transparent) !important;
+  --text-color: var(--Celesta-text) !important;
+  --text-color-deemphasized: var(--Celesta-text-2) !important;
+  --button-text-color: var(--Celesta-text-2) !important;
+  --button-text-color-primary: var(--Celesta-text-2) !important;
+  --toolbarbutton-icon-fill: var(--Celesta-icon) !important;
+  --icon-color: var(--Celesta-icon) !important;
+  --button-icon-fill: var(--Celesta-icon) !important;
+  --border-color: transparent !important;
+  --color-accent-primary: var(--Celesta-accent) !important;
+  --color-accent-primary-hover: color-mix(in srgb, var(--Celesta-accent) 85%, white) !important;
+  --color-accent-primary-active: color-mix(in srgb, var(--Celesta-accent) 72%, white) !important;
+  --focus-outline-color: var(--Celesta-accent) !important;
+  --border-radius-small: calc(var(--Celesta-radius) / 6) !important;
+  --border-radius-medium: calc(var(--Celesta-radius) / 3) !important;
+  --border-radius-large: calc(var(--Celesta-radius) * 2 / 3) !important;
+}
+
+:root[Celesta-light] {
+  --Celesta-window-base: #f4f5fa;
+  color-scheme: light !important;
+}
+
+:root[Celesta-font] * {
+  font-family: var(--Celesta-font) !important;
+}
+
+:root[Celesta-text-fill] :is(h1, h2, h3, label:not(.menu-text, .menu-iconic-text, .menubar-text)) {
+  background: var(--Celesta-text-fill);
+  background-clip: text;
+  color: transparent !important;
+}
+
+/* lists, trees and toolbars show the window's surface through them */
+:is(tree, richlistbox, listbox, toolbar, toolbox, #placesToolbox, #placesView, #detailsPane, #infoBox, dialog, window):not(:root) {
+  background-color: transparent !important;
+  color: inherit;
+}
+
+/* the start page's background (CelestaTheme paintBackground) under the window's surface */
+#Celesta-bg {
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+
+  & > video {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  &::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    background: var(--Celesta-glass-layer);
+  }
+}
+
+:is(tree, richlistbox, listbox) {
+  border: none !important;
+  border-radius: calc(var(--Celesta-radius) / 2);
+}
+
+:is(treecols, treecol, treecolpicker, splitter) {
+  appearance: none !important;
+  background: transparent !important;
+  border-color: transparent !important;
+  color: var(--Celesta-text-2) !important;
+}
+
+:is(#placesMenu > menu, toolbarbutton) {
+  color: var(--Celesta-text) !important;
+  fill: var(--Celesta-icon) !important;
+}
+
+treechildren::-moz-tree-image,
+treechildren::-moz-tree-twisty {
+  fill: var(--Celesta-icon) !important;
+}
+
+treechildren::-moz-tree-row(hover) {
+  background-color: color-mix(in srgb, var(--Celesta-accent-2) 14%, transparent) !important;
+}
+
+treechildren::-moz-tree-row(selected) {
+  background-color: color-mix(in srgb, var(--Celesta-accent-2) 30%, transparent) !important;
+}
+
+treechildren::-moz-tree-cell-text {
+  color: var(--Celesta-text) !important;
+}
+
+:is(input, textarea, search-textbox, menulist, select) {
+  background-color: color-mix(in srgb, var(--Celesta-glass-solid) 70%, transparent) !important;
+  color: var(--Celesta-text-strong) !important;
+  border-color: var(--Celesta-border) !important;
+}
+
+:is(button, menulist):not(.close-icon) {
+  border-radius: var(--Celesta-radius, 24px) !important;
+}
+
+button[default], .primary {
+  background: var(--Celesta-accent-fill, var(--Celesta-accent)) !important;
+  color: #fff !important;
+}
