index 0000000000..cad8621b82
--- /dev/null
+++ b/browser/content/celesta/discord-worker.js
@@ -0,0 +1,119 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Talks to the Discord app over its local IPC pipe (\\.\pipe\discord-ipc-N)
+   for CelestaDiscord.sys.mjs. Each { clientId, activity } message sets the
+   status (activity null clears it) and is answered with { ok } or { error }.
+   A frame is an opcode and a length (uint32, little-endian), then JSON. The
+   calls block, which is why this is a worker. */
+
+"use strict";
+
+/* global ctypes */
+
+const k32 = ctypes.open("kernel32.dll");
+const HANDLE = ctypes.voidptr_t;
+const DWORD = ctypes.uint32_t;
+const BOOL = ctypes.int32_t;
+const CreateFileW = k32.declare("CreateFileW", ctypes.winapi_abi, HANDLE, ctypes.char16_t.ptr, DWORD, DWORD, ctypes.voidptr_t, DWORD, DWORD, HANDLE);
+const ReadFile = k32.declare("ReadFile", ctypes.winapi_abi, BOOL, HANDLE, ctypes.voidptr_t, DWORD, DWORD.ptr, ctypes.voidptr_t);
+const WriteFile = k32.declare("WriteFile", ctypes.winapi_abi, BOOL, HANDLE, ctypes.voidptr_t, DWORD, DWORD.ptr, ctypes.voidptr_t);
+const CloseHandle = k32.declare("CloseHandle", ctypes.winapi_abi, BOOL, HANDLE);
+const GetCurrentProcessId = k32.declare("GetCurrentProcessId", ctypes.winapi_abi, DWORD);
+const GENERIC_READ_WRITE = 0xc0000000;
+const OPEN_EXISTING = 3;
+const OP_HANDSHAKE = 0;
+const OP_FRAME = 1;
+const OP_CLOSE = 2;
+
+let pipe = null;
+let connectedAs = "";
+let nonce = 0;
+
+function close() {
+  if (pipe) {
+    CloseHandle(pipe);
+  }
+  pipe = null;
+  connectedAs = "";
+}
+
+function write(op, data) {
+  const json = new TextEncoder().encode(JSON.stringify(data));
+  const bytes = new Uint8Array(8 + json.length);
+  const view = new DataView(bytes.buffer);
+  view.setUint32(0, op, true);
+  view.setUint32(4, json.length, true);
+  bytes.set(json, 8);
+  const buf = ctypes.uint8_t.array(bytes.length)(Array.from(bytes));
+  const done = DWORD(0);
+  if (!WriteFile(pipe, buf, bytes.length, done.address(), null) || done.value != bytes.length) {
+    throw new Error("Discord closed the connection");
+  }
+}
+
+function readBytes(n) {
+  const buf = ctypes.uint8_t.array(n)();
+  for (let got = 0; got < n; ) {
+    const done = DWORD(0);
+    const at = ctypes.cast(buf.addressOfElement(got), ctypes.voidptr_t);
+    if (!ReadFile(pipe, at, n - got, done.address(), null) || !done.value) {
+      throw new Error("Discord closed the connection");
+    }
+    got += done.value;
+  }
+  return Uint8Array.from({ length: n }, (_, i) => buf[i]);
+}
+
+function read() {
+  const head = new DataView(readBytes(8).buffer);
+  const op = head.getUint32(0, true);
+  const data = JSON.parse(new TextDecoder().decode(readBytes(head.getUint32(4, true))));
+  if (op == OP_CLOSE) {
+    throw new Error(data.message || "Discord refused the connection");
+  }
+  return data;
+}
+
+function connect(clientId) {
+  close();
+  for (let i = 0; i < 10; i++) {
+    const h = CreateFileW(`\\\\.\\pipe\\discord-ipc-${i}`, GENERIC_READ_WRITE, 0, null, OPEN_EXISTING, 0, null);
+    if (ctypes.cast(h, ctypes.intptr_t).value.toString() != "-1") {
+      pipe = h;
+      break;
+    }
+  }
+  if (!pipe) {
+    throw new Error("Discord is not running");
