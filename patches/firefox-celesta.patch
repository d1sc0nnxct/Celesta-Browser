+function percentiles(values) {
+  const a = values.filter(v => v != null).sort((x, y) => x - y);
+  const at = q => a[Math.min(a.length - 1, Math.floor(a.length * q))];
+  return a.length ? { p50: at(0.5), p95: at(0.95), max: a[a.length - 1], n: a.length } : null;
