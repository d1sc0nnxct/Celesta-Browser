+<!DOCTYPE html>
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+<!-- Celesta shader editor: writes a shader for one setting (?pref=...) with a
+     live preview. Opened from Settings > Appearance. -->
+<html>
+<head>
+<meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src chrome:; style-src chrome: 'unsafe-inline'; img-src chrome: file: data: blob:">
+<title>Shader editor</title>
+<link rel="stylesheet" href="chrome://celesta/content/shader-editor.css">
+<script src="chrome://celesta/content/shader-editor.js" defer></script>
+</head>
+<body>
+  <header>
+    <h1>Shader editor</h1>
+    <span id="target"></span>
+    <span class="spacer"></span>
+    <select id="add-section" aria-label="Add a section">
+      <option value="">Add sectionΓÇª</option>
+      <option value="common">Common</option>
+      <option value="buffer a">Buffer A</option>
+      <option value="buffer b">Buffer B</option>
+      <option value="buffer c">Buffer C</option>
+      <option value="buffer d">Buffer D</option>
+    </select>
+    <button id="import">Import fileΓÇª</button>
+    <button id="export">Save as fileΓÇª</button>
+    <button id="save" class="primary">Use this shader</button>
+  </header>
+  <main>
+    <textarea id="code" spellcheck="false" aria-label="Shader code"></textarea>
+    <section id="side">
+      <canvas id="preview" width="640" height="400" aria-label="Preview"></canvas>
+      <pre id="status" role="status"></pre>
+      <p class="hint">Shadertoy code (a <code>mainImage</code> function) runs as on Shadertoy, in GLSL ES 3.0, with all its inputs. A multi-pass shader keeps each Shadertoy tab under its own line:</p>
+      <pre class="hint">// ---- common ----
+// ---- buffer a: iChannel0=buffer a, iChannel1=noise ----
+// ---- image: iChannel0=buffer a ----</pre>
+      <p class="hint">Channels can be <code>buffer a</code> to <code>buffer d</code>, <code>noise</code> (a random texture) or <code>none</code>; Shadertoy's pictures, videos, sound, cubemaps and keyboard are not available. Other code runs as written (GLSL ES 1.0, or 3.0 with <code>#version 300 es</code>) and can read <code>uRes</code> and <code>uTime</code>.</p>
+    </section>
+  </main>
+</body>
+</html>
diff --git a/browser/content/celesta/shader-editor.js b/browser/content/celesta/shader-editor.js
new file mode 100644
index 0000000000..ddfe3aa233
--- /dev/null
+++ b/browser/content/celesta/shader-editor.js
@@ -0,0 +1,159 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+// The shader settings this page can write: shader file pref -> [the kind pref
+// that switches it on, the value that does, what the setting is called].
+const TARGETS = {
+  "Celesta.home.background.shaderFile": ["Celesta.home.background", "shader", "Background"],
+  "Celesta.theme.surfaceShader": ["Celesta.theme.surface", "shader", "Surface"],
+  "Celesta.theme.accentShader": ["Celesta.theme.accent", "shader", "Accent"],
+  "Celesta.theme.accent2Shader": ["Celesta.theme.accent2", "shader", "Secondary accent"],
+  "Celesta.theme.textShader": ["Celesta.theme.text", "shader", "Text"],
+  "Celesta.theme.text2Shader": ["Celesta.theme.text2", "shader", "Secondary text"],
+  "Celesta.theme.iconShader": ["Celesta.theme.icon", "shader", "Icons"],
+};
+const STARTER = `// Shadertoy-style: fragCoord is in pixels, iResolution and iTime are set.
+void mainImage(out vec4 fragColor, in vec2 fragCoord) {
+  vec2 uv = fragCoord / iResolution.xy;
+  vec3 col = 0.5 + 0.5 * cos(iTime * 0.6 + uv.xyx * 3.0 + vec3(0.0, 2.0, 4.0));
+  fragColor = vec4(col * 0.6, 1.0);
+}
+`;
+const MAX_BYTES = 1024 * 1024;
+const SHADER_FILTER = ["Shaders", "*.glsl;*.frag;*.fs;*.txt"];
+
+const pref = new URLSearchParams(location.search).get("pref");
+const target = TARGETS[pref];
+const $ = id => document.getElementById(id);
+const code = $("code"), status = $("status"), canvas = $("preview");
+
+const { applyTheme, watchTheme, paintBackground, shaderToy } = ChromeUtils.importESModule("chrome://celesta/content/celestaTheme.sys.mjs");
+applyTheme(document.documentElement);
+const stopTheme = watchTheme(() => applyTheme(document.documentElement));
+addEventListener("unload", stopTheme, { once: true });
+paintBackground(document);
+
+const gl = canvas.getContext("webgl2", { antialias: false, depth: false, preserveDrawingBuffer: false });
+// the last version that compiled keeps running while the code has errors
+let running = null;
+const started = performance.now();
+
+function frame() {
+  if (running && !document.hidden) {
+    running.draw((performance.now() - started) / 1000);
+  }
+  requestAnimationFrame(frame);
+}
+requestAnimationFrame(frame);
+
+const MISSING_HINT =
+  "\n\nNames Shadertoy does not define (like the undeclared ones above) usually come from the shader's " +
+  "Common tab, and iChannel reads from its Buffer tabs. Copy each tab into a section of its own " +
+  "(Add section), and name each pass's channels on its section line, as on Shadertoy.";
+
+let compiled = false;
+function update() {
+  const made = shaderToy().create(gl, code.value);
+  compiled = !made.error;
+  if (compiled) {
+    running = made;
+  }
+  const passes = compiled && made.names.length > 1 ? ` Passes: ${made.names.join(", ")}.` : "";
+  status.textContent = made.error
+    ? made.error + (/undeclared identifier|iChannel/.test(made.error) ? MISSING_HINT : "")
+    : "Compiled. The preview shows it running." + passes;
+  status.classList.toggle("error", !compiled);
+  $("save").disabled = !compiled || !target;
+}
+
+// sections: a Common section goes first, buffers before the image
+const MARKER = /^[ \t]*\/\/[ \t]*-{2,}[ \t]*(common|buffer [a-d]|image)\b/im;
+$("add-section").addEventListener("change", e => {
+  const name = e.target.value;
+  e.target.value = "";
+  let text = code.value;
+  if (!MARKER.test(text)) {
+    text = "// ---- image ----\n" + text;
+  }
+  if (new RegExp(`^[ \\t]*//[ \\t]*-{2,}[ \\t]*${name}\\b`, "im").test(text)) {
+    return;
+  }
+  let insert, at;
+  if (name == "common") {
+    insert = "// ---- common ----\n\n";
+    at = 0;
+  } else {
+    insert = `// ---- ${name}: iChannel0=${name} ----\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  fragColor = vec4(0.0);\n}\n\n`;
+    at = text.search(/^[ \t]*\/\/[ \t]*-{2,}[ \t]*image\b/im);
+  }
+  code.value = text.slice(0, at) + insert + text.slice(at);
+  code.focus();
+  code.setSelectionRange(at + insert.indexOf("\n") + 1, at + insert.indexOf("\n") + 1);
+  update();
+});
+let timer = 0;
+code.addEventListener("input", () => {
+  clearTimeout(timer);
+  timer = setTimeout(update, 300);
+});
+// Tab indents instead of leaving the editor
+code.addEventListener("keydown", e => {
+  if (e.key == "Tab" && !e.ctrlKey && !e.altKey) {
+    e.preventDefault();
+    code.setRangeText("  ", code.selectionStart, code.selectionEnd, "end");
+    code.dispatchEvent(new Event("input"));
+  }
+});
+
+function pick(mode, callback) {
+  const fp = Cc["@mozilla.org/filepicker;1"].createInstance(Ci.nsIFilePicker);
+  fp.init(window.browsingContext, "", mode);
+  fp.appendFilter(...SHADER_FILTER);
+  if (mode == Ci.nsIFilePicker.modeSave) {
+    fp.defaultString = "shader.glsl";
+  }
+  fp.open(result => {
+    if (result == Ci.nsIFilePicker.returnOK || result == Ci.nsIFilePicker.returnReplace) {
+      callback(fp.file.path);
+    }
+  });
+}
+
+$("import").addEventListener("click", () =>
+  pick(Ci.nsIFilePicker.modeOpen, async path => {
+    try {
+      code.value = await IOUtils.readUTF8(path, { maxBytes: MAX_BYTES });
+      update();
+    } catch (e) {
+      status.textContent = "Could not read the file: " + e.message;
+      status.classList.add("error");
+    }
+  })
+);
+$("export").addEventListener("click", () =>
+  pick(Ci.nsIFilePicker.modeSave, path => IOUtils.writeUTF8(path, code.value).catch(console.error))
+);
+// the shader lives in the profile's Celesta-shaders folder, one file per setting
+$("save").addEventListener("click", async () => {
+  if (!compiled || !target) {
+    return;
+  }
+  const dir = PathUtils.join(PathUtils.profileDir, "Celesta-shaders");
+  await IOUtils.makeDirectory(dir, { ignoreExisting: true });
+  const file = PathUtils.join(dir, `${pref.split(".").pop()}-${Date.now()}.glsl`);
+  await IOUtils.writeUTF8(file, code.value);
+  Services.prefs.setStringPref(pref, file);
+  Services.prefs.setStringPref(target[0], target[1]);
+  status.textContent = "Saved and in use: " + file;
+  status.classList.remove("error");
+});
+
+(async () => {
+  $("target").textContent = target ? "for " + target[2] : "(no setting: use Save as file)";
+  const current = target && Services.prefs.getStringPref(pref, "");
+  code.value = current ? await IOUtils.readUTF8(current, { maxBytes: MAX_BYTES }).catch(() => STARTER) : STARTER;
+  update();
+})();
diff --git a/browser/content/celesta/shader-worker.js b/browser/content/celesta/shader-worker.js
new file mode 100644
index 0000000000..b936c77622
--- /dev/null
+++ b/browser/content/celesta/shader-worker.js
@@ -0,0 +1,70 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Renders one theme shader for CelestaTheme.sys.mjs off the main thread, so
+   the browser's UI does not wait for the GPU or for a shader to compile.
+   { source, size } starts it ({ ready } or { error } answers); each { t }
+   draws a frame and answers { frame } (an ImageBitmap, null on failure).
+   With { canvas } (an OffscreenCanvas) it draws into that canvas instead:
+   each { t, size, tile, tiles, res } answers { drawn }, and a shader that cannot
+   be tiled answers { error, untiled }. */
+
+"use strict";
+
+/* global shaderToyEngine */
+importScripts("chrome://celesta/content/shadertoy.js");
+
+let canvas = null;
+let made = null;
+
+onmessage = ({ data: m }) => {
+  const t0 = performance.now();
+  if (m.source != null) {
+    canvas = m.canvas || new OffscreenCanvas(...m.size);
+    const gl = canvas.getContext("webgl2", { alpha: false, antialias: false, depth: false, powerPreference: "low-power" });
+    made = gl && shaderToyEngine().create(gl, m.source);
+    if (!made || made.error) {
+      postMessage({ error: made?.error || "no WebGL 2" });
+      made = null;
+      return;
+    }
+    if (m.canvas && !made.tiles) {
+      postMessage({ error: "not one mainImage pass", untiled: true });
+      made = null;
+      return;
+    }
+    postMessage({ ready: true, buildMs: performance.now() - t0 });
+    return;
+  }
+  if (m.tile) {
+    try {
+      if (canvas.width != m.size[0] || canvas.height != m.size[1]) {
+        [canvas.width, canvas.height] = m.size;
+      }
+      if (m.tiles) {
+        // one picture fitted to each rect [x, y, w, h] (canvas px, y down)
+        const gl = canvas.getContext("webgl2");
+        gl.enable(gl.SCISSOR_TEST);
+        for (const tile of m.tiles) {
+          const [x, y, w, h] = tile.map(Math.round);
+          gl.scissor(x, canvas.height - y - h, w, h);
+          made.draw(m.t, { res: m.res, tile });
+        }
+        gl.disable(gl.SCISSOR_TEST);
+      } else {
+        made.draw(m.t, { res: m.res, tile: m.tile });
+      }
+    } finally {
+      postMessage({ drawn: true, workMs: performance.now() - t0 });
+    }
+    return;
+  }
+  let frame = null;
+  try {
+    made.draw(m.t);
+    frame = canvas.transferToImageBitmap();
+  } finally {
+    postMessage({ frame, workMs: performance.now() - t0 }, frame ? [frame] : []);
+  }
+};
diff --git a/browser/content/celesta/shadertoy.js b/browser/content/celesta/shadertoy.js
new file mode 100644
index 0000000000..428e952d57
--- /dev/null
+++ b/browser/content/celesta/shadertoy.js
@@ -0,0 +1,258 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Runs Shadertoy shaders on WebGL 2: a Common section, Buffer A-D passes and
+   the Image pass, each reading up to four channels (a buffer, a noise
+   texture or nothing). Used by the shader editor, the theme's shader fills
+   (CelestaTheme.sys.mjs) and the start page's background (space.js, in a
+   worker, which is why this is one self-contained function).
+
+   One shader file holds every section, each under a marker line:
+     // ---- common ----
+     // ---- buffer a: iChannel0=buffer a, iChannel1=noise ----
+     // ---- image: iChannel0=buffer a ----
+   Code without markers is the Image pass. Code without a mainImage function
+   is a plain fragment shader (GLSL ES 1.0, or 3.0 with "#version 300 es")
+   that may read uRes and uTime. */
+
+"use strict";
+
+/* exported shaderToyEngine */
+function shaderToyEngine() {
+  const MARK = /^[ \t]*\/\/[ \t]*-{2,}[ \t]*(common|buffer [a-d]|image)[ \t]*(?::([^\n]*?))?[ \t]*-*[ \t]*$/gim;
+  const BUFFERS = ["buffer a", "buffer b", "buffer c", "buffer d"];
+  const CHANNEL_SOURCES = ["none", "noise", ...BUFFERS];
+
+  /* { common, commonLine, passes: [{ name, code, line, channels }] }; line is
+     the 1-based line in the file where the section's code starts */
+  function parse(text) {
+    const marks = [...text.matchAll(MARK)];
+    const lineAt = index => text.slice(0, index).split("\n").length;
+    if (!marks.length) {
+      return { common: "", commonLine: 1, passes: [{ name: "image", code: text, line: 1, channels: [null, null, null, null] }] };
+    }
+    const out = { common: "", commonLine: 1, passes: [] };
+    marks.forEach((m, i) => {
+      const start = m.index + m[0].length + 1;
+      const code = text.slice(start, i + 1 < marks.length ? marks[i + 1].index : text.length);
+      const name = m[1].toLowerCase();
+      if (name == "common") {
+        out.common = code;
+        out.commonLine = lineAt(start);
+        return;
+      }
+      const channels = [null, null, null, null];
+      for (const [, n, source] of (m[2] || "").matchAll(/ichannel([0-3])\s*=\s*(none|noise|buffer [a-d])/gi)) {
+        channels[n] = source.toLowerCase() == "none" ? null : source.toLowerCase();
+      }
+      out.passes.push({ name, code, line: lineAt(start), channels });
+    });
+    // buffers run first, in order, then the image
+    out.passes.sort((a, b) => (a.name == "image") - (b.name == "image") || a.name.localeCompare(b.name));
+    return out;
+  }
+
+  const HEADER = `#version 300 es
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+uniform vec3 iResolution;
+uniform float iTime, iTimeDelta, iFrameRate, iSampleRate;
+uniform int iFrame;
+uniform vec4 iMouse, iDate;
+uniform vec3 iChannelResolution[4];
+uniform float iChannelTime[4];
+uniform sampler2D iChannel0, iChannel1, iChannel2, iChannel3;
+uniform vec2 uRes, uPan;
+uniform float uTime, uZoom;
+uniform vec3 CelestaView;
+uniform vec4 CelestaTile;
+out vec4 CelestaFragColor;
+`;
+  const VS1 = "attribute vec2 aPos; void main() { gl_Position = vec4(aPos, 0.0, 1.0); }";
+  const VS3 = "#version 300 es\nin vec2 aPos; void main() { gl_Position = vec4(aPos, 0.0, 1.0); }";
+
+  /* compiles a program; throws the compiler's log, its "0:N" lines turned
+     into the file's lines (the code carries #line directives) */
+  function program(gl, vs, fs, label) {
+    const prog = gl.createProgram();
+    const logs = [];
+    for (const [type, src] of [[gl.VERTEX_SHADER, vs], [gl.FRAGMENT_SHADER, fs]]) {
+      const shader = gl.createShader(type);
+      gl.shaderSource(shader, src);
+      gl.compileShader(shader);
+      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+        logs.push(gl.getShaderInfoLog(shader));
+      }
+      gl.attachShader(prog, shader);
+    }
+    gl.bindAttribLocation(prog, 0, "aPos");
+    gl.linkProgram(prog);
+    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
+      const log = (logs.join("\n") || gl.getProgramInfoLog(prog) || "The shader did not compile.")
+        .replace(/(?:ERROR|WARNING): 0:(\d+):/g, (m, line) => `line ${line}:`)
+        .replace(/\0/g, "")
+        .trim();
+      throw new Error(label ? `${label}:\n${log}` : log);
+    }
+    return prog;
+  }
+
+  function texture(gl, w, h, internal, format, type, data, filter) {
+    const tex = gl.createTexture();
+    gl.bindTexture(gl.TEXTURE_2D, tex);
+    gl.texImage2D(gl.TEXTURE_2D, 0, internal, w, h, 0, format, type, data);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filter);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+    return tex;
+  }
+
+  /* gl: a WebGL 2 context. Returns { error } when the code does not compile,
+     else { draw(seconds, extra), names }: draw renders a frame into the
+     context's canvas; extra may give uPan [x, y] and uZoom, and view
+     [x, y, scale]: the image pass sees pixel p at (p - [x, y]) / scale, which
+     pans and zooms the picture (the start page's camera). With tile
+     [x, y, w, h] (canvas px, y down) and res [w, h], the image pass draws a
+     res-sized picture scaled to w x h, repeated from x, y; only when tiles
+     is true (one mainImage pass). */
+  function create(gl, text) {
+    const plain = !/\bmainImage\s*\(/.test(text);
+    const quad = gl.createBuffer();
+    gl.bindBuffer(gl.ARRAY_BUFFER, quad);
+    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
+    const vao = gl.createVertexArray();
+    gl.bindVertexArray(vao);
+    gl.enableVertexAttribArray(0);
+    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
+
+    let passes;
+    try {
+      if (plain) {
+        const es3 = /^\s*#version 300 es/.test(text);
+        passes = [{ name: "image", prog: program(gl, es3 ? VS3 : VS1, text), channels: [null, null, null, null] }];
+      } else {
+        const file = parse(text);
+        if (!file.passes.some(p => p.name == "image")) {
+          throw new Error("There is no image section (// ---- image ----).");
+        }
+        passes = file.passes.map(p => {
+          const fs = `${HEADER}#line ${file.commonLine}\n${file.common}\n#line ${p.line}\n${p.code}\n` +
+            (p.name == "image"
+              ? "void main() { vec2 p = gl_FragCoord.xy; if (CelestaTile.z > 0.0) { vec2 l = mod(vec2(p.x, uRes.y - p.y) - CelestaTile.xy, CelestaTile.zw) * iResolution.xy / CelestaTile.zw; p = vec2(l.x, iResolution.y - l.y); }" +
+                " mainImage(CelestaFragColor, (p - CelestaView.xy) / CelestaView.z); CelestaFragColor.a = 1.0; }"
+              : "void main() { mainImage(CelestaFragColor, gl_FragCoord.xy); }");
+          return { ...p, prog: program(gl, VS3, fs, p.name[0].toUpperCase() + p.name.slice(1)) };
+        });
+      }
+    } catch (e) {
+      return { error: e.message };
+    }
+    for (const p of passes) {
+      p.u = {};
+      for (const name of ["iResolution", "iTime", "iTimeDelta", "iFrameRate", "iSampleRate", "iFrame", "iMouse", "iDate",
+        "iChannelResolution", "iChannelTime", "uRes", "uPan", "uTime", "uZoom", "CelestaView", "CelestaTile", "iChannel0", "iChannel1", "iChannel2", "iChannel3"]) {
+        p.u[name] = gl.getUniformLocation(p.prog, name);
+      }
+    }
+
+    // buffers keep their pixels between frames (a pass may read its own last frame)
+    const floats = !!gl.getExtension("EXT_color_buffer_float");
+    const [internal, format, type] = floats ? [gl.RGBA16F, gl.RGBA, gl.HALF_FLOAT] : [gl.RGBA8, gl.RGBA, gl.UNSIGNED_BYTE];
+    const buffers = new Map();
+    const noiseData = new Uint8Array(256 * 256 * 4);
+    let seed = 1;
+    for (let i = 0; i < noiseData.length; i++) {
+      seed = (seed * 16807) % 2147483647;
+      noiseData[i] = seed & 255;
+    }
+    const noise = texture(gl, 256, 256, gl.RGBA8, gl.RGBA, gl.UNSIGNED_BYTE, noiseData, gl.LINEAR_MIPMAP_LINEAR);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);
+    gl.generateMipmap(gl.TEXTURE_2D);
+    const black = texture(gl, 1, 1, gl.RGBA8, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array(4), gl.NEAREST);
+
+    let size = [0, 0], frame = 0, last = null;
+    function resize(w, h) {
+      size = [w, h];
+      for (const b of buffers.values()) {
+        b.tex.forEach(t => gl.deleteTexture(t));
+        gl.deleteFramebuffer(b.fb);
+      }
+      buffers.clear();
+      for (const p of passes) {
+        if (p.name != "image") {
+          const tex = [0, 1].map(() => texture(gl, w, h, internal, format, type, null, gl.LINEAR));
+          buffers.set(p.name, { tex, fb: gl.createFramebuffer(), write: 0, latest: tex[1] });
+        }
+      }
+      frame = 0;
+    }
+
+    function draw(seconds, extra = {}) {
+      const w = gl.drawingBufferWidth, h = gl.drawingBufferHeight;
+      if (w != size[0] || h != size[1]) {
+        resize(w, h);
+      }
+      const delta = last == null ? 1 / 60 : Math.max(0, seconds - last);
+      last = seconds;
+      const now = new Date();
+      const blend = gl.isEnabled(gl.BLEND);
+      gl.bindVertexArray(vao);
+      for (const p of passes) {
+        const target = buffers.get(p.name);
+        gl.useProgram(p.prog);
+        if (target) {
+          gl.disable(gl.BLEND);
+          gl.bindFramebuffer(gl.FRAMEBUFFER, target.fb);
+          gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, target.tex[target.write], 0);
+        } else {
+          if (blend) {
+            gl.enable(gl.BLEND);
+          }
+          gl.bindFramebuffer(gl.FRAMEBUFFER, null);
+        }
+        gl.viewport(0, 0, w, h);
+        const res = [];
+        p.channels.forEach((source, i) => {
+          const tex = source == "noise" ? noise : buffers.get(source)?.latest ?? black;
+          gl.activeTexture(gl.TEXTURE0 + i);
+          gl.bindTexture(gl.TEXTURE_2D, tex);
+          gl.uniform1i(p.u["iChannel" + i], i);
+          res.push(...(source == "noise" ? [256, 256, 1] : buffers.has(source) ? [w, h, 1] : [1, 1, 1]));
+        });
+        const u = p.u;
+        gl.uniform3f(u.iResolution, ...(p.name == "image" && extra.res ? extra.res : [w, h]), 1);
+        gl.uniform1f(u.iTime, seconds);
+        gl.uniform1f(u.iTimeDelta, delta);
+        gl.uniform1f(u.iFrameRate, delta ? 1 / delta : 60);
+        gl.uniform1f(u.iSampleRate, 44100);
+        gl.uniform1i(u.iFrame, frame);
+        gl.uniform4f(u.iMouse, 0, 0, 0, 0);
+        gl.uniform4f(u.iDate, now.getFullYear(), now.getMonth(), now.getDate(),
+          now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds() + now.getMilliseconds() / 1000);
+        gl.uniform3fv(u.iChannelResolution, res);
+        gl.uniform1fv(u.iChannelTime, [seconds, seconds, seconds, seconds]);
+        gl.uniform2f(u.uRes, w, h);
+        gl.uniform1f(u.uTime, seconds);
+        gl.uniform2f(u.uPan, ...(extra.uPan || [w / 2, h / 2]));
+        gl.uniform1f(u.uZoom, extra.uZoom ?? 1);
+        gl.uniform3f(u.CelestaView, ...(extra.view || [0, 0, 1]));
+        gl.uniform4f(u.CelestaTile, ...(extra.tile || [0, 0, 0, 0]));
+        gl.drawArrays(gl.TRIANGLES, 0, 3);
+        if (target) {
+          target.latest = target.tex[target.write];
+          target.write ^= 1;
+        }
+      }
+      gl.activeTexture(gl.TEXTURE0);
+      frame++;
+    }
+
+    return { draw, names: passes.map(p => p.name), tiles: !plain && passes.length == 1 };
+  }
+
+  return { create, parse, CHANNEL_SOURCES };
+}
